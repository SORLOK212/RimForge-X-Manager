<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimForge.App.ViewModels"
        x:Class="RimForge.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RimForge X Manager"
        Icon="/Assets/rimforge.ico"
        Width="1440" Height="880" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <!-- Pictures of a Workshop page: the big one (click: full screen), ‹ ›, and a strip of thumbnails -->
    <DataTemplate x:Key="GalleryView" x:DataType="vm:GalleryViewModel">
      <StackPanel Spacing="6">
        <Panel Height="200" Background="#0E0F11">
          <TextBlock Classes="icon faint" Text="&#xE91B;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding Current}" Stretch="Uniform" />
          <Button Classes="clickArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGalleryFullCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource Tip.Gallery.Open}" />
          <Border Width="56" Height="56" CornerRadius="28" Background="#C0000000" IsVisible="{Binding CurrentIsVideo}" IsHitTestVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Classes="icon" Text="&#xE768;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
          </Border>
          <Button Classes="flat galleryArrow" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" IsVisible="{Binding HasMany}"
                  Command="{Binding PrevCommand}" ToolTip.Tip="{DynamicResource Tip.Gallery.Prev}">
            <TextBlock Classes="icon" Text="&#xE76B;" FontSize="16" />
          </Button>
          <Button Classes="flat galleryArrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4" IsVisible="{Binding HasMany}"
                  Command="{Binding NextCommand}" ToolTip.Tip="{DynamicResource Tip.Gallery.Next}">
            <TextBlock Classes="icon" Text="&#xE76C;" FontSize="16" />
          </Button>
          <Border Classes="badge" Background="#C0000000" BorderBrush="Transparent" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  IsVisible="{Binding HasMany}" IsHitTestVisible="False">
            <TextBlock Text="{Binding Counter}" Foreground="White" />
          </Border>
          <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Bottom" IsVisible="{Binding IsLoading}"
                       Foreground="{StaticResource AccentBrush}" Background="Transparent" />
        </Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasMany}" Margin="6,0">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryItemViewModel">
                <Button Classes="flat" Padding="0" Margin="0,0,0,4" Cursor="Hand"
                        Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                  <Border Width="80" Height="45" BorderThickness="2" CornerRadius="2" ClipToBounds="True" Background="#0E0F11"
                          BorderBrush="Transparent" Classes.currentThumb="{Binding IsCurrent}">
                    <Panel>
                      <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                      <TextBlock Classes="icon" Text="&#xE768;" FontSize="14" Foreground="White" IsVisible="{Binding IsVideo}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </DataTemplate>

    <!-- One row of a mod list (used by both lists). -->
    <DataTemplate x:Key="ModRow" x:DataType="vm:ModItemViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
        <TextBlock Grid.Column="0" Text="{Binding Index}" IsVisible="{Binding IsActive}"
                   Classes="faint" Width="30" Margin="0,0,8,0" FontSize="11"
                   TextAlignment="Right" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                     Classes.error="{Binding ShowMissing}" />
          <TextBlock Text="{Binding AuthorText}" IsVisible="{Binding HasAuthor}"
                     Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" />
          <ProgressBar Classes="download" Classes.stalled="{Binding IsDownloadWaiting}" Height="2" MinHeight="2" Margin="0,2,0,0"
                       Maximum="1" Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="6,0" VerticalAlignment="Center">
          <TextBlock Classes="icon" Text="&#xE735;" FontSize="11" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsFavorite}"
                     ToolTip.Tip="{DynamicResource Tip.Row.Favorite}" VerticalAlignment="Center" />
          <TextBlock Classes="icon faint" Text="&#xE718;" FontSize="11" IsVisible="{Binding IsPinned}"
                     ToolTip.Tip="{Binding PinTip}" VerticalAlignment="Center" />
          <Border Classes="badge" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding IsNew}"
                  ToolTip.Tip="{DynamicResource Tip.Row.New}">
            <TextBlock Text="{DynamicResource Badge.New}" Foreground="{StaticResource AccentTextBrush}" />
          </Border>
          <Border Classes="badge" BorderBrush="{StaticResource OkBrush}" IsVisible="{Binding IsUpdated}"
                  ToolTip.Tip="{DynamicResource Tip.Row.Updated}">
            <TextBlock Text="{DynamicResource Badge.Updated}" Foreground="{StaticResource OkBrush}" />
          </Border>
          <TextBlock Classes="icon" Text="&#xE7BA;"
                     IsVisible="{Binding ShowIssue}" Classes.warn="{Binding HasWarning}" Classes.error="{Binding HasError}"
                     ToolTip.Tip="{Binding IssueTip}" />
          <Border Classes="badge pulse" BorderBrush="{StaticResource DownloadBrush}" Background="{StaticResource DownloadTintBrush}"
                  IsVisible="{Binding IsDownloading}" ToolTip.Tip="{DynamicResource Tip.Row.Downloading}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="icon" Text="&#xE896;" FontSize="9" Foreground="{StaticResource DownloadBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DownloadText}" Foreground="{StaticResource DownloadBrush}"
                         IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Panel Grid.Column="3" Margin="6,0,0,0">
          <Border Classes="badge" IsVisible="{Binding IsWorkshop}" BorderBrush="{StaticResource WorkshopBrush}">
            <TextBlock Text="{DynamicResource Badge.Workshop}" Foreground="{StaticResource WorkshopBrush}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding IsLocal}" BorderBrush="{StaticResource LocalBrush}">
            <TextBlock Text="{DynamicResource Badge.Local}" Foreground="{StaticResource LocalBrush}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding IsOfficial}" BorderBrush="{StaticResource OfficialBrush}">
            <TextBlock Text="{DynamicResource Badge.Official}" Foreground="{StaticResource OfficialBrush}" />
          </Border>
        </Panel>
      </Grid>
    </DataTemplate>
    <!-- One row on the Workshop "Updates" tab. -->
    <DataTemplate x:Key="UpdateRow" x:DataType="vm:UpdateRowViewModel">
      <Border Classes="panel" Padding="14,10" Margin="0,0,0,6">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Classes="badge" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding InModpack}"
                        ToolTip.Tip="{DynamicResource Tip.Upd.InModpack}">
                  <TextBlock Text="{DynamicResource Upd.InModpack}" Foreground="{StaticResource AccentBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding WhenText}" Classes="faint" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button IsVisible="{Binding !IsRemoved}" Padding="10,3" ToolTip.Tip="{DynamicResource Tip.Upd.WhatsNew}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleChangelogCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{DynamicResource Upd.WhatsNew}" />
                </StackPanel>
              </Button>
              <Button IsVisible="{Binding IsRemoved}" Padding="10,3" Content="{DynamicResource Btn.Folder}" ToolTip.Tip="{DynamicResource Tip.Upd.Folder}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenUpdateFolderCommand}" CommandParameter="{Binding}" />
              <Button Padding="10,3" Content="{DynamicResource Upd.ShowInList}" ToolTip.Tip="{DynamicResource Tip.Ws.ShowInList}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowUpdateInListCommand}" CommandParameter="{Binding}" />
              <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Upd.Page}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenUpdatePageCommand}" CommandParameter="{Binding}">
                <TextBlock Classes="icon" Text="&#xE8A7;" />
              </Button>
            </StackPanel>
          </Grid>
          <Border IsVisible="{Binding IsExpanded}" Background="{StaticResource BgBrush}" CornerRadius="3" Padding="10">
            <Panel>
              <TextBlock Text="{DynamicResource Upd.LoadingChangelog}" Classes="muted" IsVisible="{Binding IsLoadingChangelog}" />
              <SelectableTextBlock Text="{Binding Changelog}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
            </Panel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- The "Filters" drop-down of the mod lists (shared by both lists). -->
    <DataTemplate x:Key="FiltersPanel" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="10" Width="460">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="{DynamicResource Filters.Title}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="flat" Command="{Binding ResetFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                  ToolTip.Tip="{DynamicResource Tip.Filters.Reset}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE894;" FontSize="11" />
              <TextBlock Text="{DynamicResource Filters.Reset}" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{DynamicResource Filters.State}" Classes="muted" FontSize="12" />
        <ItemsControl ItemsSource="{Binding StateChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChipViewModel">
              <ToggleButton Classes="chip" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Tip}">
                <TextBlock><Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Count}" Foreground="{StaticResource TextFaintBrush}" /></TextBlock>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{DynamicResource Filters.Categories}" Classes="muted" FontSize="12" />
        <ItemsControl ItemsSource="{Binding CategoryChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChipViewModel">
              <ToggleButton Classes="chip" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Tip}">
                <TextBlock><Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Count}" Foreground="{StaticResource TextFaintBrush}" /></TextBlock>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding AnalysisText}" Classes="warn" FontSize="12" IsVisible="{Binding AnalysisText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{DynamicResource Filters.Hint}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <!-- The Workshop "Filters" drop-down. -->
    <DataTemplate x:Key="WorkshopFiltersPanel" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="8" Width="460">
        <StackPanel.Styles>
          <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,0,0,0" />
          </Style>
        </StackPanel.Styles>
        <TextBlock Classes="h2" Text="{DynamicResource Filters.Title}" />
        <StackPanel Spacing="6" IsVisible="{Binding IsWsSearch}">
          <TextBlock Text="{DynamicResource Ws.Filters.Category}" Classes="muted" FontSize="12" />
          <ItemsControl ItemsSource="{Binding Themes}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeViewModel">
                <ToggleButton Classes="chip" IsChecked="{Binding IsSearchCategory, Mode=OneWay}" ToolTip.Tip="{Binding Tip}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PickSearchCategoryCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ws.Filters.Show}" Classes="muted" FontSize="12" />
        <CheckBox IsChecked="{Binding OnlyMyVersion}" Content="{Binding WorkshopVersionText}" ToolTip.Tip="{DynamicResource Tip.Ws.OnlyMyVersion}" />
        <CheckBox IsChecked="{Binding HideTranslations}" Content="{DynamicResource Ws.HideTranslations}" ToolTip.Tip="{DynamicResource Tip.Ws.HideTranslations}" />
        <CheckBox IsChecked="{Binding OnlyMods}" Content="{DynamicResource Ws.OnlyMods}" ToolTip.Tip="{DynamicResource Tip.Ws.OnlyMods}" />
        <CheckBox IsChecked="{Binding HideInstalled}" Content="{DynamicResource Ws.HideInstalled}" ToolTip.Tip="{DynamicResource Tip.Ws.HideInstalled}" />
        <CheckBox IsChecked="{Binding HideAbandoned}" Content="{DynamicResource Ws.HideAbandoned}" ToolTip.Tip="{DynamicResource Tip.Ws.HideAbandoned}" />
      </StackPanel>
    </DataTemplate>
    <!-- One mod of the assistant's pack: tick, picture, name, numbers, labels -->
    <DataTemplate x:Key="PackPickTemplate" x:DataType="vm:PackPickViewModel">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2" ToolTip.Tip="{Binding Summary}">
        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="4,0,6,0" />
        <Border Grid.Column="1" Width="64" Height="36" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgBrush}" VerticalAlignment="Center">
          <Image Source="{Binding Preview}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="2" Margin="8,0,4,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
          <DockPanel>
            <Border DockPanel.Dock="Left" Margin="0,0,6,0" Classes="badge" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding IsCore}" ToolTip.Tip="{DynamicResource Tip.Asst.Badge.Core}">
              <TextBlock Text="{DynamicResource Asst.Badge.Core}" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <Border DockPanel.Dock="Left" Margin="0,0,6,0" Classes="badge" BorderBrush="{StaticResource OkBrush}" IsVisible="{Binding IsInstalled}">
              <TextBlock Text="{DynamicResource Asst.Badge.Installed}" Foreground="{StaticResource OkBrush}" />
            </Border>
            <Border DockPanel.Dock="Left" Margin="0,0,6,0" Classes="badge" BorderBrush="{StaticResource OkBrush}" IsVisible="{Binding IsPerformance}">
              <TextBlock Text="{DynamicResource Asst.Badge.Performance}" Foreground="{StaticResource OkBrush}" />
            </Border>
            <TextBlock Classes="faint" Text="{Binding Details}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="faint" Text="{Binding ReplacesText}" FontSize="11.5" IsVisible="{Binding HasReplaces}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="3" Classes="flat" Padding="6,4" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Asst.Open}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenAsstPickCommand}" CommandParameter="{Binding}">
          <TextBlock Classes="icon" Text="&#xE8A7;" FontSize="12" />
        </Button>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ═════════════ Top bar ═════════════ -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="14,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="icon" Text="&#xE90F;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
          <TextBlock FontSize="19" FontWeight="Bold" VerticalAlignment="Center">
            <Run Text="Rim" Foreground="{StaticResource AccentBrush}" /><Run Text="Forge" /><Run Text=" X" Foreground="{StaticResource AccentBrush}" />
          </TextBlock>
          <TextBlock Text="Manager" Classes="muted" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Modpack switcher -->
        <Button x:Name="ProfileButton" Grid.Column="1" Margin="28,0,0,0" Background="{StaticResource BgBrush}"
                Padding="10,5" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Profile}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE8F1;" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{DynamicResource Top.Profile}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="2" MinWidth="280">
                <ItemsControl ItemsSource="{Binding Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileViewModel">
                      <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchProfileCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="20,*,Auto">
                          <TextBlock Classes="icon" Text="&#xE73E;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsActive}" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="faint" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding NewProfileCommand}" ToolTip.Tip="{DynamicResource Tip.Profiles.New}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE710;" />
                    <TextBlock Text="{DynamicResource Profiles.New}" />
                  </StackPanel>
                </Button>
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding ShowPageCommand}" CommandParameter="profiles">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE8F1;" />
                    <TextBlock Text="{DynamicResource Profiles.Manage}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Game version switcher: the installed game or a saved copy from the library -->
        <Button x:Name="GameButton" Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Left" Background="{StaticResource BgBrush}"
                Padding="10,5" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Game}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE7FC;" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding !IsCopyActive}" />
            <TextBlock Classes="icon" Text="&#xE72E;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsCopyActive}" />
            <TextBlock Text="{Binding ActiveGameText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameDlBadge}" Foreground="{StaticResource DownloadBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                       IsVisible="{Binding GameDlBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="2" Width="400">
                <TextBlock Classes="h2" Text="{DynamicResource Game.Title}" Margin="8,2,8,4" />
                <ItemsControl ItemsSource="{Binding GameChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameChoiceViewModel">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchGameCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="20,*">
                            <TextBlock Classes="icon" Text="&#xE73E;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsActive}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Details}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="flat" IsVisible="{Binding IsCopy}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Game.Delete}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGameCopyCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE74D;" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding SaveGameCopyCommand}" IsEnabled="{Binding CanSaveGameCopy}" ToolTip.Tip="{DynamicResource Tip.Game.Save}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE72E;" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource Game.Save}" />
                  </StackPanel>
                </Button>
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding OpenGameDownloadCommand}" ToolTip.Tip="{DynamicResource Tip.GameDl.Open}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource DownloadBrush}" />
                    <TextBlock Text="{DynamicResource GameDl.Open}" />
                    <TextBlock Text="{Binding GameDlBadge}" Foreground="{StaticResource DownloadBrush}" />
                  </StackPanel>
                </Button>
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding OpenLibraryFolderCommand}" ToolTip.Tip="{Binding LibraryPath}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE838;" />
                    <TextBlock Text="{DynamicResource Game.OpenLibrary}" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource Game.Hint}" Classes="faint" FontSize="11" TextWrapping="Wrap" Margin="8,6,8,2" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="flat" Command="{Binding UndoCommand}" ToolTip.Tip="Ctrl+Z">
            <TextBlock Classes="icon" Text="&#xE7A7;" />
          </Button>
          <Button Classes="flat" Command="{Binding RedoCommand}" ToolTip.Tip="Ctrl+Y">
            <TextBlock Classes="icon" Text="&#xE7A6;" />
          </Button>
          <Button Classes="flat" Command="{Binding ReloadCommand}" ToolTip.Tip="{DynamicResource Tip.Reload}">
            <TextBlock Classes="icon" Text="&#xE72C;" />
          </Button>
          <Button Command="{Binding RevertCommand}" Content="{DynamicResource Top.Revert}"
                  ToolTip.Tip="{DynamicResource Tip.Revert}" />
          <Button Command="{Binding SaveCommand}" ToolTip.Tip="{DynamicResource Tip.Save}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE74E;" />
              <TextBlock Text="{DynamicResource Top.Save}" />
            </StackPanel>
          </Button>

          <!-- Traffic light -->
          <Button x:Name="StatusButton" ToolTip.Tip="{DynamicResource Tip.Status}" Margin="8,0,0,0" MinWidth="150">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="12" Height="12">
                <Ellipse Fill="{StaticResource OkBrush}" IsVisible="{Binding IsStatusOk}" />
                <Ellipse Fill="{StaticResource WarnBrush}" IsVisible="{Binding IsStatusWarn}" />
                <Ellipse Fill="{StaticResource ErrorBrush}" IsVisible="{Binding IsStatusError}" />
              </Panel>
              <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="10" Width="500">
                  <TextBlock Classes="h2" Text="{DynamicResource Issues.Title}" />
                  <TextBlock Text="{DynamicResource Issues.None}" Classes="ok" IsVisible="{Binding HasNoIssues}" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="accent" Command="{Binding OpenFixAllCommand}" IsVisible="{Binding CanFixAll}" Margin="0,0,8,0"
                            ToolTip.Tip="{DynamicResource Tip.FixAll}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE90F;" Foreground="{StaticResource AccentTextBrush}" />
                        <TextBlock Text="{DynamicResource FixAll.Button}" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding DownloadMissingCommand}" IsVisible="{Binding HasDownloadableMissing}"
                            ToolTip.Tip="{DynamicResource Tip.Dl.DownloadMissing}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE896;" />
                        <TextBlock Text="{Binding DownloadMissingText}" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenTranslationsCommand}" IsVisible="{Binding HasUntranslated}" Margin="0,0,0,0"
                            ToolTip.Tip="{DynamicResource Tip.Trn.Light}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="trGlyph" Text="文A" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UntranslatedText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <ScrollViewer MaxHeight="420">
                    <ItemsControl ItemsSource="{Binding Issues}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                            <TextBlock Classes="icon" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,8,0"
                                       Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Content="{Binding FixText}" IsVisible="{Binding CanFix}"
                                    Command="{Binding FixCommand}" Padding="10,3" Margin="8,0,0,0"
                                    VerticalAlignment="Top" ToolTip.Tip="{DynamicResource Tip.Fix}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- How long the game will take to start; a click shows what each mod costs -->
          <Button Command="{Binding OpenLoadTimeCommand}" IsVisible="{Binding HasLoadTime}" ToolTip.Tip="{Binding LoadTimeTip}"
                  Padding="10,8" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE916;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LoadTimeText}" FontSize="13" VerticalAlignment="Center" FontFeatures="tnum" />
            </StackPanel>
          </Button>

          <Button Classes="accent" Command="{Binding PlayCommand}" ToolTip.Tip="{DynamicResource Tip.Play}"
                  Padding="22,8" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="&#xE768;" Foreground="{StaticResource AccentTextBrush}" />
              <TextBlock Text="{DynamicResource Top.Play}" FontSize="14" />
            </StackPanel>
          </Button>

          <Button Classes="flat" Command="{Binding SwitchLanguageCommand}" ToolTip.Tip="{DynamicResource Tip.Lang}"
                  Margin="6,0,0,0" Width="40">
            <TextBlock Text="{DynamicResource Lang.Switch}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Content ═════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="64,*,*,380">

      <!-- Navigation rail -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <StackPanel Spacing="6" Margin="0,10" HorizontalAlignment="Center">
          <Button Classes="nav" Classes.current="{Binding IsModsPage}" ToolTip.Tip="{DynamicResource Tip.Nav.Mods}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="mods">
            <TextBlock Classes="icon" Text="&#xE8FD;" FontSize="18" />
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsProfilesPage}" ToolTip.Tip="{DynamicResource Tip.Nav.Profiles}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="profiles">
            <TextBlock Classes="icon" Text="&#xE8F1;" FontSize="18" />
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsWorkshopPage}" Classes.downloading="{Binding HasRunningDownloads}"
                  ToolTip.Tip="{DynamicResource Tip.Nav.Workshop}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="workshop">
            <Panel>
              <TextBlock Classes="icon" Text="&#xE774;" FontSize="18" />
              <TextBlock Classes="icon pulse" Text="&#xE896;" FontSize="10" Foreground="{StaticResource DownloadBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-8" IsVisible="{Binding HasRunningDownloads}" />
              <Border Background="{StaticResource DownloadBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0" IsVisible="{Binding HasRunningDownloads}">
                <TextBlock Text="{Binding RunningDownloads}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BgBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsAssistantPage}" ToolTip.Tip="{DynamicResource Tip.Nav.Assistant}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="assistant">
            <TextBlock Classes="icon" Text="&#xE99A;" FontSize="18" />
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsDiagnosticsPage}" ToolTip.Tip="{DynamicResource Tip.Nav.Diagnostics}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="diagnostics">
            <TextBlock Classes="icon" Text="&#xE9D9;" FontSize="18" />
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsSettingsPage}" ToolTip.Tip="{DynamicResource Tip.Nav.Settings}"
                  ToolTip.Placement="Right" Command="{Binding ShowPageCommand}" CommandParameter="settings">
            <TextBlock Classes="icon" Text="&#xE713;" FontSize="18" />
          </Button>
        </StackPanel>
      </Border>

      <!-- ═════════════ Assistant ═════════════ -->
      <Grid Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,*" Margin="20,16,20,10" IsVisible="{Binding IsAssistantPage}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="{DynamicResource Asst.Title}" />
            <TextBlock Classes="muted" Text="{DynamicResource Asst.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
          <Button Classes="flat" Padding="10,4" Command="{Binding OpenBrainSettingsCommand}" ToolTip.Tip="{DynamicResource Tip.Brain.Open}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE8BD;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AsstBrainText}" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Padding="10,4" Command="{Binding ClearAsstCommand}"
                  IsVisible="{Binding HasAsstMessages}" ToolTip.Tip="{DynamicResource Tip.Asst.New}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE710;" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Asst.New}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          </StackPanel>
        </Grid>

        <Grid x:Name="AsstGrid" Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="500" MinWidth="340" MaxWidth="1000" />
          </Grid.ColumnDefinitions>
          <GridSplitter x:Name="AsstSplit" Grid.Column="1" Classes="panelSplit" ResizeDirection="Columns" />
          <!-- Chat -->
          <Border Classes="panel" Padding="0">
            <Grid RowDefinitions="*,Auto">
              <ScrollViewer x:Name="AsstScroll" Padding="16,14">
                <StackPanel Spacing="10">
                  <!-- First visit: what to write -->
                  <StackPanel Spacing="8" IsVisible="{Binding !HasAsstMessages}" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SelectionBrush}">
                        <TextBlock Classes="icon" Text="&#xE99A;" FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Asst.Welcome}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AsstExamples}" Margin="42,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Button Classes="flat" Padding="10,6" Margin="0,0,0,6" HorizontalAlignment="Left" BorderThickness="1"
                                  BorderBrush="{StaticResource BorderStrongBrush}" CornerRadius="10"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AskAsstExampleCommand}" CommandParameter="{Binding}">
                            <TextBlock Text="{Binding StringFormat='«{0}»'}" TextWrapping="Wrap" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="faint" Text="{DynamicResource Asst.WelcomeTopics}" TextWrapping="Wrap" Margin="42,0,0,0" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding AsstMessages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChatMessageViewModel">
                        <Panel Margin="0,0,0,10">
                          <!-- The player's words: on the right -->
                          <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="560" CornerRadius="12,12,2,12"
                                  Background="{StaticResource SelectionBrush}" Padding="12,8">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          </Border>
                          <!-- The assistant: on the left, with its icon -->
                          <Grid IsVisible="{Binding IsAssistant}" ColumnDefinitions="Auto,*" HorizontalAlignment="Left" MaxWidth="680">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SelectionBrush}" VerticalAlignment="Top">
                              <TextBlock Classes="icon" Text="&#xE99A;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="12,12,12,2" Background="{StaticResource PanelRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,8">
                              <DockPanel>
                                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="40" MinWidth="40" Height="4" Margin="0,0,8,0"
                                             VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                              </DockPanel>
                            </Border>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <!-- Themes, switches and the input box -->
              <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10,14,12">
                <StackPanel Spacing="8">
                  <ItemsControl ItemsSource="{Binding AsstTopics}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PackTopicViewModel">
                        <Button Padding="9,3" Margin="0,0,6,6" CornerRadius="12" FontSize="12.5"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AskAsstTopicCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel>
                    <ToggleButton Classes="chip" IsChecked="{Binding AsstFps}" ToolTip.Tip="{DynamicResource Tip.Asst.Fps}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="icon" Text="&#xEC4A;" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Asst.Fps}" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="chip" IsChecked="{Binding AsstStable}" ToolTip.Tip="{DynamicResource Tip.Asst.Stable}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="icon" Text="&#xE73E;" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Asst.Stable}" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,2,10,8" />
                    <ToggleButton Classes="chip" IsChecked="{Binding AsstSizeSmall}" Content="{DynamicResource Asst.Size.Small}" ToolTip.Tip="{DynamicResource Tip.Asst.Size}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding AsstSizeNormal}" Content="{DynamicResource Asst.Size.Normal}" ToolTip.Tip="{DynamicResource Tip.Asst.Size}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding AsstSizeLarge}" Content="{DynamicResource Asst.Size.Large}" ToolTip.Tip="{DynamicResource Tip.Asst.Size}" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="AsstInputBox" Text="{Binding AsstInput}" Watermark="{DynamicResource Asst.Placeholder}" TextWrapping="Wrap"
                             MaxHeight="120" MinHeight="38" VerticalContentAlignment="Center">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendAsstCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Padding="14,0" Command="{Binding SendAsstCommand}"
                            ToolTip.Tip="{DynamicResource Tip.Asst.Send}" VerticalAlignment="Stretch">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE724;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Asst.Send}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- The suggested modpack -->
          <Border Grid.Column="2" Classes="panel" Padding="0">
            <Panel>
              <StackPanel IsVisible="{Binding !HasAsstPlan}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="30">
                <TextBlock Classes="icon" Text="&#xE8FD;" FontSize="34" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Classes="faint" Text="{DynamicResource Asst.PlanEmpty}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>

              <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasAsstPlan}">
                <StackPanel Spacing="6" Margin="14,12,14,8">
                  <TextBlock Classes="h2" Text="{DynamicResource Asst.PlanTitle}" />
                  <TextBox Text="{Binding AsstPackName}" Watermark="{DynamicResource Asst.NameHint}" IsEnabled="{Binding CanEditAsstPlan}" />
                  <TextBlock Classes="muted" Text="{Binding AsstSelectionText}" FontSize="12.5" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="10,0,4,8">
                  <StackPanel Spacing="10" Margin="0,0,14,0" IsEnabled="{Binding CanEditAsstPlan}">
                    <ItemsControl ItemsSource="{Binding AsstGroups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackGroupViewModel">
                          <StackPanel Spacing="2" Margin="0,0,0,10">
                            <Button Classes="flat" Padding="4,2" HorizontalAlignment="Left" ToolTip.Tip="{DynamicResource Tip.Asst.Group}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AsstSelectGroupCommand}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Classes="faint" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PackPickTemplate}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander IsVisible="{Binding HasAsstAlternatives}" HorizontalAlignment="Stretch" ToolTip.Tip="{DynamicResource Tip.Asst.Alternatives}">
                      <Expander.Header>
                        <TextBlock Text="{Binding AsstAlternativesText}" FontWeight="SemiBold" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding AsstAlternatives}" ItemTemplate="{StaticResource PackPickTemplate}" />
                    </Expander>
                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,7"
                            Command="{Binding CreateAsstPackCommand}" ToolTip.Tip="{DynamicResource Tip.Asst.Create}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Asst.Create}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,7" Command="{Binding RebuildAsstCommand}" IsEnabled="{Binding CanEditAsstPlan}"
                            ToolTip.Tip="{DynamicResource Tip.Asst.Rebuild}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE72C;" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Asst.Rebuild}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </Panel>
          </Border>
        </Grid>
      </Grid>

      <!-- Modpacks page -->
      <!-- ═════════════ Settings ═════════════ -->
      <Grid Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,*" Margin="20,16,20,10" IsVisible="{Binding IsSettingsPage}">
        <TextBlock Classes="h1" Text="{DynamicResource Settings.Title}" />
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
          <Grid ColumnDefinitions="440,*" RowDefinitions="Auto,*" HorizontalAlignment="Left">
            <!-- The game's folders: found by RimForge or chosen by the player -->
            <Border Grid.ColumnSpan="2" Classes="panel" Padding="18,16" Margin="0,0,0,12" MaxWidth="1104">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="h2" Text="{DynamicResource Paths.Title}" />
                </StackPanel>
                <TextBlock Classes="muted" Text="{DynamicResource Paths.Hint}" TextWrapping="Wrap" />
                <TextBlock Classes="warn" FontSize="12" Text="{DynamicResource Paths.CopyNote}" TextWrapping="Wrap" IsVisible="{Binding PathsForInstalledOnly}" />
                <ItemsControl ItemsSource="{Binding PathRows}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathRowViewModel">
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                        <Grid ColumnDefinitions="30,200,*,Auto">
                          <TextBlock Classes="icon muted" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                          <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock FontSize="11.5" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsCustom}" />
                            <TextBlock FontSize="11.5" Text="{Binding StatusText}" Classes.faint="{Binding HasPath}" Classes.error="{Binding !HasPath}"
                                       IsVisible="{Binding !IsCustom}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <SelectableTextBlock Text="{Binding PathText}" FontSize="12.5" TextWrapping="Wrap" Classes.error="{Binding !HasPath}" />
                            <TextBlock Classes="faint" FontSize="11.5" Text="{Binding Hint}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Padding="10,4" IsVisible="{Binding CanChange}" ToolTip.Tip="{DynamicResource Tip.Paths.Choose}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChoosePathCommand}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" Text="&#xE8DA;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Paths.Choose}" />
                              </StackPanel>
                            </Button>
                            <Button Padding="10,4" IsVisible="{Binding CanReset}" ToolTip.Tip="{DynamicResource Tip.Paths.Reset}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetPathCommand}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" Text="&#xE72C;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Paths.Auto}" />
                              </StackPanel>
                            </Button>
                            <Button Classes="flat" Padding="8,4" IsEnabled="{Binding CanOpen}" ToolTip.Tip="{DynamicResource Tip.Paths.Open}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenPathCommand}" CommandParameter="{Binding}">
                              <TextBlock Classes="icon" Text="&#xE838;" FontSize="14" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- AI assistant: what it may do -->
            <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,24,20">
              <!-- The built-in assistant: how it reads requests -->
              <Border Classes="panel" Padding="18,16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE8BD;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{DynamicResource Brain.Title}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{DynamicResource Brain.Hint}" TextWrapping="Wrap" />

                  <RadioButton GroupName="asstBrain" IsChecked="{Binding BrainWords}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{DynamicResource Brain.Words}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Brain.Words.Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </RadioButton>

                  <RadioButton GroupName="asstBrain" IsChecked="{Binding BrainModel}" IsEnabled="{Binding IsBrainModelInstalled}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{DynamicResource Brain.Model}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Brain.Model.Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </RadioButton>
                  <StackPanel Spacing="6" Margin="28,0,0,0">
                    <TextBlock Classes="faint" FontSize="12" Text="{Binding BrainModelStatus}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding BrainModelProgress}" Maximum="1" Height="4" IsVisible="{Binding IsBrainModelDownloading}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Padding="12,4" Command="{Binding DownloadBrainModelCommand}" IsVisible="{Binding CanDownloadBrainModel}"
                              ToolTip.Tip="{DynamicResource Tip.Brain.Model.Download}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding BrainModelSizeText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Padding="12,4" Command="{Binding CancelBrainDownloadCommand}" IsVisible="{Binding IsBrainModelDownloading}"
                              Content="{DynamicResource Brain.Model.Pause}" ToolTip.Tip="{DynamicResource Tip.Brain.Model.Pause}" />
                      <Button Padding="12,4" Command="{Binding DeleteBrainModelCommand}" IsVisible="{Binding IsBrainModelInstalled}"
                              Content="{DynamicResource Brain.Model.Delete}" ToolTip.Tip="{DynamicResource Tip.Brain.Model.Delete}" />
                    </StackPanel>
                  </StackPanel>

                  <RadioButton GroupName="asstBrain" IsChecked="{Binding BrainServer}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{DynamicResource Brain.Server}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Brain.Server.Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </RadioButton>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="28,0,0,0">
                    <TextBlock Text="{DynamicResource Brain.Server.Where}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AsstPresets}" SelectedItem="{Binding AsstPreset}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Brain.Server.Url}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AsstServerUrl}" Margin="0,0,0,6" FontSize="12" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Brain.Server.Key}" VerticalAlignment="Center" Margin="0,0,10,6" IsVisible="{Binding AsstPresetNeedsKey}" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6" IsVisible="{Binding AsstPresetNeedsKey}">
                      <TextBox Text="{Binding AsstServerKey}" PasswordChar="•" FontSize="12" />
                      <Button Grid.Column="1" Classes="flat" Padding="8,3" Margin="6,0,0,0" Command="{Binding OpenAsstKeyPageCommand}"
                              IsVisible="{Binding AsstPresetHasKeyPage}" Content="{DynamicResource Brain.Server.GetKey}" ToolTip.Tip="{DynamicResource Tip.Brain.Server.GetKey}" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{DynamicResource Brain.Server.Model}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <AutoCompleteBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AsstServerModels}" Text="{Binding AsstServerModel}"
                                     FilterMode="Contains" MinimumPrefixLength="0" Margin="0,0,0,6" FontSize="12" />
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
                      <Button Padding="12,4" Command="{Binding CheckBrainServerCommand}" IsEnabled="{Binding !IsBrainServerChecking}"
                              Content="{DynamicResource Brain.Server.Check}" ToolTip.Tip="{DynamicResource Tip.Brain.Server.Check}" />
                      <TextBlock Classes="faint" FontSize="12" Text="{Binding BrainServerStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="panel" Padding="18,16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE99A;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="h2" Text="{DynamicResource Ai.Title}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{DynamicResource Ai.Hint}" TextWrapping="Wrap" />
                  <CheckBox IsChecked="{Binding AiEnabled}" Content="{DynamicResource Ai.Enabled}" ToolTip.Tip="{DynamicResource Tip.Ai.Enabled}" />
                  <StackPanel Spacing="4" IsEnabled="{Binding AiEnabled}">
                    <TextBlock Text="{DynamicResource Ai.AccessTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <RadioButton GroupName="aiAccess" IsChecked="{Binding AiAccessRead}" ToolTip.Tip="{DynamicResource Tip.Ai.Read}">
                      <TextBlock Text="{DynamicResource Ai.Read}" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton GroupName="aiAccess" IsChecked="{Binding AiAccessAsk}" ToolTip.Tip="{DynamicResource Tip.Ai.Ask}">
                      <TextBlock Text="{DynamicResource Ai.Ask}" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton GroupName="aiAccess" IsChecked="{Binding AiAccessFull}" ToolTip.Tip="{DynamicResource Tip.Ai.Full}">
                      <TextBlock Text="{DynamicResource Ai.Full}" TextWrapping="Wrap" />
                    </RadioButton>
                  </StackPanel>
                  <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Ai.CanDo}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- What the AI did -->
              <Border Classes="panel" Padding="18,16">
                <StackPanel Spacing="8">
                  <TextBlock Classes="h2" Text="{DynamicResource Ai.LogTitle}" />
                  <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Ai.LogEmpty}" TextWrapping="Wrap" IsVisible="{Binding !HasAiLog}" />
                  <ItemsControl ItemsSource="{Binding AiLog}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AiLogRow">
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                          <TextBlock Classes="faint" FontSize="12" Text="{Binding Time}" Width="42" />
                          <Panel Grid.Column="1" Width="20">
                            <TextBlock Classes="icon ok" Text="&#xE73E;" FontSize="11" IsVisible="{Binding Ok}" VerticalAlignment="Center" />
                            <TextBlock Classes="icon error" Text="&#xE711;" FontSize="11" IsVisible="{Binding !Ok}" VerticalAlignment="Center" />
                          </Panel>
                          <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- How to connect each AI app: one button each -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10" MaxWidth="640" Margin="0,0,0,20">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="{DynamicResource Ai.ConnectTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="accent" Command="{Binding ConnectAllAiClientsCommand}" IsVisible="{Binding CanConnectAnyAi}"
                        ToolTip.Tip="{DynamicResource Tip.Ai.ConnectAll}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="&#xE71B;" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Text="{DynamicResource Ai.ConnectAll}" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Classes="muted" Text="{DynamicResource Ai.ConnectHint}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding AiClients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiClientViewModel">
                    <Border Classes="panel" Padding="14,10" Margin="0,0,0,8" Classes.notFound="{Binding !IsFound}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="icon ok" Text="&#xE73E;" FontSize="11" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="faint" Classes.ok="{Binding IsConnected}"
                                         Classes.warn="{Binding NeedsUpdate}" TextWrapping="Wrap" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="flat" Padding="8,3" Command="{Binding ToggleManualCommand}" ToolTip.Tip="{DynamicResource Tip.Ai.Manual}">
                              <TextBlock Text="{DynamicResource Ai.Manual}" FontSize="12" />
                            </Button>
                            <Button Classes="accent" Padding="12,4" IsVisible="{Binding CanConnect}" ToolTip.Tip="{DynamicResource Tip.Ai.Connect}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConnectAiClientCommand}" CommandParameter="{Binding}">
                              <Panel>
                                <TextBlock Text="{DynamicResource Ai.Connect}" IsVisible="{Binding !NeedsUpdate}" />
                                <TextBlock Text="{DynamicResource Ai.Update}" IsVisible="{Binding NeedsUpdate}" />
                              </Panel>
                            </Button>
                            <Button Padding="12,4" IsVisible="{Binding IsConnected}" ToolTip.Tip="{DynamicResource Tip.Ai.Disconnect}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DisconnectAiClientCommand}" CommandParameter="{Binding}"
                                    Content="{DynamicResource Ai.Disconnect}" />
                          </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6" IsVisible="{Binding ShowManual}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="faint" FontSize="12" Text="{Binding Where}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="10,3" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Ai.Copy}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyAiSnippetCommand}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" Text="&#xE8C8;" />
                                <TextBlock Text="{DynamicResource Ai.Copy}" />
                              </StackPanel>
                            </Button>
                          </Grid>
                          <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="10,8">
                            <SelectableTextBlock Text="{Binding Snippet}" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="12" TextWrapping="Wrap" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Any other MCP app -->
              <Border Classes="panel" Padding="14,10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{DynamicResource Ai.OtherClient}" FontWeight="SemiBold" />
                      <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Ai.Where.Other}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Padding="10,3" VerticalAlignment="Top" Command="{Binding CopyOtherAiCommandCommand}" ToolTip.Tip="{DynamicResource Tip.Ai.Copy}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="&#xE8C8;" />
                        <TextBlock Text="{DynamicResource Ai.Copy}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="10,8">
                    <SelectableTextBlock Text="{Binding OtherAiCommand}" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,*" Margin="20,16,20,10" IsVisible="{Binding IsProfilesPage}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="{DynamicResource Profiles.Title}" />
            <TextBlock Classes="muted" Text="{DynamicResource Profiles.Hint}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding ProfileModSettings}" Content="{DynamicResource Profiles.OwnSettings}"
                      ToolTip.Tip="{DynamicResource Tip.Profiles.OwnSettings}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Command="{Binding OpenModpackFileCommand}" ToolTip.Tip="{DynamicResource Tip.Pack.Open}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE8B7;" />
                <TextBlock Text="{DynamicResource Pack.Open}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportCollectionCommand}" ToolTip.Tip="{DynamicResource Tip.Coll.Button}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE774;" />
                <TextBlock Text="{DynamicResource Coll.Button}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding OpenImportCommand}" ToolTip.Tip="{DynamicResource Tip.Profiles.Import}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE8E5;" />
                <TextBlock Text="{DynamicResource Profiles.Import}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding NewProfileCommand}" ToolTip.Tip="{DynamicResource Tip.Profiles.New}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE710;" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock Text="{DynamicResource Profiles.New}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0">
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileViewModel">
                <Border Classes="panel" Width="330" Margin="0,0,14,14" Padding="16,14"
                        Classes.activeCard="{Binding IsActive}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="16" />
                      <Border Grid.Column="1" Classes="badge" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding IsActive}" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Profiles.Active}" Foreground="{StaticResource AccentBrush}" />
                      </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding CountText}" />
                      <TextBlock Text="{Binding MissingText}" Classes="error" IsVisible="{Binding HasMissing}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ModifiedText}" Classes="faint" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                      <Panel HorizontalAlignment="Left">
                        <Button Classes="accent" Content="{DynamicResource Profiles.Apply}" IsVisible="{Binding !IsActive}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchProfileCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource Tip.Profiles.Apply}" />
                        <Button Content="{DynamicResource Profiles.Open}" IsVisible="{Binding IsActive}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPageCommand}"
                                CommandParameter="mods" ToolTip.Tip="{DynamicResource Tip.Profiles.Open}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Profiles.Share}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShareProfileCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE72D;" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                        <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Profiles.Rename}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameProfileCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE8AC;" />
                        </Button>
                        <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Profiles.Copy}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateProfileCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE8C8;" />
                        </Button>
                        <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Profiles.Delete}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteProfileCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE74D;" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Diagnostics page -->
      <Grid Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto,*" Margin="20,16,20,10" IsVisible="{Binding IsDiagnosticsPage}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="{DynamicResource Diag.Title}" />
            <TextBlock Classes="muted" Text="{DynamicResource Diag.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Command="{Binding OpenBisectCommand}" ToolTip.Tip="{DynamicResource Tip.Bisect.Button}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE721;" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{DynamicResource Bisect.Button}" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding RunDiagnosticsCommand}" ToolTip.Tip="{DynamicResource Tip.Diag.Run}"
                      IsEnabled="{Binding !IsScanning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE9D9;" Foreground="{StaticResource AccentTextBrush}" />
                  <TextBlock Text="{DynamicResource Diag.Run}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{DynamicResource Tip.Diag.Log}">
              <TextBlock Text="{DynamicResource Diag.LogLabel}" Classes="muted" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding LogOptions}" SelectedIndex="{Binding LogChoice}" MinWidth="250" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Progress / summary -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="6">
          <StackPanel Spacing="6" IsVisible="{Binding IsScanning}">
            <TextBlock Text="{DynamicResource Diag.Scanning}" Classes="muted" />
            <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
          <TextBlock Text="{DynamicResource Diag.Empty}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding !HasReport}" Margin="0,30,0,0" HorizontalAlignment="Center" />
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" IsVisible="{Binding HasReport}">
            <Border Classes="badge" BorderBrush="{StaticResource ErrorBrush}" Margin="0,0,8,0">
              <TextBlock Text="{Binding HighText}" Foreground="{StaticResource ErrorBrush}" FontSize="12" />
            </Border>
            <Border Grid.Column="1" Classes="badge" BorderBrush="{StaticResource WarnBrush}" Margin="0,0,8,0">
              <TextBlock Text="{Binding MediumText}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
            </Border>
            <Border Grid.Column="2" Classes="badge" BorderBrush="{StaticResource BorderStrongBrush}">
              <TextBlock Text="{Binding MinorText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding ReportInfo}" Classes="faint" FontSize="12" Margin="14,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <CheckBox Grid.Column="4" IsChecked="{Binding ShowMinor}" Content="{DynamicResource Diag.ShowMinor}"
                      ToolTip.Tip="{DynamicResource Tip.Diag.ShowMinor}" Margin="0,0,12,0" />
            <CheckBox Grid.Column="5" IsChecked="{Binding ShowIgnored}" ToolTip.Tip="{DynamicResource Tip.Diag.ShowIgnored}">
              <TextBlock>
                <Run Text="{DynamicResource Diag.ShowIgnored}" /><Run Text=" (" /><Run Text="{Binding HiddenText}" /><Run Text=")" />
              </TextBlock>
            </CheckBox>
          </Grid>
          <Border Classes="panel" Background="{StaticResource SelectionBrush}" BorderBrush="{StaticResource AccentBrush}" Padding="12,8"
                  IsVisible="{Binding IsReportStale}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{DynamicResource Diag.Stale}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Sections -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,8" IsVisible="{Binding HasReport}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="nav-tab" Classes.current="{Binding IsLogSection}" Command="{Binding ShowDiagSectionCommand}" CommandParameter="log"
                  Content="{Binding LogTabText}" ToolTip.Tip="{DynamicResource Tip.Diag.TabLog}" />
          <Button Classes="nav-tab" Classes.current="{Binding IsCodeSection}" Command="{Binding ShowDiagSectionCommand}" CommandParameter="code"
                  Content="{Binding CodeTabText}" ToolTip.Tip="{DynamicResource Tip.Diag.TabCode}" />
          <Button Classes="nav-tab" Classes.current="{Binding IsDataSection}" Command="{Binding ShowDiagSectionCommand}" CommandParameter="data"
                  Content="{Binding DataTabText}" ToolTip.Tip="{DynamicResource Tip.Diag.TabData}" />
        </StackPanel>
          <Button Grid.Column="1" Classes="accent" Command="{Binding FixAllSafeCommand}" ToolTip.Tip="{DynamicResource Tip.Fix.AllSafe}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xE90F;" Foreground="{StaticResource AccentTextBrush}" />
              <TextBlock Text="{DynamicResource Fix.AllSafe}" />
            </StackPanel>
          </Button>
        </Grid>

        <Panel Grid.Row="3" IsVisible="{Binding HasReport}">
          <TextBlock Text="{DynamicResource Diag.SectionEmpty}" Classes="ok" IsVisible="{Binding SectionIsEmpty}" Margin="0,10" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding VisibleFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FindingViewModel">
                  <Border Classes="panel" Padding="14,12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Width="24" VerticalAlignment="Top" Margin="0,1,10,0">
                        <TextBlock Classes="icon error" Text="&#xEA39;" FontSize="16" IsVisible="{Binding IsHigh}" />
                        <TextBlock Classes="icon warn" Text="&#xE7BA;" FontSize="16" IsVisible="{Binding IsMedium}" />
                        <TextBlock Classes="icon faint" Text="&#xE946;" FontSize="16" IsVisible="{Binding IsMinor}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <Border Grid.Column="1" Classes="badge" BorderBrush="{StaticResource BorderStrongBrush}" Margin="8,0,0,0"
                                  IsVisible="{Binding HasCount}">
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextMutedBrush}" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                        <WrapPanel IsVisible="{Binding HasMods}">
                          <TextBlock Text="{Binding ModsLabel}" Classes="faint" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4" />
                          <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ModChip">
                                <Button Padding="8,2" Margin="0,0,6,4" FontSize="12"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModCommand}"
                                        CommandParameter="{Binding Id}">
                                  <ToolTip.Tip>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Tip}" />
                                      <TextBlock Text="{DynamicResource Tip.Diag.Chip}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                  </ToolTip.Tip>
                                  <TextBlock Text="{Binding Name}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Fix.Fixed}" Classes="ok" FontWeight="SemiBold" IsVisible="{Binding IsFixed}" />
                        <ItemsControl ItemsSource="{Binding Fixes}" IsVisible="{Binding ShowFixes}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FixOptionViewModel">
                              <Button Padding="10,4" Margin="0,0,8,4" ToolTip.Tip="{Binding Tip}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyFixCommand}"
                                      CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Classes="icon ok" Text="&#xE90F;" FontSize="12" IsVisible="{Binding IsSafe}" />
                                  <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="flat" HorizontalAlignment="Left" Padding="0,2" Command="{Binding ToggleDetailsCommand}"
                                ToolTip.Tip="{DynamicResource Tip.Diag.Details}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource Diag.Details}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                          </StackPanel>
                        </Button>
                        <Border Background="{StaticResource BgBrush}" CornerRadius="3" Padding="10" IsVisible="{Binding IsExpanded}">
                          <SelectableTextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </Grid>

      <!-- Workshop page -->
      <Grid Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto,*" Margin="20,16,20,10" IsVisible="{Binding IsWorkshopPage}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="{DynamicResource Ws.Title}" />
            <TextBlock Classes="muted" Text="{DynamicResource Ws.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <!-- Steam connection -->
          <Border Grid.Column="1" Classes="panel" Padding="12,8" VerticalAlignment="Top" Margin="16,0,0,0"
                  ToolTip.Tip="{DynamicResource Tip.Ws.Steam}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="10" Height="10" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource OkBrush}" IsVisible="{Binding IsSteamOk}" />
                <Ellipse Fill="{StaticResource WarnBrush}" IsVisible="{Binding IsSteamWarn}" />
                <Ellipse Fill="{StaticResource BorderStrongBrush}" IsVisible="{Binding !IsSteamOk}" />
              </Panel>
              <TextBlock Text="{Binding SteamStatusText}" VerticalAlignment="Center" MaxWidth="360" TextWrapping="Wrap" FontSize="12.5" />
              <Button Content="{DynamicResource Ws.Steam.Start}" Command="{Binding StartSteamCommand}" IsVisible="{Binding CanStartSteam}"
                      Padding="10,3" ToolTip.Tip="{DynamicResource Tip.Ws.StartSteam}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Tabs -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,10">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="nav-tab" Classes.current="{Binding IsWsSearch}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="search"
                    Content="{DynamicResource Ws.Tab.Search}" ToolTip.Tip="{DynamicResource Tip.Ws.TabSearch}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsThemes}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="themes"
                    Content="{DynamicResource Ws.Tab.Themes}" ToolTip.Tip="{DynamicResource Tip.Ws.TabThemes}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsCollections}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="collections"
                    Content="{DynamicResource Ws.Tab.Collections}" ToolTip.Tip="{DynamicResource Tip.Ws.TabCollections}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsUpdates}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="updates"
                    Content="{Binding UpdatesTabText}" ToolTip.Tip="{DynamicResource Tip.Ws.TabUpdates}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsDownloads}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="downloads"
                    Content="{Binding DownloadsTabText}" ToolTip.Tip="{DynamicResource Tip.Ws.TabDownloads}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsCleanup}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="cleanup"
                    Content="{DynamicResource Ws.Tab.Cleanup}" ToolTip.Tip="{DynamicResource Tip.Ws.TabCleanup}" />
            <Button Classes="nav-tab" Classes.current="{Binding IsWsTranslations}" Command="{Binding ShowWorkshopSectionCommand}" CommandParameter="translations"
                    Content="{Binding TranslationsTabText}" ToolTip.Tip="{DynamicResource Tip.Ws.TabTranslations}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
            <ToggleButton IsChecked="{Binding AutoTranslate}" ToolTip.Tip="{DynamicResource Tip.Tr.Auto}" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="trGlyph" Text="文A" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Tr.Auto}" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Button Padding="8,4" Margin="-10,0,0,0" ToolTip.Tip="{DynamicResource Tip.Tr.Settings}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Classes="icon" Text="&#xE713;" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TranslationButtonText}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           IsVisible="{Binding IsModelDownloading}" />
                <TextBlock Classes="icon" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="8" Width="430">
                    <TextBlock Classes="h2" Text="{DynamicResource Tr.Engine.Title}" />
                    <RadioButton GroupName="TrEngine" IsChecked="{Binding EngineOnline}" ToolTip.Tip="{DynamicResource Tip.Tr.Engine.Online}">
                      <TextBlock Text="{DynamicResource Tr.Engine.Online}" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton GroupName="TrEngine" IsChecked="{Binding EngineOffline}" IsEnabled="{Binding IsModelInstalled}"
                                 ToolTip.Tip="{DynamicResource Tip.Tr.Engine.Offline}">
                      <TextBlock Text="{DynamicResource Tr.Engine.Offline}" TextWrapping="Wrap" />
                    </RadioButton>
                    <CheckBox IsChecked="{Binding TranslateFallback}" ToolTip.Tip="{DynamicResource Tip.Tr.Engine.Fallback}">
                      <TextBlock Text="{DynamicResource Tr.Engine.Fallback}" TextWrapping="Wrap" />
                    </CheckBox>

                    <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="12,10" Margin="0,4,0,0">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Tr.Model.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding ModelStatusText}" FontSize="12" VerticalAlignment="Center"
                                     Classes.ok="{Binding IsModelInstalled}" Classes.muted="{Binding !IsModelInstalled}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Tr.Model.About}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding ModelProgress}" Maximum="1" Height="6" MinWidth="0" IsVisible="{Binding IsModelDownloading}"
                                     Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="accent" Padding="12,4" IsVisible="{Binding CanDownloadModel}" Command="{Binding DownloadModelCommand}"
                                  ToolTip.Tip="{DynamicResource Tip.Tr.Model.Download}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="icon" Text="&#xE896;" FontSize="11" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding DownloadModelText}" />
                            </StackPanel>
                          </Button>
                          <Button Padding="12,4" IsVisible="{Binding IsModelDownloading}" Command="{Binding CancelModelDownloadCommand}"
                                  Content="{DynamicResource Tr.Model.Cancel}" ToolTip.Tip="{DynamicResource Tip.Tr.Model.Cancel}" />
                          <Button Padding="12,4" IsVisible="{Binding CanDeleteModel}" Command="{Binding DeleteModelCommand}"
                                  ToolTip.Tip="{DynamicResource Tip.Tr.Model.Delete}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="icon" Text="&#xE74D;" FontSize="11" VerticalAlignment="Center" />
                              <TextBlock Text="{DynamicResource Tr.Model.Delete}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Tr.Model.License}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <CheckBox IsChecked="{Binding EnableAfterDownload}" Content="{DynamicResource Ws.EnableAfter}"
                      ToolTip.Tip="{DynamicResource Tip.Ws.EnableAfter}" />
          </StackPanel>
        </Grid>

        <!-- Search bar / selection tiles -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,10" IsVisible="{Binding ShowResults}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" IsVisible="{Binding IsWsSearch}">
            <TextBox x:Name="WorkshopSearchBox" Text="{Binding WorkshopText}" Watermark="{DynamicResource Ws.SearchHint}"
                     ToolTip.Tip="{DynamicResource Tip.Ws.Search}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding WorkshopSearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding WorkshopSortOptions}" SelectedIndex="{Binding WorkshopSortIndex}"
                      MinWidth="210" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Ws.Sort}" />
            <Button Grid.Column="2" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Ws.Filters}" Classes.accentBorder="{Binding HasSearchCategory}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE71C;" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding WorkshopFilterText}" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkshopFiltersPanel}" />
                </Flyout>
              </Button.Flyout>
            </Button>
            <Border Grid.Column="3" Classes="tag manual" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasSearchCategory}"
                    ToolTip.Tip="{DynamicResource Tip.Ws.CategoryTag}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding SearchCategoryText}" FontSize="12" VerticalAlignment="Center" />
                <Button Classes="flat" Padding="2,0" Command="{Binding PickSearchCategoryCommand}" CommandParameter="{Binding SearchCategory}">
                  <TextBlock Classes="icon" Text="&#xE711;" FontSize="9" />
                </Button>
              </StackPanel>
            </Border>
            <Button Grid.Column="4" Classes="accent" Command="{Binding WorkshopSearchCommand}" Margin="8,0,0,0"
                    ToolTip.Tip="{DynamicResource Tip.Ws.SearchButton}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE721;" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock Text="{DynamicResource Ws.Find}" />
              </StackPanel>
            </Button>
          </Grid>
          <!-- Collections: words, popularity, size, game version, theme buttons -->
          <StackPanel Spacing="8" IsVisible="{Binding IsWsCollections}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <TextBox Text="{Binding CollText}" Watermark="{DynamicResource Coll.SearchHint}" ToolTip.Tip="{DynamicResource Tip.Coll.Search}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CollSearchCommand}" />
                </TextBox.KeyBindings>
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="icon faint" Text="&#xE721;" Margin="8,0,0,0" FontSize="12" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <ComboBox Grid.Column="1" ItemsSource="{Binding CollSortOptions}" SelectedIndex="{Binding CollSortIndex}" MinWidth="200"
                        Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Coll.Sort}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding CollSizeOptions}" SelectedIndex="{Binding CollSizeIndex}" MinWidth="170"
                        Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Coll.Size}" />
              <CheckBox Grid.Column="3" IsChecked="{Binding OnlyMyVersion}" Content="{Binding WorkshopVersionText}" Margin="10,0,0,0"
                        ToolTip.Tip="{DynamicResource Tip.Ws.OnlyMyVersion}" />
              <Button Grid.Column="4" Classes="accent" Command="{Binding CollSearchCommand}" Margin="8,0,0,0" Padding="14,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE721;" Foreground="{StaticResource AccentTextBrush}" />
                  <TextBlock Text="{DynamicResource Ws.Find}" />
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding CollThemes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CollThemeViewModel">
                  <Button Classes="nav-tab" Classes.current="{Binding IsCurrent}" Content="{Binding Name}" Padding="12,4"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PickCollThemeCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsWsThemes}">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="muted" Text="{DynamicResource Ws.Themes.Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding WorkshopSortOptions}" SelectedIndex="{Binding WorkshopSortIndex}"
                        MinWidth="210" Margin="12,0,0,0" ToolTip.Tip="{DynamicResource Tip.Ws.Sort}" />
              <Button Grid.Column="2" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Tip.Ws.Filters}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE71C;" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding WorkshopFilterText}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkshopFiltersPanel}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Themes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeViewModel">
                  <Button Classes="tile" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Tip}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowThemeCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Results + details -->
        <Grid x:Name="WsResultsGrid" Grid.Row="3" IsVisible="{Binding ShowResults}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" MaxWidth="900" />
          </Grid.ColumnDefinitions>
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="{Binding ResultsHeader}" Classes="h2" TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4" IsVisible="{Binding IsWorkshopBusy}"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding ResultsNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasResultsNote}" Margin="0,10" />
            <ListBox x:Name="WsResultsList" Grid.Row="2" Classes="cards" ItemsSource="{Binding WorkshopResults}" SelectedItem="{Binding SelectedCard}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkshopCardViewModel">
                  <StackPanel Width="236">
                    <Panel Height="133" Background="#0E0F11">
                      <TextBlock Classes="icon faint" Text="&#xE774;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                      <Border Classes="badge" Background="#E01B1D21" BorderBrush="{StaticResource OkBrush}" Margin="6"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsInstalled}">
                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource OkBrush}" />
                      </Border>
                      <!-- Big tick: you already have this one -->
                      <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource OkBrush}" Margin="6"
                              HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsInstalled}"
                              ToolTip.Tip="{DynamicResource Tip.Ws.HaveIt}" BoxShadow="0 1 4 0 #80000000">
                        <TextBlock Classes="icon" Text="&#xE73E;" FontSize="14" FontWeight="Bold" Foreground="#101214"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="flat" Padding="5,1" Margin="6" Background="#E01B1D21" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              IsVisible="{Binding IsForeign}" ToolTip.Tip="{Binding TranslationText}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleCardTranslationCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="文A" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding TranslationBadge}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Classes.faint="{Binding !ShowTranslated}" />
                        </StackPanel>
                      </Button>
                      <Border Classes="badge" Background="#E01B1D21" BorderBrush="{StaticResource AccentBrush}" Margin="6"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsCollection}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="icon" Text="&#xE8F1;" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{DynamicResource Badge.Collection}" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="badge" Background="#E01B1D21" BorderBrush="{StaticResource WarnBrush}" Margin="6"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding NeedsDlc}"
                              ToolTip.Tip="{DynamicResource Tip.Ws.NeedsDlc}">
                        <TextBlock Text="{Binding NeedsDlcText}" Foreground="{StaticResource WarnBrush}" />
                      </Border>
                    </Panel>
                    <StackPanel Margin="10,8,10,10" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Height="38"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Text="{Binding AuthorText}" Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" Height="15" />
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsCollection}">
                        <TextBlock Classes="icon" Text="&#xE8F1;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding ChildCountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" ToolTip.Tip="{Binding FavoritesText}" Background="Transparent">
                          <TextBlock Classes="icon" Text="&#xE734;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource WorkshopBrush}" />
                          <TextBlock Text="{Binding FavoritesShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WorkshopBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" ToolTip.Tip="{Binding UpdatedText}" Background="Transparent">
                          <TextBlock Classes="icon faint" Text="&#xE823;" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding UpdatedShort}" FontSize="11" Classes="faint" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsMod}">
                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding SubscribersText}" Background="Transparent">
                          <TextBlock Classes="icon" Text="&#xE716;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource WorkshopBrush}" />
                          <TextBlock Text="{Binding SubscribersShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WorkshopBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" IsVisible="{Binding HasRating}"
                                    ToolTip.Tip="{DynamicResource Tip.Ws.Rating}" Background="Transparent">
                          <TextBlock Classes="icon" Text="&#xE8E1;" FontSize="11" VerticalAlignment="Center"
                                     Classes.ok="{Binding IsRatingGood}" Classes.warn="{Binding IsRatingMid}" Classes.error="{Binding IsRatingBad}" />
                          <TextBlock Text="{Binding RatingShort}" FontSize="11.5" FontWeight="SemiBold"
                                     Classes.ok="{Binding IsRatingGood}" Classes.warn="{Binding IsRatingMid}" Classes.error="{Binding IsRatingBad}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" ToolTip.Tip="{Binding UpdatedText}" Background="Transparent">
                          <TextBlock Classes="icon" Text="&#xE823;" FontSize="11" VerticalAlignment="Center"
                                     Classes.ok="{Binding IsFresh}" Classes.faint="{Binding IsUpdatedNormal}" Classes.warn="{Binding IsStale}" />
                          <TextBlock Text="{Binding UpdatedShort}" FontSize="11"
                                     Classes.ok="{Binding IsFresh}" Classes.faint="{Binding IsUpdatedNormal}" Classes.warn="{Binding IsStale}" />
                        </StackPanel>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" Height="28">
                        <TextBlock Text="{Binding VersionsText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Classes.muted="{Binding SupportsMyVersion}" Classes.warn="{Binding !SupportsMyVersion}" />
                        <Panel Grid.Column="1">
                          <TextBlock Text="{DynamicResource Coll.OpenHint}" Classes="faint" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsCollection}" />
                          <Button Classes="accent" Padding="10,3" IsVisible="{Binding CanSubscribeMod}" ToolTip.Tip="{DynamicResource Tip.Ws.Subscribe}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopSubscribeCommand}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Classes="icon" Text="&#xE896;" FontSize="11" Foreground="{StaticResource AccentTextBrush}" />
                              <TextBlock Text="{DynamicResource Ws.Subscribe}" FontSize="12" />
                            </StackPanel>
                          </Button>
                          <StackPanel IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Width="96" Spacing="2">
                            <TextBlock Text="{Binding StateText}" FontSize="11" Classes="muted" HorizontalAlignment="Right" />
                            <ProgressBar Classes="download" Value="{Binding Progress}" Maximum="1" Height="4" />
                          </StackPanel>
                          <Button Padding="10,3" IsVisible="{Binding CanEnable}" ToolTip.Tip="{DynamicResource Tip.Ws.Enable}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopEnableCommand}" CommandParameter="{Binding}">
                            <TextBlock Text="{DynamicResource Fix.Enable}" FontSize="12" />
                          </Button>
                          <TextBlock Classes="icon ok" Text="&#xE73E;" IsVisible="{Binding IsActive}" VerticalAlignment="Center"
                                     ToolTip.Tip="{DynamicResource Tip.Ws.InModpack}" />
                        </Panel>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Pages, like a book: back, numbers, next, and "page [ ] of N" -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,8,0,0"
                        IsVisible="{Binding HasWsPager}" IsEnabled="{Binding !IsWorkshopBusy}">
              <Button Padding="10,5" Command="{Binding WsPrevPageCommand}" IsEnabled="{Binding CanWsPrev}" ToolTip.Tip="{DynamicResource Tip.Ws.Prev}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE76B;" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Ws.Prev}" />
                </StackPanel>
              </Button>
              <ItemsControl ItemsSource="{Binding WsPageButtons}" Margin="4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WsPageButton">
                    <Panel>
                      <Button MinWidth="34" Padding="8,5" HorizontalContentAlignment="Center" IsVisible="{Binding IsPage}"
                              Classes.accent="{Binding IsCurrent}" Content="{Binding Text}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WsGoPageCommand}" CommandParameter="{Binding Number}" />
                      <TextBlock Text="…" Classes="muted" IsVisible="{Binding IsGap}" VerticalAlignment="Center" Margin="4,0" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Padding="10,5" Command="{Binding WsNextPageCommand}" IsEnabled="{Binding CanWsNext}" ToolTip.Tip="{DynamicResource Tip.Ws.Next}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{DynamicResource Ws.Next}" />
                  <TextBlock Classes="icon" Text="&#xE76C;" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="{DynamicResource Ws.Page}" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0" />
              <TextBox Text="{Binding WsPageInput}" Width="64" MinWidth="64" Watermark="{Binding WsPage}" HorizontalContentAlignment="Center"
                       ToolTip.Tip="{DynamicResource Tip.Ws.PageInput}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding WsGoTypedPageCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Text="{Binding WsPageOf}" Classes="muted" VerticalAlignment="Center" />
              <Button Padding="10,5" Command="{Binding WsGoTypedPageCommand}" Content="{DynamicResource Ws.Go}" />
            </StackPanel>
          </Grid>

          <!-- Details of the chosen mod -->
          <GridSplitter x:Name="WsSplit" Grid.Column="1" Classes="panelSplit" ResizeDirection="Columns" IsVisible="{Binding HasCard}" />
          <Border Grid.Column="2" Classes="panel" Padding="0" IsVisible="{Binding HasCard}">
            <Grid RowDefinitions="Auto,*,Auto">
              <Panel>
                <Panel Height="200" Background="#0E0F11" IsVisible="{Binding !CardGallery.HasItems}" VerticalAlignment="Top">
                  <Image Source="{Binding SelectedCardPreview}" Stretch="Uniform" />
                </Panel>
                <ContentControl Content="{Binding CardGallery}" ContentTemplate="{StaticResource GalleryView}" IsVisible="{Binding CardGallery.HasItems}"
                                Margin="0,0,0,6" />
                <Button Classes="flat" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Background="#C01B1D21"
                        Command="{Binding CloseCardCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
                  <TextBlock Classes="icon" Text="&#xE711;" />
                </Button>
              </Panel>
              <ScrollViewer Grid.Row="1" DataContext="{Binding SelectedCard}" x:DataType="vm:WorkshopCardViewModel">
                <StackPanel Margin="14,12" Spacing="6">
                  <SelectableTextBlock Text="{Binding Title, FallbackValue=''}" Classes="h2" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AuthorText, FallbackValue=''}" Classes="muted" IsVisible="{Binding HasAuthor, FallbackValue=False}" />
                  <WrapPanel IsVisible="{Binding IsCollection, FallbackValue=False}">
                    <TextBlock Text="{Binding ChildCountText, FallbackValue=''}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,14,2"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding FavoritesText, FallbackValue=''}" FontSize="12.5" Margin="0,0,14,2" Foreground="{StaticResource WorkshopBrush}" />
                    <TextBlock Text="{Binding UpdatedText, FallbackValue=''}" FontSize="12" Margin="0,0,14,2" Classes="faint" />
                  </WrapPanel>
                  <WrapPanel IsVisible="{Binding IsMod, FallbackValue=True}">
                    <TextBlock Text="{Binding SubscribersText, FallbackValue=''}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,14,2"
                               Foreground="{StaticResource WorkshopBrush}" />
                    <TextBlock Text="{Binding RatingText, FallbackValue=''}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,14,2"
                               IsVisible="{Binding HasRating, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.Rating}"
                               Classes.ok="{Binding IsRatingGood, FallbackValue=False}" Classes.warn="{Binding IsRatingMid, FallbackValue=False}"
                               Classes.error="{Binding IsRatingBad, FallbackValue=False}" />
                    <TextBlock Text="{Binding SizeText, FallbackValue=''}" Classes="faint" FontSize="12" Margin="0,0,14,2" />
                    <TextBlock Text="{Binding UpdatedText, FallbackValue=''}" FontSize="12" Margin="0,0,14,2"
                               Classes.ok="{Binding IsFresh, FallbackValue=False}" Classes.faint="{Binding IsUpdatedNormal, FallbackValue=True}"
                               Classes.warn="{Binding IsStale, FallbackValue=False}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding NeedsDlcText, FallbackValue=''}" Classes="warn" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding NeedsDlc, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.NeedsDlc}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{DynamicResource Tip.Ws.Versions}">
                    <TextBlock Text="{DynamicResource Details.Versions}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding VersionsText, FallbackValue=''}" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{Binding VersionWarning, FallbackValue=''}" Classes="warn" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding !SupportsMyVersion, FallbackValue=False}" />
                  <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsCollection, FallbackValue=False}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{DynamicResource CollC.ModsTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="flat" Padding="6,2" FontSize="12" Content="{DynamicResource Clean.SelectAll}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollectionTickAllCommand}" CommandParameter="all" />
                      <Button Grid.Column="2" Classes="flat" Padding="6,2" FontSize="12" Content="{DynamicResource Clean.SelectNone}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollectionTickAllCommand}" CommandParameter="none" />
                    </Grid>
                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollectionSummary, FallbackValue=''}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsCollectionLoading, FallbackValue=False}"
                                 Foreground="{StaticResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollectionMods}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionModRow">
                          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanTick}" MinWidth="0" Padding="0" Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="64" Height="36" CornerRadius="2" ClipToBounds="True" Background="#0E0F11" VerticalAlignment="Center">
                                  <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                </Border>
                                <Button Grid.Column="2" Classes="flat" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleCollectionModCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{DynamicResource Tip.CollC.Row}">
                                  <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" Classes.faint="{Binding IsRemoved}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="faint" Classes.ok="{Binding IsInstalled}"
                                               Classes.error="{Binding IsRemoved}" />
                                  </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Classes="flat" Padding="6,2" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Ws.OpenPage}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCollectionModPageCommand}" CommandParameter="{Binding}">
                                  <TextBlock Classes="icon" Text="&#xE8A7;" FontSize="12" />
                                </Button>
                              </Grid>
                              <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Classes="muted" Margin="96,0,0,4"
                                         IsVisible="{Binding IsExpanded}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource CollC.About}" FontWeight="SemiBold" Margin="0,8,0,0" />
                  </StackPanel>
                  <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="10,6" Margin="0,6,0,0">
                    <Panel>
                      <WrapPanel IsVisible="{Binding IsTranslated, FallbackValue=False}" ItemSpacing="8">
                        <TextBlock Text="文A" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TranslationText, FallbackValue=''}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        <Button Classes="flat" Padding="4,0" Content="{Binding TranslationToggleText, FallbackValue=''}" FontSize="12"
                                Foreground="{StaticResource AccentBrush}" ToolTip.Tip="{DynamicResource Tip.Tr.Toggle}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleCardTranslationCommand}" CommandParameter="{Binding}" />
                      </WrapPanel>
                      <Button Padding="10,3" IsVisible="{Binding CanTranslate, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Tr.Translate}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleCardTranslationCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="文A" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="{DynamicResource Tr.Translate}" />
                        </StackPanel>
                      </Button>
                      <TextBlock Text="{DynamicResource Tr.Working}" Classes="muted" FontSize="12" IsVisible="{Binding IsTranslating, FallbackValue=False}" />
                    </Panel>
                  </Border>
                  <SelectableTextBlock Text="{Binding DisplayDescription, FallbackValue=''}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
              </ScrollViewer>
              <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10"
                      DataContext="{Binding SelectedCard}" x:DataType="vm:WorkshopCardViewModel">
                <WrapPanel>
                  <Button Classes="accent" Margin="0,0,8,6" IsVisible="{Binding IsCollection, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.CollC.Create}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CreateFromCollectionCommand}" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanCreateFromCollection, FallbackValue=False}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" />
                      <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollectionCreateText, FallbackValue=''}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="accent" Margin="0,0,8,6" IsVisible="{Binding CanSubscribeMod, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.Subscribe}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopSubscribeCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" />
                      <TextBlock Text="{DynamicResource Ws.SubscribeLong}" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding StateText, FallbackValue=''}" Classes="muted" VerticalAlignment="Center" Margin="0,0,10,6"
                             IsVisible="{Binding IsBusy, FallbackValue=False}" />
                  <Button Classes="accent" Margin="0,0,8,6" IsVisible="{Binding CanEnable, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.Enable}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopEnableCommand}" CommandParameter="{Binding}"
                          Content="{DynamicResource Ws.EnableInPack}" />
                  <Button Margin="0,0,8,6" IsVisible="{Binding IsInstalled, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.ShowInList}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopShowInListCommand}" CommandParameter="{Binding}"
                          Content="{DynamicResource Ws.ShowInList}" />
                  <Button Margin="0,0,8,6" ToolTip.Tip="{DynamicResource Tip.Ws.OpenPage}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopOpenPageCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="icon" Text="&#xE8A7;" />
                      <TextBlock Text="{DynamicResource Ws.OpenPage}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="flat" Margin="0,0,8,6" IsVisible="{Binding CanUnsubscribe, FallbackValue=False}" ToolTip.Tip="{DynamicResource Tip.Ws.Unsubscribe}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WorkshopUnsubscribeCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{DynamicResource Ws.Unsubscribe}" Classes="faint" />
                  </Button>
                </WrapPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Updates -->
        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsWsUpdates}">
          <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding UpdatesSeenText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <Button Command="{Binding RecheckUpdatesCommand}" ToolTip.Tip="{DynamicResource Tip.Upd.Recheck}" IsEnabled="{Binding !IsCheckingUpdates}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="&#xE72C;" />
                    <TextBlock Text="{DynamicResource Upd.Recheck}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding MarkUpdatesSeenCommand}" ToolTip.Tip="{DynamicResource Tip.Upd.MarkSeen}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="&#xE73E;" />
                    <TextBlock Text="{DynamicResource Upd.MarkSeen}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCheckingUpdates}">
              <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Upd.Checking}" Classes="muted" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Upd.Empty}" Classes="ok" IsVisible="{Binding UpdatesEmpty}" Margin="0,10" />

            <StackPanel Spacing="6" IsVisible="{Binding HasPendingUpdates}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{DynamicResource Upd.Pending}" Classes="h2" />
                  <TextBlock Text="{DynamicResource Upd.PendingHint}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Command="{Binding UpdateAllPendingCommand}" VerticalAlignment="Top"
                        ToolTip.Tip="{DynamicResource Tip.Upd.UpdateAll}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Text="{DynamicResource Upd.UpdateAll}" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding PendingUpdates}" ItemTemplate="{StaticResource UpdateRow}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasRecentUpdates}">
              <TextBlock Text="{DynamicResource Upd.Recent}" Classes="h2" />
              <TextBlock Text="{DynamicResource Upd.RecentHint}" Classes="muted" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding RecentUpdates}" ItemTemplate="{StaticResource UpdateRow}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasRemovedMods}">
              <TextBlock Text="{DynamicResource Upd.Removed}" Classes="h2 warn" />
              <TextBlock Text="{DynamicResource Upd.RemovedHint}" Classes="muted" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding RemovedMods}" ItemTemplate="{StaticResource UpdateRow}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Download queue -->
        <Grid Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding IsWsDownloads}">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Dl.Hint}" Classes="muted" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Command="{Binding ClearFinishedDownloadsCommand}" IsVisible="{Binding HasDownloads}"
                    ToolTip.Tip="{DynamicResource Tip.Dl.Clear}" Content="{DynamicResource Dl.Clear}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{DynamicResource Dl.Empty}" Classes="muted" IsVisible="{Binding !HasDownloads}" Margin="0,10" TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Downloads}" MaxWidth="1000" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadViewModel">
                  <Border Classes="panel" Padding="14,10" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,220,Auto">
                      <Panel Width="22" VerticalAlignment="Top" Margin="0,1,8,0">
                        <TextBlock Classes="icon ok" Text="&#xE73E;" IsVisible="{Binding IsDone}" />
                        <TextBlock Classes="icon error" Text="&#xEA39;" IsVisible="{Binding IsFailed}" />
                        <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource DownloadBrush}" IsVisible="{Binding IsRunning}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NeededByText}" Classes="faint" FontSize="12" IsVisible="{Binding HasNeededBy}" />
                        <TextBlock Text="{Binding Note}" Classes="warn" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="3" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                   Classes.ok="{Binding IsDone}" Classes.error="{Binding IsFailed}" Classes.muted="{Binding IsRunning}" />
                        <ProgressBar Classes="download" Classes.stalled="{Binding IsWaiting}" Value="{Binding Progress}" Maximum="1" Height="4"
                                     IsVisible="{Binding IsRunning}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Dl.StopWaiting}" IsVisible="{Binding IsWaiting}" Padding="10,3" ToolTip.Tip="{DynamicResource Tip.Dl.StopWaiting}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StopWaitingCommand}" CommandParameter="{Binding}" />
                        <Button Content="{DynamicResource Dl.Retry}" IsVisible="{Binding IsFailed}" Padding="10,3" ToolTip.Tip="{DynamicResource Tip.Dl.Retry}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RetryDownloadCommand}" CommandParameter="{Binding}" />
                        <Button Classes="flat" ToolTip.Tip="{DynamicResource Tip.Ws.OpenPage}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDownloadPageCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE8A7;" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Disk cleanup -->
        <Grid Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsWsCleanup}">
          <TextBlock Text="{DynamicResource Clean.Hint}" Classes="muted" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10" IsVisible="{Binding HasCleanupRows}">
            <TextBlock Text="{Binding CleanupSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource Clean.SelectAll}" Command="{Binding CleanupSelectCommand}" CommandParameter="all"
                      ToolTip.Tip="{DynamicResource Tip.Clean.SelectAll}" />
              <Button Content="{DynamicResource Clean.SelectNone}" Command="{Binding CleanupSelectCommand}" CommandParameter="none" />
              <Button Classes="accent danger" Command="{Binding CleanupUnsubscribeCommand}" IsEnabled="{Binding CanCleanup}"
                      ToolTip.Tip="{DynamicResource Tip.Clean.Unsubscribe}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE74D;" />
                  <TextBlock Text="{DynamicResource Clean.Unsubscribe}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="{DynamicResource Clean.Empty}" Classes="ok" IsVisible="{Binding !HasCleanupRows}" Margin="0,10" TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="2" IsVisible="{Binding HasCleanupRows}">
            <ItemsControl ItemsSource="{Binding CleanupRows}" MaxWidth="1000" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupRowViewModel">
                  <Border Classes="panel" Padding="12,6" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,120,Auto">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UpdatedText}" Classes="faint" FontSize="11.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                      <Button Grid.Column="3" Classes="flat" ToolTip.Tip="{DynamicResource Tip.Ws.ShowInList}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CleanupShowCommand}" CommandParameter="{Binding}">
                        <TextBlock Classes="icon" Text="&#xE8FD;" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Translations for the modpack's mods -->
        <Grid Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsWsTranslations}">
          <StackPanel Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Trn.Hint}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{DynamicResource Trn.Language}" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding TrLanguages}" SelectedItem="{Binding TrLanguage}" MinWidth="180"
                        ToolTip.Tip="{DynamicResource Tip.Trn.Language}" />
              <Button Classes="accent" Command="{Binding FindTranslationsCommand}" Padding="14,5" ToolTip.Tip="{DynamicResource Tip.Trn.Find}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE721;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Trn.Find}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ProgressBar IsIndeterminate="True" Width="60" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsTrSearching}" />
              <TextBlock Text="{Binding TrStatus}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
            <Border Classes="panel" Padding="10,6" BorderBrush="{StaticResource WarnBrush}" IsVisible="{Binding HasTrGameNote}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon warn" Text="&#xE7BA;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TrGameNote}" TextWrapping="Wrap" MaxWidth="900" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,8" IsVisible="{Binding TrSearched}" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{Binding TrSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" IsVisible="{Binding HasTrRows}">
              <Button Content="{DynamicResource Clean.SelectAll}" Command="{Binding TrSelectCommand}" CommandParameter="all" />
              <Button Content="{DynamicResource Clean.SelectNone}" Command="{Binding TrSelectCommand}" CommandParameter="none" />
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="10" Margin="0,0,14,0">
              <TextBlock Text="{DynamicResource Trn.NothingFound}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding TrNothingFound}" />
              <ItemsControl ItemsSource="{Binding TrRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TranslationRowViewModel">
                    <Border Classes="panel" Padding="12,7" Margin="0,0,0,5">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
                        <Border Grid.Column="1" Width="64" Height="36" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgBrush}" VerticalAlignment="Center">
                          <Panel>
                            <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                            <TextBlock Classes="trGlyph" Text="文A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="10,0,6,0" Spacing="2" VerticalAlignment="Center">
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0" BorderBrush="{StaticResource OkBrush}"
                                    IsVisible="{Binding Installed, Converter={x:Static ObjectConverters.IsNotNull}}">
                              <TextBlock Text="{DynamicResource Trn.Badge.Installed}" Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding IsPack}">
                              <TextBlock Text="{Binding PackText}" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0" BorderBrush="{StaticResource WarnBrush}" IsVisible="{Binding IsOld}"
                                    ToolTip.Tip="{DynamicResource Tip.Trn.Old}">
                              <TextBlock Text="{DynamicResource Trn.Badge.Old}" Foreground="{StaticResource WarnBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0" BorderBrush="{StaticResource WarnBrush}" IsVisible="{Binding HasReplaces}">
                              <TextBlock Text="{DynamicResource Trn.Badge.Fresher}" Foreground="{StaticResource WarnBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                          <TextBlock Text="{Binding ForText}" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ReplacesText}" Classes="faint" FontSize="11.5" IsVisible="{Binding HasReplaces}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Details}" Classes="faint" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="flat" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Tip.Ws.OpenPage}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenTrPageCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="icon" Text="&#xE8A7;" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander IsVisible="{Binding HasTrNotFound}" HorizontalAlignment="Stretch" ToolTip.Tip="{DynamicResource Tip.Trn.NotFound}">
                <Expander.Header>
                  <TextBlock Text="{Binding TrNotFoundTitle}" FontWeight="SemiBold" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding TrNotFound}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="tag" Padding="8,2" Margin="0,0,6,6">
                        <TextBlock Text="{Binding}" FontSize="12" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" IsVisible="{Binding HasTrRows}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="accent" Padding="16,7" Command="{Binding ApplyTranslationsCommand}" IsEnabled="{Binding CanApplyTranslations}"
                      ToolTip.Tip="{DynamicResource Tip.Trn.Apply}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TrApplyText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="{DynamicResource Trn.ApplyHint}" Classes="faint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Mods page: the two lists and the details, with splitters between them (the widths are remembered) -->
      <Grid x:Name="ModsGrid" Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding IsModsPage}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="330" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" MinWidth="380" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="380" MinWidth="280" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <!-- Available mods -->
        <Border Grid.Column="0" Classes="panel" Margin="10,10,0,10">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,10,12,6"
                        ToolTip.Tip="{DynamicResource Tip.List.Available}" Background="Transparent">
              <TextBlock Classes="h2" Text="{DynamicResource List.Available}" />
              <TextBlock Classes="muted" Text="{Binding AvailableView.Count}" VerticalAlignment="Center" />
              <TextBlock Classes="faint" FontSize="11" Text="{Binding AnalysisText}" VerticalAlignment="Center"
                         IsVisible="{Binding AnalysisText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{DynamicResource Tip.Analysis}" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="10,0,10,8">
              <TextBox Text="{Binding AvailableSearch}" Watermark="{DynamicResource Search.Placeholder}" MinWidth="80"
                       ToolTip.Tip="{DynamicResource Tip.Search}">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="icon faint" Text="&#xE721;" Margin="8,0,0,0" FontSize="12" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding SourceFilter}" Margin="6,0,0,0" MinWidth="104"
                        ToolTip.Tip="{DynamicResource Tip.Filter}">
                <ComboBoxItem Content="{DynamicResource Filter.All}" />
                <ComboBoxItem Content="{DynamicResource Filter.Workshop}" />
                <ComboBoxItem Content="{DynamicResource Filter.Local}" />
                <ComboBoxItem Content="{DynamicResource Filter.Official}" />
              </ComboBox>
              <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,4" ToolTip.Tip="{DynamicResource Tip.Filters}"
                      Classes.accentBorder="{Binding HasActiveFilters}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE71C;" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding FilterButtonText}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FiltersPanel}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <ListBox Grid.Row="2" x:Name="AvailableList" ItemsSource="{Binding AvailableView}"
                     SelectedItem="{Binding SelectedAvailable}" SelectionMode="Multiple"
                     ItemTemplate="{StaticResource ModRow}" DragDrop.AllowDrop="True" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,6" Spacing="6" HorizontalAlignment="Right">
              <Button Classes="flat" Command="{Binding EnableAllShownCommand}" ToolTip.Tip="{DynamicResource Tip.EnableAll}">
                <TextBlock Classes="icon" Text="&#xE76C;" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <GridSplitter x:Name="ModsSplitLeft" Grid.Column="1" Classes="panelSplit" ResizeDirection="Columns" />

        <!-- Active mods (load order) -->
        <Border Grid.Column="2" Classes="panel" Margin="0,10,0,10">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="12,6,10,4">
              <!-- Left-aligned with a star column: the title sits next to its count and shortens when the panel is narrow -->
              <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,4,0"
                    ToolTip.Tip="{DynamicResource Tip.List.Active}" Background="Transparent">
                <TextBlock Classes="h2" Text="{DynamicResource List.Active}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ActiveView.Count}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Padding="8,4" Command="{Binding OpenTranslationsCommand}" IsVisible="{Binding HasUntranslated}"
                      ToolTip.Tip="{Binding UntranslatedText}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="trGlyph" Text="文A" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding UntranslatedCount}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="SortButton" ToolTip.Tip="{DynamicResource Tip.Sort}" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE8CB;" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{DynamicResource Sort.Button}" />
                  <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="4" Width="380">
                      <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8"
                              Command="{Binding SortCommand}" CommandParameter="quick">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="icon" Text="&#xE8CB;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{DynamicResource Sort.Quick}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Sort.QuickHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8"
                              Command="{Binding SortCommand}" CommandParameter="full">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="icon" Text="&#xE8FD;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{DynamicResource Sort.Full}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Sort.FullHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,0,10,8">
              <TextBox Text="{Binding ActiveSearch}"
                       Watermark="{DynamicResource Search.Placeholder}" ToolTip.Tip="{DynamicResource Tip.Search}">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="icon faint" Text="&#xE721;" Margin="8,0,0,0" FontSize="12" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4" ToolTip.Tip="{DynamicResource Tip.Filters}"
                      Classes.accentBorder="{Binding HasActiveFilters}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE71C;" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding FilterButtonText}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FiltersPanel}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <ListBox Grid.Row="2" x:Name="ActiveList" ItemsSource="{Binding ActiveView}"
                     SelectedItem="{Binding SelectedActive}" SelectionMode="Multiple"
                     ItemTemplate="{StaticResource ModRow}" DragDrop.AllowDrop="True">
              <ListBox.ContextMenu>
                <ContextMenu x:Name="ActiveMenu">
                  <MenuItem Header="{DynamicResource Menu.LoadAfter}" Command="{Binding StartOrderRuleCommand}" CommandParameter="after"
                            ToolTip.Tip="{DynamicResource Tip.Menu.LoadAfter}" />
                  <MenuItem Header="{DynamicResource Menu.LoadBefore}" Command="{Binding StartOrderRuleCommand}" CommandParameter="before"
                            ToolTip.Tip="{DynamicResource Tip.Menu.LoadBefore}" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Menu.PinTop}" Command="{Binding PinCommand}" CommandParameter="top"
                            ToggleType="CheckBox" IsChecked="{Binding MenuTargetPinnedTop, Mode=OneWay}" ToolTip.Tip="{DynamicResource Tip.Menu.PinTop}" />
                  <MenuItem Header="{DynamicResource Menu.PinBottom}" Command="{Binding PinCommand}" CommandParameter="bottom"
                            ToggleType="CheckBox" IsChecked="{Binding MenuTargetPinnedBottom, Mode=OneWay}" ToolTip.Tip="{DynamicResource Tip.Menu.PinBottom}" />
                  <MenuItem Header="{DynamicResource Menu.Unpin}" Command="{Binding PinCommand}" CommandParameter="none"
                            IsVisible="{Binding MenuTargetPinned}" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Menu.OpenFolder}" Command="{Binding OpenSelectedFolderCommand}" />
                  <MenuItem Header="{DynamicResource Menu.OpenWorkshop}" Command="{Binding OpenSelectedWorkshopCommand}"
                            IsVisible="{Binding SelectedHasWorkshop}" />
                  <MenuItem Header="{DynamicResource Btn.Disable}" Command="{Binding ToggleSelectedCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="10,6">
              <Button Classes="flat" Command="{Binding DisableAllShownCommand}" ToolTip.Tip="{DynamicResource Tip.DisableAll}">
                <TextBlock Classes="icon" Text="&#xE76B;" />
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Classes="flat" Command="{Binding MoveSelectedCommand}" CommandParameter="top" ToolTip.Tip="{DynamicResource Tip.MoveTop}">
                  <TextBlock Classes="icon" Text="&#xE74A;" />
                </Button>
                <Button Classes="flat" Command="{Binding MoveSelectedCommand}" CommandParameter="up" ToolTip.Tip="{DynamicResource Tip.MoveUp}">
                  <TextBlock Classes="icon" Text="&#xE70E;" />
                </Button>
                <Button Classes="flat" Command="{Binding MoveSelectedCommand}" CommandParameter="down" ToolTip.Tip="{DynamicResource Tip.MoveDown}">
                  <TextBlock Classes="icon" Text="&#xE70D;" />
                </Button>
                <Button Classes="flat" Command="{Binding MoveSelectedCommand}" CommandParameter="bottom" ToolTip.Tip="{DynamicResource Tip.MoveBottom}">
                  <TextBlock Classes="icon" Text="&#xE74B;" />
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <GridSplitter x:Name="ModsSplitRight" Grid.Column="3" Classes="panelSplit" ResizeDirection="Columns" />

        <!-- Details -->
        <Border Grid.Column="4" Classes="panel" Margin="0,10,10,10">
          <Panel>
            <TextBlock Text="{DynamicResource Details.Empty}" Classes="muted" TextWrapping="Wrap"
                       TextAlignment="Center" VerticalAlignment="Center" Margin="30"
                       IsVisible="{Binding !HasSelection}" />
            <ScrollViewer IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="12" Margin="14">
                <Panel>
                  <Border CornerRadius="3" ClipToBounds="True" MaxHeight="210" IsVisible="{Binding !ModGallery.HasMany}">
                    <Image Source="{Binding SelectedPreview}" Stretch="UniformToFill"
                           IsVisible="{Binding SelectedPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Border>
                  <Border CornerRadius="3" ClipToBounds="True" IsVisible="{Binding ModGallery.HasMany}">
                    <ContentControl Content="{Binding ModGallery}" ContentTemplate="{StaticResource GalleryView}" />
                  </Border>
                </Panel>

                <StackPanel Spacing="2">
                  <SelectableTextBlock Classes="h1" Text="{Binding SelectedMod.Name, FallbackValue=''}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding SelectedMod.AuthorText, FallbackValue=''}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Border Classes="badge" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" IsVisible="{Binding SelectedIsNew}"
                            ToolTip.Tip="{DynamicResource Tip.Row.New}">
                      <TextBlock Text="{DynamicResource Badge.New}" Foreground="{StaticResource AccentTextBrush}" />
                    </Border>
                    <Border Classes="badge" BorderBrush="{StaticResource OkBrush}" IsVisible="{Binding SelectedIsUpdated}"
                            ToolTip.Tip="{DynamicResource Tip.Row.Updated}">
                      <TextBlock Text="{DynamicResource Badge.Updated}" Foreground="{StaticResource OkBrush}" />
                    </Border>
                  </StackPanel>
                </StackPanel>

                <WrapPanel>
                  <Button Command="{Binding ToggleSelectedCommand}" IsEnabled="{Binding CanToggleSelected}"
                          Content="{Binding ToggleText}" ToolTip.Tip="{DynamicResource Tip.Toggle}" Margin="0,0,6,6" />
                  <Button Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanEditSelected}" ToolTip.Tip="{DynamicResource Tip.Favorite}" Margin="0,0,6,6">
                    <Panel>
                      <TextBlock Classes="icon" Text="&#xE734;" IsVisible="{Binding !SelectedIsFavorite}" />
                      <TextBlock Classes="icon" Text="&#xE735;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding SelectedIsFavorite}" />
                    </Panel>
                  </Button>
                  <Button Command="{Binding OpenSelectedFolderCommand}" ToolTip.Tip="{DynamicResource Tip.OpenFolder}" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="icon" Text="&#xE8B7;" />
                      <TextBlock Text="{DynamicResource Btn.OpenFolder}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenSelectedWorkshopCommand}" IsVisible="{Binding SelectedHasWorkshop}"
                          ToolTip.Tip="{DynamicResource Tip.OpenWorkshop}" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="icon" Text="&#xE8A7;" />
                      <TextBlock Text="{DynamicResource Btn.OpenWorkshop}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>

                <!-- Problems of this mod -->
                <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="10" IsVisible="{Binding SelectedHasIssues}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h2 warn" Text="{DynamicResource Details.Issues}" />
                    <ItemsControl ItemsSource="{Binding SelectedIssues}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                       Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}" />
                            <Button Grid.Column="1" Content="{Binding FixText}" IsVisible="{Binding CanFix}"
                                    Command="{Binding FixCommand}" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                    ToolTip.Tip="{DynamicResource Tip.Fix}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- What is inside, categories, own note -->
                <StackPanel Spacing="4" IsVisible="{Binding CanEditSelected}">
                  <TextBlock Classes="h2" Text="{DynamicResource Details.Inside}" ToolTip.Tip="{DynamicResource Tip.Details.Inside}" />
                  <TextBlock Text="{Binding SelectedContentText}" TextWrapping="Wrap" IsVisible="{Binding HasSelectedContent}" />
                  <TextBlock Text="{DynamicResource Details.InsideUnknown}" Classes="faint" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedContent}" />
                  <TextBlock Classes="faint" FontSize="12" IsVisible="{Binding SelectedSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Run Text="{DynamicResource Details.Size}" /><Run Text=" " /><Run Text="{Binding SelectedSizeText}" />
                  </TextBlock>
                  <WrapPanel Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding SelectedCategories}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryTag">
                          <Border Classes="tag" Classes.manual="{Binding IsManual}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                              <Button Classes="flat" Padding="2,0" ToolTip.Tip="{DynamicResource Tip.Cat.Remove}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveCategoryCommand}" CommandParameter="{Binding}">
                                <TextBlock Classes="icon" Text="&#xE711;" FontSize="9" />
                              </Button>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Padding="8,1" Margin="0,0,6,6" ToolTip.Tip="{DynamicResource Tip.Cat.Edit}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="icon" Text="&#xE70F;" FontSize="11" />
                        <TextBlock Text="{DynamicResource Cat.Edit}" FontSize="12" />
                      </StackPanel>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Spacing="8" Width="380">
                            <TextBlock Text="{DynamicResource Cat.EditHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding CategoryEditChips}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterChipViewModel">
                                  <ToggleButton Classes="chip" IsChecked="{Binding IsChecked}" Content="{Binding Name}" ToolTip.Tip="{Binding Tip}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </WrapPanel>
                  <TextBox Text="{Binding SelectedNote}" Watermark="{DynamicResource Details.NoteHint}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="36" MaxHeight="140" ToolTip.Tip="{DynamicResource Tip.Details.Note}" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <TextBlock Classes="muted" Text="{DynamicResource Details.Versions}" Margin="0,0,12,4" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersions}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource Details.PackageId}" Margin="0,0,12,0" />
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMod.Id, FallbackValue=''}"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>

                <StackPanel Spacing="4" IsVisible="{Binding SelectedHasDependencies}">
                  <TextBlock Classes="h2" Text="{DynamicResource Details.Requires}" />
                  <ItemsControl ItemsSource="{Binding SelectedDependencies}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DependencyRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="8,0,0,0"
                                     Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Why is this mod here? -->
                <StackPanel Spacing="4" IsVisible="{Binding HasPlacement}">
                  <TextBlock Classes="h2" Text="{DynamicResource Why.Title}" ToolTip.Tip="{DynamicResource Tip.Why}" />
                  <TextBlock Text="{Binding PlacementNote}" Classes="muted" TextWrapping="Wrap"
                             IsVisible="{Binding PlacementNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Spacing="2" IsVisible="{Binding HasPlacementAbove}" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource Why.Above}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding PlacementAbove}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlacementRow">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <TextBlock Classes="icon" Text="&#xE70E;" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="300" Foreground="{StaticResource TextMutedBrush}" />
                            <Button Classes="flat" Padding="2" IsVisible="{Binding CanRemove}" ToolTip.Tip="{DynamicResource Tip.RemoveRule}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveUserRuleCommand}"
                                    CommandParameter="{Binding Rule}">
                              <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
                            </Button>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="2" IsVisible="{Binding HasPlacementBelow}" Margin="0,4,0,0">
                    <TextBlock Text="{DynamicResource Why.Below}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding PlacementBelow}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlacementRow">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="300" Foreground="{StaticResource TextMutedBrush}" />
                            <Button Classes="flat" Padding="2" IsVisible="{Binding CanRemove}" ToolTip.Tip="{DynamicResource Tip.RemoveRule}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveUserRuleCommand}"
                                    CommandParameter="{Binding Rule}">
                              <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
                            </Button>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding SelectedHasDescription}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{DynamicResource Details.Description}" VerticalAlignment="Center" />
                    <Panel Grid.Column="1">
                      <Button Padding="8,2" IsVisible="{Binding SelectedCanTranslate}" ToolTip.Tip="{DynamicResource Tip.Tr.Translate}"
                              Command="{Binding ToggleSelectedTranslationCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="文A" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="{DynamicResource Tr.Translate}" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <TextBlock Text="{DynamicResource Tr.Working}" Classes="muted" FontSize="12" IsVisible="{Binding IsTranslatingSelected}"
                                 VerticalAlignment="Center" />
                    </Panel>
                  </Grid>
                  <WrapPanel IsVisible="{Binding SelectedIsTranslated}" ItemSpacing="8">
                    <TextBlock Text="文A" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedTranslationText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <Button Classes="flat" Padding="4,0" Content="{Binding SelectedTranslationToggleText}" FontSize="12"
                            Foreground="{StaticResource AccentBrush}" Command="{Binding ToggleSelectedTranslationCommand}"
                            ToolTip.Tip="{DynamicResource Tip.Tr.Toggle}" />
                  </WrapPanel>
                  <SelectableTextBlock Text="{Binding SelectedDisplayDescription}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" LineHeight="19" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>
      </Grid>

      <!-- Loading overlay -->
      <Border Grid.ColumnSpan="4" Background="#CC15171A" IsVisible="{Binding IsLoading}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="{DynamicResource Loading}" Classes="h2" HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="260" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </Border>

      <!-- Game not found -->
      <Border Grid.ColumnSpan="4" Background="{StaticResource BgBrush}" IsVisible="{Binding NeedsGameDir}">
        <Border Classes="panel" Padding="28" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock Classes="icon" Text="&#xE7BA;" FontSize="32" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Msg.GameNotFound}" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Classes="accent" HorizontalAlignment="Center" Content="{DynamicResource Btn.PickGameDir}"
                    Click="OnPickGameDir" />
          </StackPanel>
        </Border>
      </Border>

      <!-- Mods are downloading: a coloured strip right under the top bar, over every page -->
      <ProgressBar Grid.ColumnSpan="4" Classes="download" Classes.stalled="{Binding DownloadsStalled}" VerticalAlignment="Top"
                   Height="3" MinHeight="3" Maximum="1" Value="{Binding DownloadsProgress}" IsIndeterminate="{Binding DownloadsIndeterminate}"
                   IsVisible="{Binding HasRunningDownloads}" IsHitTestVisible="False" />

      <!-- Toast message -->
      <Border Grid.ColumnSpan="4" Classes="panel" Background="{StaticResource PanelRaisedBrush}"
              BorderBrush="{StaticResource AccentBrush}" Padding="14,10" Margin="0,0,0,18"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="640"
              IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520" />
            <Button Classes="accent" Padding="10,3" Command="{Binding RunMessageActionCommand}" Content="{Binding MessageActionText}"
                    IsVisible="{Binding MessageActionText, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Classes="flat" Command="{Binding DismissMessageCommand}" Margin="10,0,0,0">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ═════════════ Footer ═════════════ -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Classes="faint" FontSize="12" Text="{Binding FooterCounts}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="faint" FontSize="12" Text="{Binding FooterGame}" Margin="20,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="flat" Padding="4,0" HorizontalAlignment="Left" Command="{Binding RefreshCommunityRulesCommand}"
                ToolTip.Tip="{DynamicResource Tip.Community}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="faint" FontSize="12" Text="{Binding CommunityStatus}" />
            <TextBlock Classes="faint" FontSize="12" Text="{Binding DatabasesStatus}" ToolTip.Tip="{DynamicResource Tip.Db}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="flat" Padding="8,0" Margin="0,0,16,0" Command="{Binding ShowDownloadsCommand}"
                IsVisible="{Binding HasRunningDownloads}" ToolTip.Tip="{DynamicResource Tip.Dl.Footer}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="pulse" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource DownloadBrush}" IsVisible="{Binding !DownloadsStalled}" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource WarnBrush}" IsVisible="{Binding DownloadsStalled}" />
            <TextBlock FontSize="12" Text="{Binding DownloadsFooterText}" VerticalAlignment="Center" Foreground="{StaticResource DownloadBrush}"
                       IsVisible="{Binding !DownloadsStalled}" />
            <TextBlock FontSize="12" Text="{Binding DownloadsFooterText}" VerticalAlignment="Center" Classes="warn" IsVisible="{Binding DownloadsStalled}" />
          </StackPanel>
        </Button>
        <Panel Grid.Column="4" VerticalAlignment="Center">
          <TextBlock FontSize="12" Classes="warn" Text="{DynamicResource Footer.Unsaved}" IsVisible="{Binding IsDirty}" />
          <TextBlock FontSize="12" Foreground="{StaticResource DownloadBrush}" Text="{Binding UpdateStatus}" Background="{StaticResource PanelBrush}"
                     IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock FontSize="12" Classes="faint" Text="{DynamicResource Footer.Saved}" IsVisible="{Binding !IsDirty}" />
        </Panel>
      </Grid>
    </Border>

    <!-- ═════════════ A picture full screen ═════════════ -->
    <Border x:Name="GalleryOverlay" Grid.RowSpan="3" Background="#F0080909" IsVisible="{Binding FullGallery, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid DataContext="{Binding FullGallery}" x:DataType="vm:GalleryViewModel">
        <Button Classes="clickArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseGalleryFullCommand}" />
        <Image Source="{Binding Full}" Stretch="Uniform" Margin="80,50" IsHitTestVisible="False" />
        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" Background="Transparent"
                     Foreground="{StaticResource AccentBrush}" />
        <Button Classes="flat galleryArrow big" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16" IsVisible="{Binding HasMany}"
                Command="{Binding PrevCommand}" ToolTip.Tip="{DynamicResource Tip.Gallery.Prev}">
          <TextBlock Classes="icon" Text="&#xE76B;" FontSize="26" />
        </Button>
        <Button Classes="flat galleryArrow big" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16" IsVisible="{Binding HasMany}"
                Command="{Binding NextCommand}" ToolTip.Tip="{DynamicResource Tip.Gallery.Next}">
          <TextBlock Classes="icon" Text="&#xE76C;" FontSize="26" />
        </Button>
        <Button Classes="flat galleryArrow" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" ToolTip.Tip="{DynamicResource Btn.Close}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseGalleryFullCommand}">
          <TextBlock Classes="icon" Text="&#xE711;" FontSize="16" />
        </Button>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding Counter}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
          <Button Classes="accent" Padding="12,4" IsVisible="{Binding CurrentIsVideo}" Content="{DynamicResource Gallery.WatchVideo}"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGalleryVideoCommand}" CommandParameter="{Binding}" />
          <TextBlock Text="{DynamicResource Gallery.Keys}" Classes="faint" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Startup time by mod ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsLoadTimeOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="680" MaxHeight="720"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="icon" Text="&#xE916;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="h1" Text="{DynamicResource Lt.Title}" />
              <TextBlock Classes="h1" Text="{Binding LoadTimeText}" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseLoadTimeCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Classes="muted" Text="{Binding LoadTimeSourceText}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <!-- The next step towards exact figures -->
          <Border Grid.Row="2" Classes="panel" Padding="12,10" Margin="0,12,0,0"
                  IsVisible="{Binding LoadTimeActionHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LoadTimeActionHint}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="accent" Margin="12,0,0,0" Padding="12,5" IsVisible="{Binding HasLoadTimeAction}"
                      Content="{Binding LoadTimeAction}" Command="{Binding LoadTimeStepCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,6">
            <TextBlock Text="{DynamicResource Lt.Mods}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Classes="faint" FontSize="12" Text="{Binding LoadTimeBaseText}" />
          </Grid>
          <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding LoadTimeRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LoadTimeRow">
                  <Grid ColumnDefinitions="220,*,64" Margin="0,3,16,3" ToolTip.Tip="{Binding Tip}" Background="Transparent">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Share}" Height="6" MinWidth="0" Margin="10,0"
                                 VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Classes.guess="{Binding !Measured}" />
                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"
                               Classes.muted="{Binding !Measured}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Modpack from a save ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsImportOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="680" MaxHeight="640"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="{DynamicResource Import.Title}" />
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseImportCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource Import.Hint}" TextWrapping="Wrap" Margin="0,6,0,14" />
          <Panel Grid.Row="2">
            <TextBlock Text="{DynamicResource Import.Empty}" Classes="muted" IsVisible="{Binding ImportIsEmpty}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding ImportSources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImportSourceViewModel">
                    <Border Classes="panel" Background="{StaticResource PanelBrush}" Padding="12,10" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="22" Margin="0,0,12,0" VerticalAlignment="Center">
                          <TextBlock Classes="icon" Text="&#xE74E;" IsVisible="{Binding IsSave}" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Classes="icon" Text="&#xE8FD;" IsVisible="{Binding !IsSave}" Foreground="{StaticResource TextMutedBrush}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{DynamicResource Import.Loading}" Classes="faint" FontSize="12" IsVisible="{Binding !IsReady}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsReady}">
                            <TextBlock Text="{Binding InfoText}" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding MissingText}" FontSize="12" Classes.error="{Binding HasMissing}" Classes.ok="{Binding !HasMissing}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="{DynamicResource Import.Create}" IsEnabled="{Binding IsReady}"
                                VerticalAlignment="Center" Margin="12,0,0,0" ToolTip.Tip="{DynamicResource Tip.Import.Create}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportFromCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Share a modpack (save to a .rimforge file) ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsShareOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="600"
              Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="{Binding ShareTitle}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseShareCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <TextBlock Text="{DynamicResource Share.Intro}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Share.Description}" FontWeight="SemiBold" />
            <TextBox Text="{Binding ShareDescription}" Watermark="{DynamicResource Share.DescriptionHint}" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="70" IsEnabled="{Binding CanShareSave}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding ShareIncludeSettings}" IsEnabled="{Binding ShareHasSettings}" ToolTip.Tip="{DynamicResource Tip.Share.Settings}">
            <TextBlock Text="{Binding ShareSettingsText}" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox IsChecked="{Binding ShareIncludeMods}" ToolTip.Tip="{DynamicResource Tip.Share.Mods}">
            <TextBlock Text="{Binding ShareModsText}" TextWrapping="Wrap" />
          </CheckBox>
          <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="10" IsVisible="{Binding ShareIncludeMods}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon warn" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Text="{DynamicResource Share.ModsWarning}" TextWrapping="Wrap" MaxWidth="510" FontSize="12" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShareHasLocal}">
            <TextBlock Classes="icon" Text="&#xE946;" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ShareLocalText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
          </StackPanel>
          <ProgressBar Value="{Binding ShareProgress}" Maximum="1" Height="6" MinWidth="0" IsVisible="{Binding IsSharing}"
                       Foreground="{StaticResource AccentBrush}" />
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Text="{Binding ShareSizeText}" Classes="faint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="{DynamicResource Dialog.Cancel}" Command="{Binding CloseShareCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Classes="accent" Command="{Binding ShareSaveCommand}" IsEnabled="{Binding CanShareSave}" Margin="8,0,0,0"
                    ToolTip.Tip="{DynamicResource Tip.Share.Save}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="&#xE74E;" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock Text="{DynamicResource Share.Save}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- ═════════════ Open a modpack file: summary ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsPackOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="620" MaxHeight="680"
              Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="h1" Text="{Binding PackTitle}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
              </StackPanel>
              <Button Grid.Column="1" Classes="flat" Command="{Binding ClosePackCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
                <TextBlock Classes="icon" Text="&#xE711;" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding PackInfo}" Classes="faint" FontSize="12" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding PackDescription}" TextWrapping="Wrap" IsVisible="{Binding PackDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="12,10">
                <StackPanel Spacing="7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon ok" Text="&#xE73E;" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PackHaveText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasDownload}">
                    <TextBlock Classes="icon" Text="&#xE896;" Foreground="{StaticResource WorkshopBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PackDownloadText}" />
                    <TextBlock Text="{DynamicResource Pack.Checking}" Classes="faint" FontSize="12" IsVisible="{Binding IsPackChecking}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasFromFile}">
                    <TextBlock Classes="icon" Text="&#xE8B7;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PackFromFileText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasUnavailable}">
                    <TextBlock Classes="icon error" Text="&#xE783;" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PackUnavailableText}" TextWrapping="Wrap" MaxWidth="520" Classes="error" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasRemoved}">
                    <TextBlock Classes="icon error" Text="&#xE783;" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PackRemovedText}" TextWrapping="Wrap" MaxWidth="520" Classes="error" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasMissingDlc}">
                <TextBlock Classes="icon warn" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding PackDlcText}" TextWrapping="Wrap" MaxWidth="540" Classes="warn" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasVersionWarning}">
                <TextBlock Classes="icon warn" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding PackVersionText}" TextWrapping="Wrap" MaxWidth="540" Classes="warn" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackHasUpdated}">
                <TextBlock Classes="icon" Text="&#xE823;" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding PackUpdatedText}" TextWrapping="Wrap" MaxWidth="540" Classes="muted" FontSize="12" />
              </StackPanel>
              <CheckBox IsChecked="{Binding PackApplySettings}" IsVisible="{Binding PackHasSettings}" ToolTip.Tip="{DynamicResource Tip.Pack.Settings}">
                <TextBlock Text="{Binding PackSettingsText}" TextWrapping="Wrap" />
              </CheckBox>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
            <ProgressBar Value="{Binding PackProgress}" Maximum="1" Height="6" MinWidth="0" IsVisible="{Binding IsPackBusy}"
                         Foreground="{StaticResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding ClosePackCommand}" IsEnabled="{Binding CanCreateFromPack}" />
              <Button Classes="accent" Command="{Binding CreateFromPackCommand}" IsEnabled="{Binding CanCreateFromPack}"
                      ToolTip.Tip="{DynamicResource Tip.Pack.Create}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE710;" Foreground="{StaticResource AccentTextBrush}" />
                  <TextBlock Text="{Binding PackCreateText}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Download another version of the game (SteamCMD) ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsGameDlOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="640" MaxHeight="720"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="icon" Text="&#xE896;" FontSize="20" Foreground="{StaticResource DownloadBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="h1" Text="{DynamicResource GameDl.Title}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseGameDownloadCommand}" ToolTip.Tip="{DynamicResource Tip.GameDl.Hide}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource GameDl.Hint}" TextWrapping="Wrap" Margin="0,6,0,12" />

          <!-- Getting SteamCMD / the list -->
          <StackPanel Grid.Row="2" Spacing="10" IsVisible="{Binding IsGameDlSetup}">
            <TextBlock Text="{Binding GameDlStatus}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="6" MinWidth="0" Foreground="{StaticResource DownloadBrush}" />
          </StackPanel>

          <!-- Something went wrong -->
          <StackPanel Grid.Row="2" Spacing="10" IsVisible="{Binding IsGameDlError}">
            <TextBlock Text="{Binding GameDlStatus}" TextWrapping="Wrap" Classes="error" />
            <Button Content="{DynamicResource GameDl.Retry}" Command="{Binding RetryGameDownloadCommand}" />
          </StackPanel>

          <!-- Pick a branch -->
          <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding IsGameDlPick}">
            <ScrollViewer MaxHeight="420">
              <ItemsControl ItemsSource="{Binding GameBranches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameBranchViewModel">
                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,0,12,2"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PickGameBranchCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="22,*">
                        <TextBlock Classes="icon" Text="&#xE73E;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsSelected}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding !IsSelected}" />
                            <Border IsVisible="{Binding IsTesting}" Background="{StaticResource DownloadTintBrush}" Padding="6,1" CornerRadius="3" VerticalAlignment="Center">
                              <TextBlock Text="{DynamicResource GameDl.TestingBadge}" FontSize="10.5" Foreground="{StaticResource DownloadBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Details}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource GameDl.Account}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding SteamAccount}" Watermark="{DynamicResource GameDl.AccountHint}" ToolTip.Tip="{DynamicResource Tip.GameDl.Account}" />
              <Button Grid.Column="2" Classes="accent" Margin="10,0,0,0" Padding="14,6" Content="{DynamicResource GameDl.Start}"
                      IsEnabled="{Binding CanStartGameDl}" Command="{Binding StartGameDownloadCommand}" />
            </Grid>
          </Grid>

          <!-- Sign in to SteamCMD once -->
          <StackPanel Grid.Row="2" Spacing="12" IsVisible="{Binding IsGameDlLogin}">
            <TextBlock Text="{Binding GameDlStatus}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Padding="14,6" Content="{DynamicResource GameDl.SignIn}" Command="{Binding SignInSteamCmdCommand}" />
              <Button Content="{DynamicResource GameDl.Back}" Command="{Binding BackToGameBranchesCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Downloading -->
          <StackPanel Grid.Row="2" Spacing="10" IsVisible="{Binding IsGameDlDownloading}">
            <TextBlock Text="{Binding GameDlStatus}" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding GameDlProgress}" Maximum="1" IsIndeterminate="{Binding GameDlIndeterminate}" Height="8" MinWidth="0"
                         Foreground="{StaticResource DownloadBrush}" />
            <TextBlock Text="{DynamicResource GameDl.CanHide}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Right" Content="{DynamicResource Dialog.Cancel}" Command="{Binding CancelGameDownloadCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Library work (saving / deleting a copy of the game) ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsLibraryBusy}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="520"
              Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="icon" Text="&#xE72E;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="h1" Text="{DynamicResource Game.Working}" />
          </StackPanel>
          <TextBlock Text="{Binding LibraryStage}" Classes="muted" TextWrapping="Wrap" />
          <ProgressBar Value="{Binding LibraryProgress}" Maximum="1" Height="8" MinWidth="0" Foreground="{StaticResource AccentBrush}" />
          <Button HorizontalAlignment="Right" Content="{DynamicResource Dialog.Cancel}" Command="{Binding CancelLibraryWorkCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- ═════════════ Find the culprit mod ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsBisectOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="640"
              Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="{DynamicResource Bisect.Title}" />
            <Button Grid.Column="1" Classes="flat" Command="{Binding HideBisectCommand}" ToolTip.Tip="{DynamicResource Tip.Bisect.Hide}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>

          <!-- 1. Setup -->
          <StackPanel Spacing="12" IsVisible="{Binding IsBisectSetup}">
            <TextBlock Text="{DynamicResource Bisect.Intro}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding BisectScopeText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                       IsVisible="{Binding BisectHasScope}" />
            <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon warn" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{DynamicResource Bisect.Caution}" TextWrapping="Wrap" MaxWidth="550" />
              </StackPanel>
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource Bisect.TargetLabel}" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding BisectTargets}" SelectedIndex="{Binding BisectTargetIndex}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BisectTarget">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{DynamicResource Bisect.TargetHint}" Classes="faint" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding HideBisectCommand}" />
              <Button Classes="accent" Content="{DynamicResource Bisect.Start}" Command="{Binding StartBisectCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- 2. Rounds -->
          <StackPanel Spacing="12" IsVisible="{Binding IsBisectTesting}">
            <TextBlock Text="{Binding BisectRoundText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BisectStatusText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Command="{Binding BisectLaunchGameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE768;" Foreground="{StaticResource AccentTextBrush}" />
                  <TextBlock Text="{DynamicResource Bisect.Launch}" />
                </StackPanel>
              </Button>
              <Button Content="{DynamicResource Bisect.CheckLog}" Command="{Binding BisectCheckLogCommand}"
                      IsVisible="{Binding BisectUsesLog}" ToolTip.Tip="{DynamicResource Tip.Bisect.CheckLog}" />
            </StackPanel>
            <TextBlock Text="{Binding BisectVerdict}" Classes="warn" TextWrapping="Wrap"
                       IsVisible="{Binding BisectVerdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
              <Button Content="{DynamicResource Bisect.Back}" Command="{Binding BisectUndoCommand}" IsEnabled="{Binding BisectCanUndo}"
                      ToolTip.Tip="{DynamicResource Tip.Bisect.Back}" />
              <Button Grid.Column="2" Command="{Binding BisectAnswerCommand}" CommandParameter="no" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon ok" Text="&#xE73E;" />
                  <TextBlock Text="{DynamicResource Bisect.No}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3" Command="{Binding BisectAnswerCommand}" CommandParameter="yes">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon error" Text="&#xE7BA;" />
                  <TextBlock Text="{DynamicResource Bisect.Yes}" />
                </StackPanel>
              </Button>
            </Grid>
            <Button Classes="flat" HorizontalAlignment="Left" Command="{Binding BisectRestoreCommand}" Padding="0,4">
              <TextBlock Text="{DynamicResource Bisect.Cancel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            </Button>
          </StackPanel>

          <!-- 3. Result -->
          <StackPanel Spacing="12" IsVisible="{Binding IsBisectDone}">
            <TextBlock Text="{Binding BisectResultText}" Classes="h2" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Bisect.FoundHint}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding BisectFoundCulprit}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource Bisect.Back}" Command="{Binding BisectUndoCommand}" IsEnabled="{Binding BisectCanUndo}"
                      ToolTip.Tip="{DynamicResource Tip.Bisect.Back}" />
              <Button Content="{DynamicResource Bisect.Restore}" Command="{Binding BisectRestoreCommand}" />
              <Button Content="{DynamicResource Bisect.Open}" Command="{Binding BisectOpenCulpritCommand}" IsVisible="{Binding BisectFoundCulprit}" />
              <Button Classes="accent" Content="{DynamicResource Bisect.Disable}" Command="{Binding BisectDisableCulpritCommand}"
                      IsVisible="{Binding BisectFoundCulprit}" ToolTip.Tip="{DynamicResource Tip.Bisect.Disable}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ═════════════ Sort preview ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsSortOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="720" MaxHeight="660"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="{Binding SortTitle}" />
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseSortCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,6,0,12">
            <TextBlock Text="{Binding SortSummary}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding SortGroupsText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                       FontSize="12" IsVisible="{Binding SortHasGroups}" />
          </StackPanel>
          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
              <!-- Contradicting rules -->
              <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="12" IsVisible="{Binding SortHasConflicts}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon warn" Text="&#xE7BA;" />
                    <TextBlock Classes="h2 warn" Text="{DynamicResource Sort.ConflictsTitle}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SortConflicts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- Moves -->
              <ItemsControl ItemsSource="{Binding SortMoves}" IsVisible="{Binding SortHasMoves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SortMoveRow">
                    <Border Classes="panel" Background="{StaticResource PanelBrush}" Padding="12,8" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="22" VerticalAlignment="Center">
                          <TextBlock Classes="icon ok" Text="&#xE74A;" IsVisible="{Binding MovesUp}" />
                          <TextBlock Classes="icon warn" Text="&#xE74B;" IsVisible="{Binding !MovesUp}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2" Margin="6,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Reason}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Positions}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding CloseSortCommand}" />
            <Button Classes="accent" Content="{DynamicResource Sort.Apply}" Command="{Binding ApplySortCommand}"
                    IsVisible="{Binding SortHasMoves}" ToolTip.Tip="{DynamicResource Tip.Sort.Apply}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Fix everything ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsFixAllOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="720" MaxHeight="660"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="{DynamicResource FixAll.Title}" />
            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseFixAllCommand}" ToolTip.Tip="{DynamicResource Btn.Close}">
              <TextBlock Classes="icon" Text="&#xE711;" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding FixAllSummary}" TextWrapping="Wrap" Classes="muted" Margin="0,6,0,12" />
          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
              <ItemsControl ItemsSource="{Binding FixAllRows}" IsVisible="{Binding HasFixAllRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FixAllRow">
                    <Border Classes="panel" Background="{StaticResource PanelBrush}" Padding="12,8" Margin="0,0,0,6">
                      <CheckBox IsChecked="{Binding IsChecked}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="faint" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="panel" Background="{StaticResource BgBrush}" Padding="12" IsVisible="{Binding HasFixAllManual}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon warn" Text="&#xE7BA;" />
                    <TextBlock Classes="h2 warn" Text="{DynamicResource FixAll.ManualTitle}" />
                  </StackPanel>
                  <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource FixAll.ManualNote}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding FixAllManual}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Classes="faint" FontSize="12" Text="{DynamicResource Fix.Preview.Undo}" VerticalAlignment="Center" Margin="0,0,8,0"
                       IsVisible="{Binding HasFixAllRows}" />
            <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding CloseFixAllCommand}" />
            <Button Classes="accent" Content="{DynamicResource Fix.Apply}" Command="{Binding ApplyFixAllCommand}"
                    IsVisible="{Binding HasFixAllRows}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ "Load after / before…" picker ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding IsRulePickerOpen}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" Width="520" Height="560"
              Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Classes="h1" Text="{Binding RulePickerTitle}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Classes="faint" FontSize="12" Text="{DynamicResource Rule.PickerNote}" TextWrapping="Wrap" Margin="0,6,0,10" />
          <TextBox Grid.Row="2" x:Name="RulePickerSearchBox" Text="{Binding RulePickerSearch}" Watermark="{DynamicResource Search.Placeholder}" Margin="0,0,0,8" />
          <ListBox Grid.Row="3" ItemsSource="{Binding RulePickerItems}" SelectedItem="{Binding RulePickerSelected}"
                   ItemTemplate="{StaticResource ModRow}" Background="{StaticResource BgBrush}" />
          <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding CloseRulePickerCommand}" />
            <Button Classes="accent" Content="{DynamicResource Rule.Add}" Command="{Binding ConfirmOrderRuleCommand}"
                    IsEnabled="{Binding RulePickerSelected, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ═════════════ Questions (new name, delete?, unsaved changes) ═════════════ -->
    <Border Grid.RowSpan="3" Background="#B0101214" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="panel" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
              Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel">
        <StackPanel Spacing="14">
          <TextBlock Classes="h1" Text="{Binding Title, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Text, FallbackValue=''}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding HasText, FallbackValue=False}" />
          <ListBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}" IsVisible="{Binding HasChoices, FallbackValue=False}"
                   MaxHeight="260" Background="{StaticResource BgBrush}" />
          <TextBox x:Name="DialogInput" Text="{Binding Input}" Watermark="{Binding InputHint}"
                   IsVisible="{Binding HasInput, FallbackValue=False}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding PrimaryCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Dialog.Cancel}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondary, FallbackValue=False}" />
            <Button Classes="accent" Classes.danger="{Binding PrimaryIsDanger}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
