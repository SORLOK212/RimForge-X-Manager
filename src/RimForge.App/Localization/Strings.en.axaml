  <sys:String x:Key="Ws.Title">Steam Workshop</sys:String>
  <sys:String x:Key="Ws.Hint">Find mods and subscribe with one click — RimForge downloads them together with the mods they need and puts them in the right place in your modpack.</sys:String>
  <sys:String x:Key="Ws.Tab.Search">Search</sys:String>
  <sys:String x:Key="Ws.Tab.Themes">Selections</sys:String>
  <sys:String x:Key="Ws.Tab.Updates">Updates ({0})</sys:String>
  <sys:String x:Key="Ws.Tab.Downloads">Downloads</sys:String>
  <sys:String x:Key="Ws.Tab.DownloadsRunning">Downloads ({0})</sys:String>
  <sys:String x:Key="Ws.EnableAfter">Turn downloaded mods on in the modpack</sys:String>
  <sys:String x:Key="Ws.SearchHint">Mod name or a word, e.g. dragons, medieval, storage</sys:String>
  <sys:String x:Key="Ws.Find">Search</sys:String>
  <sys:String x:Key="Ws.Sort.Auto">Best match</sys:String>
  <sys:String x:Key="Ws.Sort.Trend">Popular this week</sys:String>
  <sys:String x:Key="Ws.Sort.Subscribers">Most subscribers</sys:String>
  <sys:String x:Key="Ws.Sort.Newest">Newest</sys:String>
  <sys:String x:Key="Ws.OnlyMyVersion">Only for {0}</sys:String>
  <sys:String x:Key="Ws.Themes.Hint">Pick a theme — RimForge gathers the best mods for it from several searches. Mods you already have are not shown.</sys:String>
  <sys:String x:Key="Ws.More">Show more</sys:String>
  <sys:String x:Key="Ws.Subscribe">Subscribe</sys:String>
  <sys:String x:Key="Ws.SubscribeLong">Subscribe and download</sys:String>
  <sys:String x:Key="Ws.EnableInPack">Turn on in modpack</sys:String>
  <sys:String x:Key="Ws.ShowInList">Show in list</sys:String>
  <sys:String x:Key="Ws.OpenPage">Steam page</sys:String>
  <sys:String x:Key="Ws.Unsubscribe">Unsubscribe</sys:String>
  <sys:String x:Key="Ws.By">by {0}</sys:String>
  <sys:String x:Key="Ws.Subscribers">{0} subscribers</sys:String>
  <sys:String x:Key="Ws.Updated">updated {0}</sys:String>
  <sys:String x:Key="Ws.NoVersions">no versions given</sys:String>
  <sys:String x:Key="Ws.WrongVersion">The author has not marked version {0} as supported. The mod may not work.</sys:String>
  <sys:String x:Key="Ws.Rating">{0}% liked</sys:String>
  <sys:String x:Key="Ws.State.Queued">Queued</sys:String>
  <sys:String x:Key="Ws.State.Downloading">Downloading {0}%</sys:String>
  <sys:String x:Key="Ws.State.Installed">Installed</sys:String>
  <sys:String x:Key="Ws.State.Active">In modpack</sys:String>
  <sys:String x:Key="Ws.State.Unsubscribed">Unsubscribed</sys:String>
  <sys:String x:Key="Ws.Header.Trend">Popular this week</sys:String>
  <sys:String x:Key="Ws.Header.Subscribers">Most subscribers</sys:String>
  <sys:String x:Key="Ws.Header.Newest">New mods</sys:String>
  <sys:String x:Key="Ws.Header.Search">Search: “{0}”</sys:String>
  <sys:String x:Key="Ws.Header.Theme">Selection “{0}”</sys:String>
  <sys:String x:Key="Ws.Found">{0} found</sys:String>
  <sys:String x:Key="Ws.Theme.Have">you already have {0} (ticked)</sys:String>
  <sys:String x:Key="Ws.NothingFound">Nothing found. Try another word (English works best) or untick “Only for version”.</sys:String>
  <sys:String x:Key="Ws.SearchFailed">Couldn't reach the Workshop: {0}</sys:String>
  <sys:String x:Key="Ws.Enabled">“{0}” is on and in its place. Don't forget to save.</sys:String>
  <sys:String x:Key="Ws.Unsub.Title">Unsubscribe from this mod?</sys:String>
  <sys:String x:Key="Ws.Unsub.Text">RimForge will unsubscribe you from “{0}” on Steam and take it out of the modpack. Steam will delete the mod's files.</sys:String>
  <sys:String x:Key="Ws.Unsub.Done">Unsubscribed from “{0}”. Steam will delete its files shortly.</sys:String>
  <sys:String x:Key="Ws.Steam.Connected">Steam connected: {0}</sys:String>
  <sys:String x:Key="Ws.Steam.NotRunning">Steam is not running. Search works through the website; subscribing needs Steam running.</sys:String>
  <sys:String x:Key="Ws.Steam.GameRunning">RimWorld is running. While the game is open RimForge can't subscribe — close the game first.</sys:String>
  <sys:String x:Key="Ws.Steam.Idle">Steam will connect when needed</sys:String>
  <sys:String x:Key="Ws.Steam.Starting">Starting Steam… Once it is open, try again.</sys:String>
  <sys:String x:Key="Ws.Steam.Offline">Steam is running, but you are not logged in (or it is in offline mode).</sys:String>
  <sys:String x:Key="Ws.Steam.Failed">Steam did not answer: {0}</sys:String>
  <sys:String x:Key="Ws.Steam.Start">Start Steam</sys:String>
  <sys:String x:Key="Ws.NeedSteam.Title">Steam is needed</sys:String>
  <sys:String x:Key="Ws.NeedSteam.Text">Steam itself downloads the mods, so it must be running with you logged in. Start Steam now? Once it is open, press the button again.</sys:String>
  <sys:String x:Key="Ws.NeedSteam.NoSteam">Steam was not found on this PC. Downloading mods without Steam (for the GOG version) will come in a later version.</sys:String>
  <sys:String x:Key="Theme.fantasy">Fantasy</sys:String>
  <sys:String x:Key="Theme.fantasy.Tip">Magic, dragons, elves and dwarves. E.g. Medieval Fantasy Themed, Fantasy Biotech.</sys:String>
  <sys:String x:Key="Theme.medieval">Medieval</sys:String>
  <sys:String x:Key="Theme.medieval.Tip">Knights, castles, swords and medieval tech — for a game without guns.</sys:String>
  <sys:String x:Key="Theme.scifi">Space &amp; sci-fi</sys:String>
  <sys:String x:Key="Theme.scifi.Tip">Ships, lasers, androids and mechs. E.g. Save Our Ship 2, Vanilla Races Expanded - Android.</sys:String>
  <sys:String x:Key="Theme.qol">Quality of life</sys:String>
  <sys:String x:Key="Theme.qol.Tip">Mods that remove chores and make the interface handier without touching balance.</sys:String>
  <sys:String x:Key="Theme.hardcore">Hardcore</sys:String>
  <sys:String x:Key="Theme.hardcore.Tip">Realism and survival: tougher fights, stricter needs.</sys:String>
  <sys:String x:Key="Theme.animals">Animals</sys:String>
  <sys:String x:Key="Theme.animals.Tip">New beasts, creatures and everything around them.</sys:String>
  <sys:String x:Key="Theme.races">Races &amp; factions</sys:String>
  <sys:String x:Key="Theme.races.Tip">New xenotypes, races, genes and factions.</sys:String>
  <sys:String x:Key="Theme.building">Building</sys:String>
  <sys:String x:Key="Theme.building.Tip">Furniture, architecture and decorations for a good-looking colony.</sys:String>
  <sys:String x:Key="Theme.weapons">Weapons</sys:String>
  <sys:String x:Key="Theme.weapons.Tip">Guns, melee weapons, turrets.</sys:String>
  <sys:String x:Key="Theme.story">Events &amp; quests</sys:String>
  <sys:String x:Key="Theme.story.Tip">New storytellers, events and quests to keep the game surprising.</sys:String>
  <sys:String x:Key="Theme.horror">Horror</sys:String>
  <sys:String x:Key="Theme.horror.Tip">Zombies, undead and all things creepy — goes well with the Anomaly expansion.</sys:String>
  <sys:String x:Key="Theme.performance">Performance</sys:String>
  <sys:String x:Key="Theme.performance.Tip">Mods that speed the game up on big colonies and modpacks. E.g. Performance Fish, RocketMan.</sys:String>
  <sys:String x:Key="Dl.Hint">Steam itself downloads the mods. When the queue is done, RimForge refreshes the mod list, turns the downloaded mods on in the modpack (if ticked) and sorts them in carefully.</sys:String>
  <sys:String x:Key="Dl.Empty">The queue is empty. Press “Subscribe” on any mod in Search or Selections.</sys:String>
  <sys:String x:Key="Dl.Clear">Clear finished</sys:String>
  <sys:String x:Key="Dl.Retry">Retry</sys:String>
  <sys:String x:Key="Dl.NeededBy">needed by “{0}”</sys:String>
  <sys:String x:Key="Dl.Queued">Queued</sys:String>
  <sys:String x:Key="Dl.Subscribing">Subscribing…</sys:String>
  <sys:String x:Key="Dl.Waiting">Waiting for Steam…</sys:String>
  <sys:String x:Key="Dl.Downloading">Downloading {0}%</sys:String>
  <sys:String x:Key="Dl.Done">Downloaded</sys:String>
  <sys:String x:Key="Dl.Updated">Updated</sys:String>
  <sys:String x:Key="Dl.Failed">Failed: {0}</sys:String>
  <sys:String x:Key="Dl.Timeout">Steam is not starting the download. Open Steam → Downloads and check for a pause or an error.</sys:String>
  <sys:String x:Key="Dl.NeedsManual">Also needs a mod without a Workshop link: {0}. Find it with search.</sys:String>
  <sys:String x:Key="Dl.NothingToDo">Everything is already downloaded or downloading.</sys:String>
  <sys:String x:Key="Dl.Started">“{0}” added to downloads</sys:String>
  <sys:String x:Key="Dl.StartedMany">Mods added to downloads: {0}</sys:String>
  <sys:String x:Key="Dl.Finished">Mods downloaded: {0}. Mod list refreshed.</sys:String>
  <sys:String x:Key="Dl.FinishedEnabled">Mods downloaded: {0}, turned on in the modpack: {1}. Don't forget to save.</sys:String>
  <sys:String x:Key="Dl.FinishedUpdates">Mods updated: {0}.</sys:String>
  <sys:String x:Key="Dl.DownloadMissing">Download missing ({0})</sys:String>
  <sys:String x:Key="Dl.WaitBeforePlay">Wait for the downloads to finish first ({0} left).</sys:String>
  <sys:String x:Key="Upd.SeenSince">Showing changes since {0}.</sys:String>
  <sys:String x:Key="Upd.Seen">Marked as seen</sys:String>
  <sys:String x:Key="Upd.Recheck">Check again</sys:String>
  <sys:String x:Key="Upd.MarkSeen">Mark all as seen</sys:String>
  <sys:String x:Key="Upd.Checking">Comparing your mods with the Workshop…</sys:String>
  <sys:String x:Key="Upd.Empty">All quiet: nothing was updated or removed since last time.</sys:String>
  <sys:String x:Key="Upd.Pending">Waiting for update</sys:String>
  <sys:String x:Key="Upd.PendingHint">These mods have a newer version in the Workshop than the one on disk. Steam usually updates them when the game starts — you can update now.</sys:String>
  <sys:String x:Key="Upd.UpdateAll">Update all</sys:String>
  <sys:String x:Key="Upd.Recent">Updated since last time</sys:String>
  <sys:String x:Key="Upd.RecentHint">If something broke after an update, one of these mods is the likely cause. Press “What's new” to read the author's notes.</sys:String>
  <sys:String x:Key="Upd.Removed">Removed from the Workshop</sys:String>
  <sys:String x:Key="Upd.RemovedHint">The author deleted or hid these mods. Your copy still works, but it will be gone if you unsubscribe or reinstall Steam. You can keep a copy of the mod's folder.</sys:String>
  <sys:String x:Key="Upd.InModpack">in modpack</sys:String>
  <sys:String x:Key="Upd.WhatsNew">What's new</sys:String>
  <sys:String x:Key="Upd.ShowInList">In list</sys:String>
  <sys:String x:Key="Upd.LoadingChangelog">Loading the author's notes…</sys:String>
  <sys:String x:Key="Upd.UpdatedAgo">updated {0}</sys:String>
  <sys:String x:Key="Upd.NewVersionAgo">new version released {0}</sys:String>
  <sys:String x:Key="Upd.RemovedText">mod page deleted or hidden</sys:String>
  <sys:String x:Key="Upd.NoChangelog">The author didn't write what changed.</sys:String>
  <sys:String x:Key="Upd.EmptyNote">(no description)</sys:String>
  <sys:String x:Key="Upd.ChangelogFailed">Couldn't load the notes: {0}</sys:String>
  <sys:String x:Key="Coll.Button">From a Steam collection</sys:String>
  <sys:String x:Key="Coll.Title">Modpack from a Steam collection</sys:String>
  <sys:String x:Key="Coll.Text">Paste a link to a Steam Workshop collection. RimForge makes a modpack of it, downloads the missing mods and puts everything in order.</sys:String>
  <sys:String x:Key="Coll.Hint">https://steamcommunity.com/sharedfiles/filedetails/?id=…</sys:String>
  <sys:String x:Key="Coll.Next">Next</sys:String>
  <sys:String x:Key="Coll.BadLink">No collection number in that link. Copy the whole address of the collection page.</sys:String>
  <sys:String x:Key="Coll.Loading">Loading the collection…</sys:String>
  <sys:String x:Key="Coll.Empty">The collection is empty or not found (maybe hidden by its author).</sys:String>
  <sys:String x:Key="Coll.Failed">Couldn't load the collection: {0}</sys:String>
  <sys:String x:Key="Coll.ConfirmTitle">Collection “{0}”</sys:String>
  <sys:String x:Key="Coll.Summary">Mods in the collection: {0}&#x0a;Already installed: {1}&#x0a;To download: {2} (about {3})</sys:String>
  <sys:String x:Key="Coll.Removed">Removed from the Workshop (skipped): {0} — {1}</sys:String>
  <sys:String x:Key="Coll.WillDownload">RimForge will create a new modpack, turn it on in the game right away and download the missing mods through Steam.</sys:String>
  <sys:String x:Key="Coll.WillCreate">All mods are already here. RimForge will create a new modpack and turn it on in the game right away.</sys:String>
  <sys:String x:Key="Coll.CreateAndDownload">Create and download</sys:String>
  <sys:String x:Key="Tip.Ws.Steam">Subscribing and downloading go through your Steam. While RimForge talks to Steam your friends see you “playing RimWorld” — it goes away after a quiet minute.</sys:String>
  <sys:String x:Key="Tip.Ws.StartSteam">Starts Steam. Once it is open and you are logged in, subscribing works.</sys:String>
  <sys:String x:Key="Tip.Ws.TabSearch">Search mods by name or a word. Without a word it shows what's popular.</sys:String>
  <sys:String x:Key="Tip.Ws.TabThemes">Ready-made selections: pick a theme like “Fantasy” and get the best mods for it.</sys:String>
  <sys:String x:Key="Tip.Ws.TabUpdates">Which of your mods were updated since last time, which wait for an update and which the author removed from the Workshop.</sys:String>
  <sys:String x:Key="Tip.Ws.TabDownloads">Download queue: what is downloading now and what is done.</sys:String>
  <sys:String x:Key="Tip.Ws.EnableAfter">When on, a downloaded mod goes straight into the current modpack in the right place. When off, it just appears among available mods.</sys:String>
  <sys:String x:Key="Tip.Ws.Search">Type in English — almost all mods are named in English. E.g. “dragon”, “storage”, “Vanilla Expanded”. Enter searches.</sys:String>
  <sys:String x:Key="Tip.Ws.Sort">How to order results. “Best match” — best matches for your word, or popular this week without a word.</sys:String>
  <sys:String x:Key="Tip.Ws.OnlyMyVersion">Show only mods whose author marked your game version as supported. Untick to also see older mods that may not work.</sys:String>
  <sys:String x:Key="Tip.Ws.SearchButton">Search the Steam Workshop.</sys:String>
  <sys:String x:Key="Tip.Ws.Subscribe">Subscribes you to the mod on Steam and downloads it. Mods it can't work without are downloaded too.</sys:String>
  <sys:String x:Key="Tip.Ws.Enable">Already downloaded — turn it on in the current modpack and put it in the right place.</sys:String>
  <sys:String x:Key="Tip.Ws.InModpack">This mod is already on in the current modpack.</sys:String>
  <sys:String x:Key="Tip.Ws.More">Load the next page of results.</sys:String>
  <sys:String x:Key="Tip.Ws.Rating">Share of players who liked it: green — 85% and up, yellow — 65–85%, red — below.</sys:String>
  <sys:String x:Key="Tip.Ws.Versions">RimWorld versions the author marked as supported.</sys:String>
  <sys:String x:Key="Tip.Ws.ShowInList">Go to this mod on the Mods screen.</sys:String>
  <sys:String x:Key="Tip.Ws.OpenPage">Open the mod's Steam page in the browser: comments, discussions and pictures.</sys:String>
  <sys:String x:Key="Tip.Ws.Unsubscribe">Unsubscribe from the mod on Steam: it leaves the modpack and Steam deletes its files.</sys:String>
  <sys:String x:Key="Tip.Upd.Recheck">Compare installed mods with the Workshop again.</sys:String>
  <sys:String x:Key="Tip.Upd.MarkSeen">Remember that you've looked through everything. Next time only new changes are shown.</sys:String>
  <sys:String x:Key="Tip.Upd.UpdateAll">Ask Steam to download the new versions of these mods right now instead of waiting for the game to start.</sys:String>
  <sys:String x:Key="Tip.Upd.InModpack">The mod is on in the current modpack, so its update affects your game.</sys:String>
  <sys:String x:Key="Tip.Upd.WhatsNew">Show the author's notes: what changed in the update.</sys:String>
  <sys:String x:Key="Tip.Upd.Folder">Open the mod's folder — e.g. to keep a copy of it.</sys:String>
  <sys:String x:Key="Tip.Upd.Page">Open the mod's change notes page in the browser.</sys:String>
  <sys:String x:Key="Tip.Dl.Clear">Remove finished and failed downloads from the list.</sys:String>
  <sys:String x:Key="Tip.Dl.Retry">Try downloading this mod again.</sys:String>
  <sys:String x:Key="Tip.Dl.DownloadMissing">Download every mod this modpack lacks from the Workshop — both the ones in the list and the ones other mods need.</sys:String>
  <sys:String x:Key="Tip.Coll.Button">Make a modpack from a Steam Workshop collection: paste a link and RimForge downloads what's missing and puts the mods in order.</sys:String>
  <sys:String x:Key="Ws.HideTranslations">No translations</sys:String>
  <sys:String x:Key="Tip.Ws.HideTranslations">Hide translation mods (Russian, Chinese and other translations). Untick when you are looking for a translation of your mod.</sys:String>
  <sys:String x:Key="Dl.ConfirmTitle">Download the missing mods?</sys:String>
  <sys:String x:Key="Dl.ConfirmText">RimForge will subscribe you to {0} mod(s) on Steam and download them. Mods they need themselves come along too.</sys:String>
  <sys:String x:Key="Badge.New">NEW</sys:String>
  <sys:String x:Key="Badge.Updated">UPDATED</sys:String>
  <sys:String x:Key="Tip.Row.New">Installed recently and not played yet. The mark goes away once the mod is on and you start the game.</sys:String>
  <sys:String x:Key="Tip.Row.Updated">The author updated this mod after you last played. If something broke, check it first.</sys:String>
  <sys:String x:Key="Tip.Row.Favorite">Favorite</sys:String>
  <sys:String x:Key="Tip.Favorite">Add to or remove from favorites. Favorites are easy to find with the “Favorites” filter.</sys:String>
  <sys:String x:Key="Filters.Button">Filters</sys:String>
  <sys:String x:Key="Filters.ButtonCount">Filters · {0}</sys:String>
  <sys:String x:Key="Filters.Title">Filters</sys:String>
  <sys:String x:Key="Filters.Reset">Reset</sys:String>
  <sys:String x:Key="Filters.State">State</sys:String>
  <sys:String x:Key="Filters.Categories">What the mod adds</sys:String>
  <sys:String x:Key="Filters.Hint">Several ticks in one group show mods with any of them. Filters only hide things on screen; the load order does not change.</sys:String>
  <sys:String x:Key="Tip.Filters">Show only the mods you need: new ones, ones with problems, weapons, races and so on. Works for both lists.</sys:String>
  <sys:String x:Key="Tip.Filters.Reset">Clear all filters and show every mod again.</sys:String>
  <sys:String x:Key="Tip.Analysis">RimForge is reading the mods' contents to work out their categories and size. This happens once; later only for new and updated mods.</sys:String>
  <sys:String x:Key="Analysis.Progress">reading mods… {0}%</sys:String>
  <sys:String x:Key="Footer.Size">modpack size {0}</sys:String>
  <sys:String x:Key="State.New">New</sys:String>
  <sys:String x:Key="State.Updated">Updated</sys:String>
  <sys:String x:Key="State.Favorite">Favorites</sys:String>
  <sys:String x:Key="State.Problems">With problems</sys:String>
  <sys:String x:Key="State.WrongVersion">Not for my version</sys:String>
  <sys:String x:Key="State.Removed">Removed from Workshop</sys:String>
  <sys:String x:Key="State.InSaves">Used in saves</sys:String>
  <sys:String x:Key="State.Unused">Not used</sys:String>
  <sys:String x:Key="Tip.State.New">Recently installed mods you haven't played with yet.</sys:String>
  <sys:String x:Key="Tip.State.Updated">Mods the author updated after you last played.</sys:String>
  <sys:String x:Key="Tip.State.Favorite">Mods marked with a star.</sys:String>
  <sys:String x:Key="Tip.State.Problems">Mods the traffic light found a problem with: missing requirement, wrong order, incompatibility.</sys:String>
  <sys:String x:Key="Tip.State.WrongVersion">The author did not mark your game version as supported — these may not work.</sys:String>
  <sys:String x:Key="Tip.State.Removed">The author deleted or hid the mod in the Workshop. Your copy works, but it can't be downloaded again.</sys:String>
  <sys:String x:Key="Tip.State.InSaves">Mods used in at least one of your saves. Turning them off is risky for those colonies.</sys:String>
  <sys:String x:Key="Tip.State.Unused">Mods that are in no modpack and no save. Most likely they can be removed to free space.</sys:String>
  <sys:String x:Key="Cat.Weapons">Weapons</sys:String>
  <sys:String x:Key="Cat.Apparel">Apparel &amp; armor</sys:String>
  <sys:String x:Key="Cat.Races">Races &amp; xenotypes</sys:String>
  <sys:String x:Key="Cat.Animals">Animals</sys:String>
  <sys:String x:Key="Cat.Mechanoids">Mechanoids</sys:String>
  <sys:String x:Key="Cat.Buildings">Buildings &amp; furniture</sys:String>
  <sys:String x:Key="Cat.FoodPlants">Food &amp; plants</sys:String>
  <sys:String x:Key="Cat.Medical">Medical &amp; implants</sys:String>
  <sys:String x:Key="Cat.Factions">Factions</sys:String>
  <sys:String x:Key="Cat.Events">Events &amp; quests</sys:String>
  <sys:String x:Key="Cat.Vehicles">Vehicles</sys:String>
  <sys:String x:Key="Cat.Interface">Interface &amp; QoL</sys:String>
  <sys:String x:Key="Cat.Performance">Performance</sys:String>
  <sys:String x:Key="Cat.Graphics">Graphics</sys:String>
  <sys:String x:Key="Cat.Library">Libraries</sys:String>
  <sys:String x:Key="Cat.Patch">Patches</sys:String>
  <sys:String x:Key="Cat.Translation">Translations</sys:String>
  <sys:String x:Key="Cat.Fantasy">Fantasy</sys:String>
  <sys:String x:Key="Cat.Medieval">Medieval</sys:String>
  <sys:String x:Key="Cat.SciFi">Space &amp; sci-fi</sys:String>
  <sys:String x:Key="Cat.Horror">Horror</sys:String>
  <sys:String x:Key="Tip.Cat.Weapons">Adds weapons: guns, melee, grenades, turrets.</sys:String>
  <sys:String x:Key="Tip.Cat.Apparel">Adds clothing, armor, helmets.</sys:String>
  <sys:String x:Key="Tip.Cat.Races">Adds races, xenotypes or genes.</sys:String>
  <sys:String x:Key="Tip.Cat.Animals">Adds animals and creatures.</sys:String>
  <sys:String x:Key="Tip.Cat.Mechanoids">Adds mechanoids.</sys:String>
  <sys:String x:Key="Tip.Cat.Buildings">Adds buildings, furniture, workbenches, floors.</sys:String>
  <sys:String x:Key="Tip.Cat.FoodPlants">Adds plants, food and drinks.</sys:String>
  <sys:String x:Key="Tip.Cat.Medical">Adds implants, prosthetics, medicine, drugs.</sys:String>
  <sys:String x:Key="Tip.Cat.Factions">Adds factions.</sys:String>
  <sys:String x:Key="Tip.Cat.Events">Adds events, quests, storytellers.</sys:String>
  <sys:String x:Key="Tip.Cat.Vehicles">Adds vehicles.</sys:String>
  <sys:String x:Key="Tip.Cat.Interface">Changes the interface or how the game works while adding almost nothing: conveniences, new buttons and windows.</sys:String>
  <sys:String x:Key="Tip.Cat.Performance">Makes the game faster.</sys:String>
  <sys:String x:Key="Tip.Cat.Graphics">Changes pictures: retextures, new icons.</sys:String>
  <sys:String x:Key="Tip.Cat.Library">Other mods need it to work (framework, library). Adds little by itself.</sys:String>
  <sys:String x:Key="Tip.Cat.Patch">Only fixes or adjusts other mods and the game.</sys:String>
  <sys:String x:Key="Tip.Cat.Translation">A translation of another mod or the game.</sys:String>
  <sys:String x:Key="Tip.Cat.Fantasy">Fantasy theme: magic, dragons, elves.</sys:String>
  <sys:String x:Key="Tip.Cat.Medieval">Medieval theme: knights, castles, swords.</sys:String>
  <sys:String x:Key="Tip.Cat.SciFi">Space and far-future theme.</sys:String>
  <sys:String x:Key="Tip.Cat.Horror">Horror theme: zombies, undead, creepy things.</sys:String>
  <sys:String x:Key="Tip.Cat.Remove">Not what this mod is about — remove the category. RimForge remembers.</sys:String>
  <sys:String x:Key="Tip.Cat.Edit">Fix the categories by hand if RimForge got them wrong. Your changes are kept.</sys:String>
  <sys:String x:Key="Cat.Edit">Edit</sys:String>
  <sys:String x:Key="Cat.EditHint">Tick what fits this mod. Categories you set yourself have an amber outline.</sys:String>
  <sys:String x:Key="Details.Inside">What's inside</sys:String>
  <sys:String x:Key="Tip.Details.Inside">RimForge read the mod's files and counted what it adds to the game.</sys:String>
  <sys:String x:Key="Details.InsideUnknown">Reading the contents…</sys:String>
  <sys:String x:Key="Details.Size">Size on disk:</sys:String>
  <sys:String x:Key="Details.NoteHint">A note for yourself, e.g. “don't use with CE”</sys:String>
  <sys:String x:Key="Tip.Details.Note">Your note about this mod. Only you see it; it saves by itself.</sys:String>
  <sys:String x:Key="Content.Weapons">weapons: {0}</sys:String>
  <sys:String x:Key="Content.Apparel">apparel &amp; armor: {0}</sys:String>
  <sys:String x:Key="Content.Races">races: {0}</sys:String>
  <sys:String x:Key="Content.Xenotypes">xenotypes: {0}</sys:String>
  <sys:String x:Key="Content.Genes">genes: {0}</sys:String>
  <sys:String x:Key="Content.Animals">animals: {0}</sys:String>
  <sys:String x:Key="Content.Mechanoids">mechanoids: {0}</sys:String>
  <sys:String x:Key="Content.Buildings">buildings: {0}</sys:String>
  <sys:String x:Key="Content.Plants">plants: {0}</sys:String>
  <sys:String x:Key="Content.Food">food: {0}</sys:String>
  <sys:String x:Key="Content.Medical">medical: {0}</sys:String>
  <sys:String x:Key="Content.Research">research: {0}</sys:String>
  <sys:String x:Key="Content.Factions">factions: {0}</sys:String>
  <sys:String x:Key="Content.Events">events: {0}</sys:String>
  <sys:String x:Key="Content.Vehicles">vehicles: {0}</sys:String>
  <sys:String x:Key="Content.CodeOnly">code only — changes how the game works</sys:String>
  <sys:String x:Key="Content.Patches">patches only: {0} file(s)</sys:String>
  <sys:String x:Key="Content.Textures">pictures only: {0}</sys:String>
  <sys:String x:Key="Content.Languages">text translations only</sys:String>
  <sys:String x:Key="Ws.Sort.Updated">Recently updated</sys:String>
  <sys:String x:Key="Ws.Header.Updated">Recently updated</sys:String>
  <sys:String x:Key="Ws.Header.Category">Category “{0}”</sys:String>
  <sys:String x:Key="Ws.Header.SearchIn">Search “{0}” in “{1}”</sys:String>
  <sys:String x:Key="Ws.Category.Any">Any</sys:String>
  <sys:String x:Key="Ws.Theme.HaveHidden">you already have {0} — hidden</sys:String>
  <sys:String x:Key="Ws.NeedsDlc">Needs {0}?</sys:String>
  <sys:String x:Key="Tip.Ws.NeedsDlc">Judging by its description, the mod needs an expansion you don't have. It's a guess from the text — check the mod's page.</sys:String>
  <sys:String x:Key="Tip.Ws.HaveIt">You already have this mod.</sys:String>
  <sys:String x:Key="Tip.Ws.Filters">Category (weapons, races, buildings…) and what to show: only for your version, no translations, no installed, no abandoned.</sys:String>
  <sys:String x:Key="Tip.Ws.CategoryTag">Chosen category. The cross searches everything.</sys:String>
  <sys:String x:Key="Ws.Filters.Category">Category (press again to clear)</sys:String>
  <sys:String x:Key="Ws.Filters.Show">What to show</sys:String>
  <sys:String x:Key="Ws.OnlyMods">Mods only (no scenarios)</sys:String>
  <sys:String x:Key="Tip.Ws.OnlyMods">Hide scenarios — they are ready-made starts, not mods.</sys:String>
  <sys:String x:Key="Ws.HideInstalled">Hide installed</sys:String>
  <sys:String x:Key="Tip.Ws.HideInstalled">Don't show mods you already have. When off, they show with a green tick.</sys:String>
  <sys:String x:Key="Ws.HideAbandoned">Hide abandoned (no update for over a year)</sys:String>
  <sys:String x:Key="Tip.Ws.HideAbandoned">Mods not updated for over a year break more often on new game versions.</sys:String>
  <sys:String x:Key="Ws.Tab.Cleanup">Disk cleanup</sys:String>
  <sys:String x:Key="Tip.Ws.TabCleanup">Workshop mods you don't use: in no modpack and no save. Unsubscribe to free space.</sys:String>
  <sys:String x:Key="Clean.Hint">These Workshop mods are in none of your modpacks, saves or the game's list. Tick the ones you don't need and unsubscribe — Steam deletes their files. You can always download a mod again.</sys:String>
  <sys:String x:Key="Clean.Summary">Not used: {0} mods ({1}). Ticked: {2} ({3}).</sys:String>
  <sys:String x:Key="Clean.SelectAll">Tick all</sys:String>
  <sys:String x:Key="Clean.SelectNone">Untick all</sys:String>
  <sys:String x:Key="Clean.Unsubscribe">Unsubscribe from ticked</sys:String>
  <sys:String x:Key="Clean.Empty">Great: no unused Workshop mods.</sys:String>
  <sys:String x:Key="Clean.ConfirmTitle">Unsubscribe from these mods?</sys:String>
  <sys:String x:Key="Clean.ConfirmText">RimForge will unsubscribe you from {0} mod(s) on Steam. Steam deletes their files, freeing about {1}. They are in no modpack and no save.</sys:String>
  <sys:String x:Key="Clean.Button">Unsubscribe ({0})</sys:String>
  <sys:String x:Key="Clean.Done">Unsubscribed from {0} mod(s). Steam will free about {1}.</sys:String>
  <sys:String x:Key="Tip.Clean.SelectAll">Tick every mod in the list.</sys:String>
  <sys:String x:Key="Tip.Clean.Unsubscribe">Unsubscribe from the ticked mods on Steam. You'll be asked first, with the final list.</sys:String>
  <sys:String x:Key="Theme.apparel">Apparel &amp; armor</sys:String>
  <sys:String x:Key="Theme.apparel.Tip">Clothing, armor, helmets.</sys:String>
  <sys:String x:Key="Theme.mechanoids">Mechanoids</sys:String>
  <sys:String x:Key="Theme.mechanoids.Tip">Mechanoids, mechanitors and everything around them.</sys:String>
  <sys:String x:Key="Theme.vehicles">Vehicles</sys:String>
  <sys:String x:Key="Theme.vehicles.Tip">Cars, tanks, carts. E.g. Vehicle Framework.</sys:String>
  <sys:String x:Key="Theme.medical">Medical &amp; implants</sys:String>
  <sys:String x:Key="Theme.medical.Tip">Implants, prosthetics, bionics, medicine.</sys:String>
  <sys:String x:Key="Theme.food">Food &amp; plants</sys:String>
  <sys:String x:Key="Theme.food.Tip">New food, cooking, plants and farming.</sys:String>
  <sys:String x:Key="Theme.factions">Factions</sys:String>
  <sys:String x:Key="Theme.factions.Tip">New factions and settlements.</sys:String>
  <sys:String x:Key="Theme.graphics">Graphics</sys:String>
  <sys:String x:Key="Theme.graphics.Tip">Retextures and new pictures for familiar things.</sys:String>
  <sys:String x:Key="Theme.library">Libraries</sys:String>
  <sys:String x:Key="Theme.library.Tip">Frameworks other mods need.</sys:String>
  <sys:String x:Key="Tr.Auto">Auto-translate</sys:String>
  <sys:String x:Key="Tip.Tr.Auto">Translates a mod's description into your language when you open it. Mod names are kept as they are, so they are easy to recognise and search for. Translations are remembered, a mod is never translated twice.</sys:String>
  <sys:String x:Key="Tr.Translate">Translate</sys:String>
  <sys:String x:Key="Tip.Tr.Translate">Translate this mod's description into your language.</sys:String>
  <sys:String x:Key="Tr.Working">Translating…</sys:String>
  <sys:String x:Key="Tr.TranslatedFrom">Machine translation · original language: {0}</sys:String>
  <sys:String x:Key="Tr.WillTranslate">Description language: {0}. Open the mod or click here to translate it.</sys:String>
  <sys:String x:Key="Tr.ShowingOriginal">Original · language: {0}</sys:String>
  <sys:String x:Key="Tr.ShowOriginal">Show original</sys:String>
  <sys:String x:Key="Tr.ShowTranslation">Show translation</sys:String>
  <sys:String x:Key="Tip.Tr.Toggle">Switch between the translation and the author's original text.</sys:String>
  <sys:String x:Key="Tr.Failed">The translator is unavailable right now ({0}). Texts are shown in the original.</sys:String>
  <sys:String x:Key="Tip.Tr.Settings">Translation settings: the online translator or the built-in model that works without the internet.</sys:String>
  <sys:String x:Key="Tr.Engine.Title">Translate with</sys:String>
  <sys:String x:Key="Tr.Engine.Online">Google online translator — best quality, needs the internet</sys:String>
  <sys:String x:Key="Tip.Tr.Engine.Online">Texts are sent to Google Translate. Fast and good, but needs the internet.</sys:String>
  <sys:String x:Key="Tr.Engine.Offline">Built-in model — no internet, lower quality</sys:String>
  <sys:String x:Key="Tip.Tr.Engine.Offline">Translates right on your computer, sending nothing online. Available once the model is downloaded.</sys:String>
  <sys:String x:Key="Tr.Engine.Fallback">If the online translator is unavailable, use the built-in model</sys:String>
  <sys:String x:Key="Tip.Tr.Engine.Fallback">No internet or Google does not answer — RimForge translates with the built-in model, if it is downloaded.</sys:String>
  <sys:String x:Key="Tr.Model.Title">Built-in translation model</sys:String>
  <sys:String x:Key="Tr.Model.About">Meta's NLLB-200 model: 200 languages, Chinese straight to English. Works without the internet and translates a mod description in about a second, but the quality is lower than the online translator's. Downloaded once — about 900 MB.</sys:String>
  <sys:String x:Key="Tr.Model.NotInstalled">not downloaded</sys:String>
  <sys:String x:Key="Tr.Model.Downloading">downloading… {0}%</sys:String>
  <sys:String x:Key="Tr.Model.Ready">downloaded · {0}</sys:String>
  <sys:String x:Key="Tr.Model.Download">Download model (~900 MB)</sys:String>
  <sys:String x:Key="Tip.Tr.Model.Download">Download the model from Hugging Face. If the download is interrupted, it continues where it stopped.</sys:String>
  <sys:String x:Key="Tr.Model.Cancel">Stop</sys:String>
  <sys:String x:Key="Tip.Tr.Model.Cancel">Stop the download. What is downloaded is kept — you can continue later.</sys:String>
  <sys:String x:Key="Tr.Model.Delete">Delete model</sys:String>
  <sys:String x:Key="Tip.Tr.Model.Delete">Delete the model from disk to free space. Translations already made are kept.</sys:String>
  <sys:String x:Key="Tr.Model.License">Model licence: CC BY-NC 4.0 — free, for non-commercial use only.</sys:String>
  <sys:String x:Key="Tr.Model.Done">Translation model downloaded — RimForge can now translate without the internet.</sys:String>
  <sys:String x:Key="Tr.Model.Failed">Could not download the model: {0}. Click Download again — it continues where it stopped.</sys:String>
  <sys:String x:Key="Tr.Model.NoSpace">Not enough disk space: about {0} needed, {1} free.</sys:String>
  <sys:String x:Key="Tr.Model.Deleted">Translation model deleted.</sys:String>
  <sys:String x:Key="Tr.Model.DeleteFailed">Could not delete the model: {0}</sys:String>
  <sys:String x:Key="Tr.Model.Partial">{0} of ~900 MB downloaded</sys:String>
  <sys:String x:Key="Tr.Model.Continue">Continue download</sys:String>
  <sys:String x:Key="Tip.Profiles.Share">Share the modpack: save it to a .rimforge file and send it to a friend. They open it in RimForge — missing mods download by themselves and the order is exactly yours.</sys:String>
  <sys:String x:Key="Share.Title">Share “{0}”</sys:String>
  <sys:String x:Key="Share.Intro">RimForge saves the modpack to a .rimforge file: the mod list, the exact load order, the game version and the expansions it needs. Send the file to a friend — they drop it onto RimForge and the missing mods download from the Workshop by themselves.</sys:String>
  <sys:String x:Key="Share.Description">Description for your friend</sys:String>
  <sys:String x:Key="Share.DescriptionHint">For example: “Medieval, hardcore, 120 mods. Play the Tribe scenario”</sys:String>
  <sys:String x:Key="Share.Settings">Include mod settings ({0})</sys:String>
  <sys:String x:Key="Tip.Share.Settings">Settings you changed in game (Options → Mod settings). On your friend's PC they replace their settings of these mods — the old ones are kept in a backup.</sys:String>
  <sys:String x:Key="Share.Mods">Include the mods themselves — full archive ({0} mods, ~{1})</sys:String>
  <sys:String x:Key="Tip.Share.Mods">For friends without Steam (GOG), or to keep the mod versions exactly as yours. The file gets big. The game and its expansions are never included.</sys:String>
  <sys:String x:Key="Share.ModsWarning">Mods are their authors' work. Share a full archive with friends only, do not publish it online. The game and official expansions are never included.</sys:String>
  <sys:String x:Key="Share.Local">Local mods not from the Workshop ({0}): {1}. Your friend can only get them if the mods themselves are included.</sys:String>
  <sys:String x:Key="Share.LightSize">Light file — a few kilobytes.</sys:String>
  <sys:String x:Key="Share.FullSize">Full archive — about {0}.</sys:String>
  <sys:String x:Key="Share.Save">Save file…</sys:String>
  <sys:String x:Key="Tip.Share.Save">Choose where to save the modpack file.</sys:String>
  <sys:String x:Key="Share.Saved">Modpack saved: {0} ({1}). The folder is open — send the file to your friend.</sys:String>
  <sys:String x:Key="Share.Cancelled">Saving cancelled.</sys:String>
  <sys:String x:Key="Share.Failed">Could not save the modpack: {0}</sys:String>
  <sys:String x:Key="Pack.Open">Open modpack file</sys:String>
  <sys:String x:Key="Tip.Pack.Open">Open a .rimforge file someone sent you. You can also just drop the file onto the RimForge window.</sys:String>
  <sys:String x:Key="Pack.Bad">“{0}” is not a RimForge modpack file or it is damaged ({1}).</sys:String>
  <sys:String x:Key="Pack.Info">Made {0} · RimWorld {1} · mods: {2}</sys:String>
  <sys:String x:Key="Pack.Have">Already here: {0}</sys:String>
  <sys:String x:Key="Pack.Download">Download from the Workshop: {0} (~{1})</sys:String>
  <sys:String x:Key="Pack.Checking">checking the Workshop…</sys:String>
  <sys:String x:Key="Pack.FromFile">Unpack from the file: {0} (~{1})</sys:String>
  <sys:String x:Key="Pack.Unavailable">Not available anywhere — the author's local mods ({0}): {1}</sys:String>
  <sys:String x:Key="Pack.Removed">Removed from the Workshop ({0}): {1}</sys:String>
  <sys:String x:Key="Pack.Dlc">Needs expansions you don't have: {0}. Mods that need them won't work without them.</sys:String>
  <sys:String x:Key="Pack.Version">The modpack was made on RimWorld {0}, you have {1}. Some mods may not work.</sys:String>
  <sys:String x:Key="Pack.Updated">Updated since the modpack was made ({0}): {1}. The new versions will download — usually that's fine.</sys:String>
  <sys:String x:Key="Pack.Settings">Apply the mod settings from the modpack ({0}). Your current settings of these mods are kept in a backup.</sys:String>
  <sys:String x:Key="Tip.Pack.Settings">Mod settings the modpack's author changed in game. For mods still downloading they are applied after the download.</sys:String>
  <sys:String x:Key="Pack.Create">Create modpack</sys:String>
  <sys:String x:Key="Pack.CreateAndDownload">Create modpack and download</sys:String>
  <sys:String x:Key="Tip.Pack.Create">Create a new modpack with this list and order. Your modpacks stay as they are; missing mods download from the Workshop.</sys:String>
  <sys:String x:Key="Pack.NoGameDir">The game folder was not found — nowhere to unpack the mods. Set the RimWorld folder and try again.</sys:String>
  <sys:String x:Key="Pack.Created">Modpack “{0}” created: {1} here, {2} downloading, settings applied for {3}.</sys:String>
  <sys:String x:Key="Pack.Failed">Could not open the modpack: {0}</sys:String>
  <sys:String x:Key="Pack.SettingsApplied">Mod settings from the modpack applied: {0}.</sys:String>
  <sys:String x:Key="Profiles.OwnSettings">Every modpack remembers its own mod settings</sys:String>
  <sys:String x:Key="Tip.Profiles.OwnSettings">Mod settings (Options → Mod settings in game) are kept per modpack. When you switch, RimForge remembers the settings of the modpack you leave and brings back those of the one you go to. While the game is running, settings are not switched.</sys:String>
  <sys:String x:Key="Msg.SettingsRestored">This modpack's mod settings are back.</sys:String>
  <sys:String x:Key="Msg.SettingsGameRunning">The game is running — mod settings were not switched; close the game and switch again.</sys:String>
  <sys:String x:Key="Msg.SettingsFailed">Mod settings were not switched: {0}</sys:String>
  <sys:String x:Key="Tip.Game">Which version of the game RimForge shows and launches: the installed one or a saved copy from the library. A copy has its own saves, settings and frozen mods — Steam updates of the game and mods can't break it.</sys:String>
  <sys:String x:Key="Game.Title">Game version</sys:String>
  <sys:String x:Key="Game.Copy">copy</sys:String>
  <sys:String x:Key="Game.SteamDetails">The installed game. Steam updates it and the Workshop mods by itself.</sys:String>
  <sys:String x:Key="Game.CopyDetails">Saved {0} · mods: {1} · own saves and settings, mods frozen</sys:String>
  <sys:String x:Key="Game.Save">Save a copy of this version…</sys:String>
  <sys:String x:Key="Tip.Game.Save">Copy the installed game with all mods, saves and settings into the RimForge library. The copy never updates — you can finish your playthrough on it even after Steam updates the game.</sys:String>
  <sys:String x:Key="Game.OpenLibrary">Open library folder</sys:String>
  <sys:String x:Key="Game.Hint">Mods are stored in the library once for all copies; a game copy's folder holds only links to them, so the game itself stays clean.</sys:String>
  <sys:String x:Key="Tip.Game.Delete">Delete this copy of the game with its saves. Mods no other copy needs are deleted too.</sys:String>
  <sys:String x:Key="Game.NoGame">No installed game found — nothing to copy.</sys:String>
  <sys:String x:Key="Game.AlreadySaved">RimWorld {0} is already saved in the library.</sys:String>
  <sys:String x:Key="Game.Counting">Working out how much space is needed…</sys:String>
  <sys:String x:Key="Game.SaveTitle">Save a copy of RimWorld {0}</sys:String>
  <sys:String x:Key="Game.SaveText">RimForge will copy into the library:&#x0a;• the game without mods — {0}&#x0a;• mods ({1}): new {2}, already in the library {3}&#x0a;• saves and settings — {4}&#x0a;&#x0a;About {5} in total.&#x0a;Folder: {6}&#x0a;Free on the drive: {7}&#x0a;&#x0a;The installed game and your files are not changed. Copying takes a few minutes.</sys:String>
  <sys:String x:Key="Game.SaveButton">Save copy</sys:String>
  <sys:String x:Key="Game.NoSpace">Not enough space: about {0} needed, {1} free.</sys:String>
  <sys:String x:Key="Game.Working">RimForge library</sys:String>
  <sys:String x:Key="Game.Stage.game">Copying the game… {0}%</sys:String>
  <sys:String x:Key="Game.Stage.data">Copying saves and settings… {0}%</sys:String>
  <sys:String x:Key="Game.Stage.mods">Copying mods into the library… {0}%</sys:String>
  <sys:String x:Key="Game.Deleting">Deleting the game copy…</sys:String>
  <sys:String x:Key="Game.SavedTitle">RimWorld {0} copy is ready</sys:String>
  <sys:String x:Key="Game.SavedText">RimWorld {0} is saved. Neither game updates nor mod updates in Steam will touch it.&#x0a;&#x0a;Switch to it now? You can switch any time with the game version button at the top of the window.</sys:String>
  <sys:String x:Key="Game.SwitchNow">Switch</sys:String>
  <sys:String x:Key="Game.StayOnSteam">Stay on the installed one</sys:String>
  <sys:String x:Key="Game.Switched">RimForge now works with {0}.</sys:String>
  <sys:String x:Key="Game.Cancelled">Copying cancelled, unfinished files removed.</sys:String>
  <sys:String x:Key="Game.Failed">That did not work: {0}</sys:String>
  <sys:String x:Key="Game.DeleteTitle">Delete the RimWorld {0} copy?</sys:String>
  <sys:String x:Key="Game.DeleteText">The {0} game copy and its saves and settings ({1}) will be deleted. Mods no other copy needs are deleted too. The installed game is not changed.</sys:String>
  <sys:String x:Key="Game.Deleted">RimWorld {0} copy deleted, {1} freed.</sys:String>
  <sys:String x:Key="Issue.DuplicateActive">"{0}" is on twice: a local copy and a Workshop copy. The game can't load both — keep one.</sys:String>
  <sys:String x:Key="Issue.DuplicateInstalled">"{0}" is in several folders: {1}. The game will load only one of them — better delete or unsubscribe from the extra one.</sys:String>
  <sys:String x:Key="Issue.DlcMissing">"{0}" needs the {1} expansion, which is not installed. The mod won't work without it.</sys:String>
  <sys:String x:Key="Issue.OlderVersionLikelyOk">"{0}" was made for {1}, but it has no code of its own — it most likely works on {2} too.</sys:String>
  <sys:String x:Key="Issue.UseInstead">"{0}" is no longer updated. There is a maintained version: "{1}"{2}.</sys:String>
  <sys:String x:Key="Issue.By"> by {0}</sys:String>
  <sys:String x:Key="Fix.RemoveCopy">Remove copy</sys:String>
  <sys:String x:Key="Fix.Replace">Replace</sys:String>
  <sys:String x:Key="Fix.DownloadReplacement">Download replacement</sys:String>
  <sys:String x:Key="Fix.Replace.Title">Replace the abandoned mod?</sys:String>
  <sys:String x:Key="Fix.Replace.Text">RimForge will download "{1}" from the Workshop and put it where "{0}" is in the list. The old mod is turned off but stays on disk.</sys:String>
  <sys:String x:Key="Fix.Replace.SameId">The old and new versions share one ID, so the game can't have both: after the download RimForge unsubscribes from the old one.</sys:String>
  <sys:String x:Key="Fix.Replaced">"{0}" replaced with "{1}".</sys:String>
  <sys:String x:Key="Db.Status">Replacements: {0} · verified for {2}: {1}</sys:String>
  <sys:String x:Key="Tip.Db">Community databases (by Mlie, MIT licence): "Use This Instead" — abandoned mods and their maintained versions; "No Version Warning" — mods that work on a newer game version even though the author didn't list it. Click to refresh.</sys:String>
  <sys:String x:Key="FixAll.Button">Fix everything</sys:String>
  <sys:String x:Key="Tip.FixAll">Show the list of fixes: turn on needed mods, download missing ones, replace abandoned ones, put everything in order. Nothing changes until you press "Apply".</sys:String>
  <sys:String x:Key="FixAll.Title">Fix everything</sys:String>
  <sys:String x:Key="FixAll.Summary">Here is what RimForge will do ({0}). Untick whatever you don't want.</sys:String>
  <sys:String x:Key="FixAll.Nothing">Nothing to fix — all good.</sys:String>
  <sys:String x:Key="FixAll.OnlyManual">Nothing here can be fixed automatically — it needs your decision.</sys:String>
  <sys:String x:Key="FixAll.Enable">Turn on "{0}"</sys:String>
  <sys:String x:Key="FixAll.NeededBy">Needed by "{0}"</sys:String>
  <sys:String x:Key="FixAll.Download">Download "{0}" from the Workshop</sys:String>
  <sys:String x:Key="FixAll.RemoveMissing">Remove "{0}" from the list</sys:String>
  <sys:String x:Key="FixAll.RemoveMissingNote">It is not on disk and RimForge doesn't know where to download it.</sys:String>
  <sys:String x:Key="FixAll.RemoveCopy">Turn off the second copy of "{0}"</sys:String>
  <sys:String x:Key="FixAll.Replace">Replace "{0}" with "{1}"</sys:String>
  <sys:String x:Key="FixAll.DownloadReplacement">Download "{0}" instead of "{1}"</sys:String>
  <sys:String x:Key="FixAll.Sort">Put the mods in order</sys:String>
  <sys:String x:Key="FixAll.SortNote">Careful sort: moves only what is out of place.</sys:String>
  <sys:String x:Key="FixAll.ManualTitle">You need to decide these yourself</sys:String>
  <sys:String x:Key="FixAll.ManualNote">There's no right answer RimForge can pick for you: for example, which of two incompatible mods to keep.</sys:String>
  <sys:String x:Key="FixAll.DoneDownloading">Fixed: {0}. Downloading: {1} — the mods take their places once they arrive.</sys:String>
  <sys:String x:Key="Menu.LoadAfter">Always load after…</sys:String>
  <sys:String x:Key="Menu.LoadBefore">Always load before…</sys:String>
  <sys:String x:Key="Menu.PinTop">Pin to the top</sys:String>
  <sys:String x:Key="Menu.PinBottom">Pin to the bottom</sys:String>
  <sys:String x:Key="Menu.Unpin">Unpin</sys:String>
  <sys:String x:Key="Menu.OpenFolder">Open folder</sys:String>
  <sys:String x:Key="Menu.OpenWorkshop">Open in the Workshop</sys:String>
  <sys:String x:Key="Tip.Menu.LoadAfter">Your rule for this modpack: the mod always stays below the one you pick. Your rules win over the authors' rules.</sys:String>
  <sys:String x:Key="Tip.Menu.LoadBefore">Your rule for this modpack: the mod always stays above the one you pick.</sys:String>
  <sys:String x:Key="Tip.Menu.PinTop">The mod always stays at the start of the list — right after the game and DLC.</sys:String>
  <sys:String x:Key="Tip.Menu.PinBottom">The mod always stays at the end of the list (e.g. patches that must load last).</sys:String>
  <sys:String x:Key="Rule.NeedProfile">Your rules are stored in a modpack — create or pick one first.</sys:String>
  <sys:String x:Key="Rule.PickAfter">Load "{0}" after…</sys:String>
  <sys:String x:Key="Rule.PickBefore">Load "{0}" before…</sys:String>
  <sys:String x:Key="Rule.PickerNote">Pick a mod. The rule is saved in the modpack and the list is re-sorted right away. You can remove the rule under "Why is it here?".</sys:String>
  <sys:String x:Key="Rule.Add">Add rule</sys:String>
  <sys:String x:Key="Rule.AddedAfter">Rule added: "{0}" always after "{1}".</sys:String>
  <sys:String x:Key="Rule.AddedBefore">Rule added: "{0}" always before "{1}".</sys:String>
  <sys:String x:Key="Rule.PinnedTop">"{0}" pinned to the top of the list.</sys:String>
  <sys:String x:Key="Rule.PinnedBottom">"{0}" pinned to the bottom of the list.</sys:String>
  <sys:String x:Key="Rule.Unpinned">"{0}" unpinned.</sys:String>
  <sys:String x:Key="Rule.PinnedTopTip">Pinned to the top (your rule)</sys:String>
  <sys:String x:Key="Rule.PinnedBottomTip">Pinned to the bottom (your rule)</sys:String>
  <sys:String x:Key="Why.PinnedTop">You pinned this mod to the top — it sits as high as the rules allow: right after the game, DLC and the mods it needs (to undo: right-click → "Unpin").</sys:String>
  <sys:String x:Key="Why.PinnedBottom">You pinned this mod to the bottom — it sits as low as the rules allow: mods that need it still load after it (to undo: right-click → "Unpin").</sys:String>
  <sys:String x:Key="FixAll.ReplacementBy">The new version is by {0}; the abandoned one is called "{1}" in the Workshop.</sys:String>
  <sys:String x:Key="Settings.Title">Settings</sys:String>
  <sys:String x:Key="Ai.Title">AI assistant</sys:String>
  <sys:String x:Key="Ai.Hint">RimForge works with AI assistants: Claude, ChatGPT Codex, Gemini, Cursor, Copilot and any other app that supports the open MCP standard. Ask the AI to check your modpack, find why the game crashes or build a 100-mod fantasy pack — it sees your mods and can manage them.</sys:String>
  <sys:String x:Key="Ai.Enabled">Let AI assistants connect to RimForge</sys:String>
  <sys:String x:Key="Tip.Ai.Enabled">When off, a connected AI is told the player turned AI assistants off and sees nothing.</sys:String>
  <sys:String x:Key="Ai.AccessTitle">What the AI may do:</sys:String>
  <sys:String x:Key="Ai.Read">Only look (mod list, checks, log analysis, Workshop search)</sys:String>
  <sys:String x:Key="Ai.Ask">Ask me before every change (recommended)</sys:String>
  <sys:String x:Key="Ai.Full">Change without asking — you can still undo with Ctrl+Z</sys:String>
  <sys:String x:Key="Tip.Ai.Read">The AI sees your mods and can give advice, but changes nothing.</sys:String>
  <sys:String x:Key="Tip.Ai.Ask">Before every change RimForge shows what exactly the AI wants to do and asks for your OK.</sys:String>
  <sys:String x:Key="Tip.Ai.Full">The AI turns mods on and off, sorts and downloads by itself. Every change shows up in the log below; Ctrl+Z undoes list changes (downloads and game launches can't be undone).</sys:String>
  <sys:String x:Key="Ai.CanDo">The AI can: look at mods and modpacks, check the list, explain the order, read the game log, search the Workshop; with your OK — turn mods on and off, sort, add rules, create and switch modpacks, download mods and launch the game.</sys:String>
  <sys:String x:Key="Ai.LogTitle">What the AI did</sys:String>
  <sys:String x:Key="Ai.LogEmpty">Nothing yet. Changes asked for by AI assistants appear here.</sys:String>
  <sys:String x:Key="Ai.ConnectTitle">Connect an AI app</sys:String>
  <sys:String x:Key="Ai.ConnectHint">Press "Connect" — RimForge adds itself to the app's settings (the old settings are kept next to them in a .rimforge-backup file). Then restart that app: RimForge's tools appear in it. RimForge doesn't need to stay open — it opens by itself for changes.</sys:String>
  <sys:String x:Key="Ai.Copy">Copy</sys:String>
  <sys:String x:Key="Tip.Ai.Copy">Copy to the clipboard.</sys:String>
  <sys:String x:Key="Ai.OtherClient">Another app</sys:String>
  <sys:String x:Key="Ai.Where.Other">Any app with MCP support: stdio transport, this command with the --mcp argument.</sys:String>
  <sys:String x:Key="Ai.SomeAssistant">An AI assistant</sys:String>
  <sys:String x:Key="Ai.Ask.Title">{0} wants to change the modpack</sys:String>
  <sys:String x:Key="Ai.Ask.Undo">Changed your mind? Ctrl+Z in RimForge.</sys:String>
  <sys:String x:Key="Ai.Ask.NoUndo">This can't be undone with Ctrl+Z.</sys:String>
  <sys:String x:Key="Ai.Allow">Allow</sys:String>
  <sys:String x:Key="Ai.Done">{0}: {1}</sys:String>
  <sys:String x:Key="Ai.AndMore">and {0} more</sys:String>
  <sys:String x:Key="Ai.Enable">Turn on {0} mods — {1}. The list is sorted carefully.</sys:String>
  <sys:String x:Key="Ai.Disable">Turn off {0} mods — {1}.</sys:String>
  <sys:String x:Key="Ai.UsedInSaves">Some of them are used in your saves — those saves may not load without them.</sys:String>
  <sys:String x:Key="Ai.SetOrder">Replace the whole load order: {0} mods (now {1}).</sys:String>
  <sys:String x:Key="Ai.Sort">Sort the mods (carefully, fewest moves).</sys:String>
  <sys:String x:Key="Ai.SortFull">Fully re-sort the mods by groups.</sys:String>
  <sys:String x:Key="Ai.Rule">Add a rule: "{0}" always above "{1}".</sys:String>
  <sys:String x:Key="Ai.PinTop">Pin "{0}" to the top of the list.</sys:String>
  <sys:String x:Key="Ai.PinBottom">Pin "{0}" to the bottom of the list.</sys:String>
  <sys:String x:Key="Ai.Unpin">Unpin "{0}".</sys:String>
  <sys:String x:Key="Ai.Create">Create the modpack "{0}" ({1} mods).</sys:String>
  <sys:String x:Key="Ai.CreateAndSwitch">Create the modpack "{0}" ({1} mods) and switch to it.</sys:String>
  <sys:String x:Key="Ai.WillDownload">To download from the Workshop: {0} (subscriptions on your Steam account).</sys:String>
  <sys:String x:Key="Ai.Switch">Switch to the modpack "{0}".</sys:String>
  <sys:String x:Key="Ai.Download">Download {0} mods from the Workshop (subscriptions on your Steam account).</sys:String>
  <sys:String x:Key="Ai.DownloadEnable">Download and turn on {0} mods from the Workshop (subscriptions on your Steam account).</sys:String>
  <sys:String x:Key="Ai.Launch">Save the list and launch RimWorld.</sys:String>
  <sys:String x:Key="Ai.ModpackNote">Made by an AI assistant ({0}).</sys:String>
  <sys:String x:Key="Ai.ConnectAll">Connect all found</sys:String>
  <sys:String x:Key="Tip.Ai.ConnectAll">Connect RimForge to every AI app found on this PC.</sys:String>
  <sys:String x:Key="Ai.Connect">Connect</sys:String>
  <sys:String x:Key="Ai.Update">Update</sys:String>
  <sys:String x:Key="Ai.Disconnect">Disconnect</sys:String>
  <sys:String x:Key="Tip.Ai.Connect">RimForge adds itself to this app's settings. Its other settings are left alone.</sys:String>
  <sys:String x:Key="Tip.Ai.Disconnect">Remove RimForge from this app's settings.</sys:String>
  <sys:String x:Key="Ai.Manual">Manually</sys:String>
  <sys:String x:Key="Tip.Ai.Manual">Show the setting to paste it yourself.</sys:String>
  <sys:String x:Key="Ai.Status.NotFound">Not found on this PC</sys:String>
  <sys:String x:Key="Ai.Status.NotConnected">Found, not connected</sys:String>
  <sys:String x:Key="Ai.Status.Connected">Connected</sys:String>
  <sys:String x:Key="Ai.Status.OtherCopy">Connected to RimForge in another folder — press "Update"</sys:String>
  <sys:String x:Key="Ai.Connected">{0} is connected to RimForge. Restart {0} so it sees RimForge's tools.</sys:String>
  <sys:String x:Key="Ai.ConnectedMany">Connected: {0}. Restart these apps so they see RimForge.</sys:String>
  <sys:String x:Key="Ai.ConnectFailed">Could not change the settings of {0}: {1}</sys:String>
  <sys:String x:Key="Ai.Disconnect.Title">Disconnect {0}?</sys:String>
  <sys:String x:Key="Ai.Disconnect.Text">RimForge removes itself from the settings of {0}. After a restart {0} no longer sees your mods. You can connect again at any time.</sys:String>
  <sys:String x:Key="Ai.Disconnected">{0} is disconnected from RimForge.</sys:String>
  <sys:String x:Key="Ai.Copied">Copied: {0}.</sys:String>
  <sys:String x:Key="Ai.Where.claude-desktop">Claude Desktop → Settings → Developer → Edit Config. If it already has mcpServers, add only the rimforge block.</sys:String>
  <sys:String x:Key="Ai.Where.claude-code">%USERPROFILE%\.claude.json (the mcpServers section), or: claude mcp add rimforge --scope user -- &lt;path to RimForge.exe&gt; --mcp</sys:String>
  <sys:String x:Key="Ai.Where.codex">%USERPROFILE%\.codex\config.toml — for the Codex CLI and the Codex extension in VS Code.</sys:String>
  <sys:String x:Key="Ai.Where.gemini">%USERPROFILE%\.gemini\settings.json.</sys:String>
  <sys:String x:Key="Ai.Where.cursor">Cursor → Settings → MCP → Add new global MCP server (%USERPROFILE%\.cursor\mcp.json).</sys:String>
  <sys:String x:Key="Ai.Where.vscode">The "MCP: Open User Configuration" command in VS Code (mcp.json).</sys:String>
  <sys:String x:Key="Ai.Where.windsurf">%USERPROFILE%\.codeium\windsurf\mcp_config.json.</sys:String>
  <sys:String x:Key="Ai.Where.lmstudio">LM Studio → Program tab → Install → Edit mcp.json.</sys:String>
  <sys:String x:Key="Dl.Wait.NoAnswer">No connection to Steam — waiting, the download continues by itself</sys:String>
  <sys:String x:Key="Dl.Wait.SteamClosed">Steam is closed — the download continues when it starts</sys:String>
  <sys:String x:Key="Dl.Wait.GameRunning">The game is running — I'll check the download once it closes</sys:String>
  <sys:String x:Key="Dl.Wait.NotLoggedIn">Steam is not logged in — waiting</sys:String>
  <sys:String x:Key="Dl.Wait.Stalled">The download stands still (no internet?) — Steam resumes by itself, waiting</sys:String>
  <sys:String x:Key="Dl.Wait.SteamQueue">Queued in Steam — waiting (check Steam → Downloads for a pause)</sys:String>
  <sys:String x:Key="Dl.NotSubscribed">Steam never took the subscription. Press "Retry".</sys:String>
  <sys:String x:Key="Dl.Stopped">Stopped waiting (the Steam subscription stays). Press "Retry" to watch it again.</sys:String>
  <sys:String x:Key="Dl.StopWaiting">Don't wait</sys:String>
  <sys:String x:Key="Tip.Dl.StopWaiting">Stop watching this download. The Steam subscription stays — Steam finishes the mod by itself, and "Retry" watches it again.</sys:String>
  <sys:String x:Key="Tip.Nav.Assistant">Assistant — describe a modpack in words and RimForge picks the mods from the Steam Workshop.</sys:String>
  <sys:String x:Key="Asst.Title">Assistant</sys:String>
  <sys:String x:Key="Asst.Hint">Describe the modpack you want: a theme, what matters (FPS, stability), what you don't want. I'll pick mods from the Steam Workshop, explain the choice, and you decide what to download.</sys:String>
  <sys:String x:Key="Asst.Welcome">Hi! Tell me what modpack to build, for example:</sys:String>
  <sys:String x:Key="Asst.Example1">A fantasy modpack, but with high FPS and stable</sys:String>
  <sys:String x:Key="Asst.Example2">Space and androids, no DLC, 20 mods</sys:String>
  <sys:String x:Key="Asst.Example3">Vanilla-like with quality of life, for a weak PC</sys:String>
  <sys:String x:Key="Asst.WelcomeTopics">…or press a theme below. Then refine it: "no magic", "add weapons", "fewer mods".</sys:String>
  <sys:String x:Key="Asst.Placeholder">For example: medieval with knights and castles, no magic…</sys:String>
  <sys:String x:Key="Asst.Send">Send</sys:String>
  <sys:String x:Key="Tip.Asst.Send">Pick mods for this request (Enter).</sys:String>
  <sys:String x:Key="Asst.New">New conversation</sys:String>
  <sys:String x:Key="Tip.Asst.New">Clear the chat and the mod list.</sys:String>
  <sys:String x:Key="Asst.Fps">High FPS</sys:String>
  <sys:String x:Key="Tip.Asst.Fps">Fewer mods, light ones first, no known heavy mods, plus performance mods.</sys:String>
  <sys:String x:Key="Asst.Stable">Stability</sys:String>
  <sys:String x:Key="Tip.Asst.Stable">Only popular mods updated within the last two years, no betas.</sys:String>
  <sys:String x:Key="Asst.Size.Small">Small</sys:String>
  <sys:String x:Key="Asst.Size.Normal">Normal</sys:String>
  <sys:String x:Key="Asst.Size.Large">Large</sys:String>
  <sys:String x:Key="Tip.Asst.Size">How many mods to pick: about 15, 30 or 60.</sys:String>
  <sys:String x:Key="Asst.TopicRequest">Build a modpack: {0}</sys:String>
  <sys:String x:Key="Asst.SwitchesChanged">Rebuild: {0}</sys:String>
  <sys:String x:Key="Asst.Searching">Searching the Steam Workshop…</sys:String>
  <sys:String x:Key="Asst.SearchingFor">Searching the Workshop: {0}…</sys:String>
  <sys:String x:Key="Asst.NotUnderstood">I didn't get what modpack to build. Name a theme — "fantasy", "space", "medieval", "vanilla with quality of life", "zombies" — or press a theme below. You can add "for a weak PC", "stable", "small", "no magic".</sys:String>
  <sys:String x:Key="Asst.NothingFound">Found nothing fitting. Try another theme or other words (I know names of games and films too: "Warhammer", "Witcher", "Fallout").</sys:String>
  <sys:String x:Key="Asst.Offline">Could not reach the Steam Workshop. Check the internet and try again.</sys:String>
  <sys:String x:Key="Asst.Cancelled">Stopped.</sys:String>
  <sys:String x:Key="Asst.Failed">Could not pick mods: {0}</sys:String>
  <sys:String x:Key="Asst.Answer.Head">Built the modpack "{0}": {1} mods, about {2} to download.</sys:String>
  <sys:String x:Key="Asst.Answer.Have">You already have {0} of them.</sys:String>
  <sys:String x:Key="Asst.Answer.Guessed">You named no theme, so I built a vanilla-plus pack with quality of life. Name a theme and I'll rebuild it.</sys:String>
  <sys:String x:Key="Asst.Answer.More">and {0} more</sys:String>
  <sys:String x:Key="Asst.Answer.Fps">For high FPS: fewer mods, light ones first, plus {0} performance mods ({1}).</sys:String>
  <sys:String x:Key="Asst.Answer.Heavy">Left out heavy mods: {0}.</sys:String>
  <sys:String x:Key="Asst.Answer.Stable">For stability: only popular mods updated within the last two years.</sys:String>
  <sys:String x:Key="Asst.Answer.Without">Without: {0}.</sys:String>
  <sys:String x:Key="Asst.Answer.Empty">Found nothing fitting for "{0}".</sys:String>
  <sys:String x:Key="Asst.Answer.Replaced">Swapped {0} abandoned mods for their maintained versions.</sys:String>
  <sys:String x:Key="Asst.Answer.Dlc">Skipped {0} mods that need expansions you don't have.</sys:String>
  <sys:String x:Key="Asst.Answer.NoDlc">Skipped {0} mods that need expansions (DLC).</sys:String>
  <sys:String x:Key="Asst.Answer.Failed">Some searches failed (Steam connection) — the list may be incomplete.</sys:String>
  <sys:String x:Key="Asst.Answer.Safety">All mods are for RimWorld {0}. Needed libraries (Harmony etc.) download by themselves, and after the download RimForge checks compatibility and sorts the load order.</sys:String>
  <sys:String x:Key="Asst.Answer.Next">Look through the list on the right: untick what you don't want, or tell me what to change ("no dragons", "add weapons", "fewer mods").</sys:String>
  <sys:String x:Key="Asst.PlanTitle">Modpack</sys:String>
  <sys:String x:Key="Asst.PlanEmpty">The mods I pick will appear here.</sys:String>
  <sys:String x:Key="Asst.NameHint">Modpack name</sys:String>
  <sys:String x:Key="Asst.Selection">Mods chosen: {0} · download {1}</sys:String>
  <sys:String x:Key="Asst.Have">already have: {0}</sys:String>
  <sys:String x:Key="Asst.Alternatives">More options ({0})</sys:String>
  <sys:String x:Key="Tip.Asst.Alternatives">Mods that fit too but didn't make it into the pack. Tick one to add it.</sys:String>
  <sys:String x:Key="Asst.Create">Create modpack and download</sys:String>
  <sys:String x:Key="Tip.Asst.Create">Create a new modpack from the ticked mods and download the missing ones from the Steam Workshop. Your other modpacks stay as they are.</sys:String>
  <sys:String x:Key="Asst.Rebuild">Pick again</sys:String>
  <sys:String x:Key="Tip.Asst.Rebuild">Search again for the same request.</sys:String>
  <sys:String x:Key="Asst.Badge.Core">checked</sys:String>
  <sys:String x:Key="Tip.Asst.Badge.Core">A well-known mod RimForge checked by hand for this theme.</sys:String>
  <sys:String x:Key="Asst.Badge.Installed">installed</sys:String>
  <sys:String x:Key="Asst.Badge.Performance">performance</sys:String>
  <sys:String x:Key="Asst.Replaces">instead of the abandoned "{0}"</sys:String>
  <sys:String x:Key="Tip.Asst.Open">Open the mod's Steam Workshop page.</sys:String>
  <sys:String x:Key="Tip.Asst.Group">Tick or untick all mods of this theme.</sys:String>
  <sys:String x:Key="Asst.ConfirmTitle">Create the modpack "{0}"?</sys:String>
  <sys:String x:Key="Asst.ConfirmText">The modpack has {0} mods. {1} need to be downloaded ({2}).</sys:String>
  <sys:String x:Key="Asst.ConfirmSteam">RimForge subscribes to these mods on your Steam account and Steam downloads them. The modpack becomes the current one at once; mods take their places as they arrive. You can unsubscribe later in the "Cleanup" tab.</sys:String>
  <sys:String x:Key="Asst.Created">Done: created the modpack "{0}" and queued {1} mods for download. Progress is in Workshop → "Downloads".</sys:String>
  <sys:String x:Key="Asst.CreatedNoDownload">Done: created the modpack "{0}" — you already had every mod.</sys:String>
  <sys:String x:Key="Asst.Notes">Built by the assistant: {0}</sys:String>
  <sys:String x:Key="Asst.DefaultName">My modpack</sys:String>
  <sys:String x:Key="Asst.Topic.fantasy">Fantasy</sys:String>
  <sys:String x:Key="Asst.Topic.medieval">Medieval</sys:String>
  <sys:String x:Key="Asst.Topic.magic">Magic</sys:String>
  <sys:String x:Key="Asst.Topic.scifi">Space &amp; sci-fi</sys:String>
  <sys:String x:Key="Asst.Topic.weapons">Weapons</sys:String>
  <sys:String x:Key="Asst.Topic.apparel">Apparel &amp; armor</sys:String>
  <sys:String x:Key="Asst.Topic.animals">Animals</sys:String>
  <sys:String x:Key="Asst.Topic.races">Races &amp; genes</sys:String>
  <sys:String x:Key="Asst.Topic.mechs">Mechanoids</sys:String>
  <sys:String x:Key="Asst.Topic.building">Building &amp; furniture</sys:String>
  <sys:String x:Key="Asst.Topic.food">Food &amp; farming</sys:String>
  <sys:String x:Key="Asst.Topic.medical">Medicine &amp; implants</sys:String>
  <sys:String x:Key="Asst.Topic.factions">Factions</sys:String>
  <sys:String x:Key="Asst.Topic.vehicles">Vehicles</sys:String>
  <sys:String x:Key="Asst.Topic.events">Events &amp; quests</sys:String>
  <sys:String x:Key="Asst.Topic.horror">Horror &amp; zombies</sys:String>
  <sys:String x:Key="Asst.Topic.hardcore">Hardcore</sys:String>
  <sys:String x:Key="Asst.Topic.ce">Combat Extended</sys:String>
  <sys:String x:Key="Asst.Topic.qol">Quality of life</sys:String>
  <sys:String x:Key="Asst.Topic.performance">Performance</sys:String>
  <sys:String x:Key="Asst.Topic.vanilla">Vanilla+</sys:String>
  <sys:String x:Key="Asst.Topic.tribal">Tribal</sys:String>
  <sys:String x:Key="Asst.Topic.social">Traits &amp; relations</sys:String>
