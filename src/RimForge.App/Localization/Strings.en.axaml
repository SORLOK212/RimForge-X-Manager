<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- English. Keys must match Strings.ru.axaml. -->
  <sys:String x:Key="Lang.Code">en</sys:String>
  <sys:String x:Key="Lang.Switch">RU</sys:String>
  <sys:String x:Key="Tip.Lang">Interface language. Current: English. Click to switch to Russian.</sys:String>

  <!-- Top bar -->
  <sys:String x:Key="Top.Profile">Modpack</sys:String>
  <sys:String x:Key="Top.ProfileCurrent">Current (from game)</sys:String>
  <sys:String x:Key="Tip.Profile">Current modpack — the set of mods that is active in the game now. Click to quickly switch to another modpack.</sys:String>
  <sys:String x:Key="Top.Play">PLAY</sys:String>
  <sys:String x:Key="Tip.Play">Saves the mod list and starts RimWorld.&#x0a;Example: turn on a couple of mods → press Play → the game starts with them.</sys:String>
  <sys:String x:Key="Top.Save">Save</sys:String>
  <sys:String x:Key="Tip.Save">Writes the current mod list and order to the game without starting it. The previous version is backed up, so you can always go back.</sys:String>
  <sys:String x:Key="Top.Revert">Revert</sys:String>
  <sys:String x:Key="Tip.Revert">Brings the list back to what is currently saved in the game.&#x0a;Example: shuffled the order by accident — press this and everything is back.</sys:String>
  <sys:String x:Key="Tip.Reload">Scans the mod folders again. Use it after subscribing to a mod on Steam or copying a mod by hand.</sys:String>

  <sys:String x:Key="Status.Ok">All good</sys:String>
  <sys:String x:Key="Status.Warnings">Warnings: {0}</sys:String>
  <sys:String x:Key="Status.Errors">Problems: {0}</sys:String>
  <sys:String x:Key="Tip.Status">The traffic light checks your modpack before launch:&#x0a;● green — ready to play;&#x0a;● yellow — minor things, the game will most likely start;&#x0a;● red — real problems, e.g. a required mod is missing.&#x0a;Click to see the list and fix it.</sys:String>

  <!-- Navigation -->
  <sys:String x:Key="Tip.Nav.Mods">Mods — turn mods on and off and set the load order of the current modpack.</sys:String>
  <sys:String x:Key="Tip.Nav.Profiles">Modpacks — several mod sets and one-click switching between them.</sys:String>
  <sys:String x:Key="Tip.Nav.Workshop">Steam Workshop: find and install mods right here, ready-made selections (fantasy, space…), updates of your mods and the download queue.</sys:String>
  <sys:String x:Key="Tip.Nav.Diagnostics">Diagnostics — finds real conflicts between mods and reads the game's errors to find the culprit mod.</sys:String>
  <sys:String x:Key="Tip.Nav.Settings">Settings — AI assistant and more.</sys:String>

  <!-- Lists -->
  <sys:String x:Key="List.Available">Available</sys:String>
  <sys:String x:Key="Tip.List.Available">Mods that are installed but turned off.&#x0a;To turn one on: drag it to the right or double-click it.</sys:String>
  <sys:String x:Key="List.Active">Active — load order</sys:String>
  <sys:String x:Key="Tip.List.Active">Mods that are turned on. The game loads them top to bottom: mods lower in the list can change what mods above them added.&#x0a;Drag mods to reorder. Double-click to turn off.</sys:String>
  <sys:String x:Key="Search.Placeholder">Search: name, author or ID…</sys:String>
  <sys:String x:Key="Tip.Search">Searches names, authors and package IDs.&#x0a;Example: "vanilla" finds every Vanilla Expanded mod.</sys:String>
  <sys:String x:Key="Filter.All">All</sys:String>
  <sys:String x:Key="Filter.Workshop">Steam</sys:String>
  <sys:String x:Key="Filter.Local">Local</sys:String>
  <sys:String x:Key="Filter.Official">Game &amp; DLC</sys:String>
  <sys:String x:Key="Tip.Filter">Show mods from one source only:&#x0a;Steam — Workshop subscriptions;&#x0a;Local — copied into the Mods folder by hand;&#x0a;Game &amp; DLC — the game itself and official expansions.</sys:String>

  <sys:String x:Key="Badge.Workshop">STEAM</sys:String>
  <sys:String x:Key="Badge.Local">LOCAL</sys:String>
  <sys:String x:Key="Badge.Official">OFFICIAL</sys:String>

  <sys:String x:Key="Tip.MoveTop">To the very top — the mod loads first.</sys:String>
  <sys:String x:Key="Tip.MoveUp">One row up — the mod loads a bit earlier.</sys:String>
  <sys:String x:Key="Tip.MoveDown">One row down — the mod loads a bit later.</sys:String>
  <sys:String x:Key="Tip.MoveBottom">To the very bottom — the mod loads last. Patches and translations usually go here.</sys:String>
  <sys:String x:Key="Tip.EnableAll">Turn on every mod shown on the left (respects search and filter).</sys:String>
  <sys:String x:Key="Tip.DisableAll">Turn off every mod shown on the right except the game itself (respects search).</sys:String>

  <!-- Details -->
  <sys:String x:Key="Details.Empty">Pick a mod in a list to see its details here.</sys:String>
  <sys:String x:Key="Details.Versions">Game versions</sys:String>
  <sys:String x:Key="Details.PackageId">Package ID</sys:String>
  <sys:String x:Key="Details.Requires">Requires</sys:String>
  <sys:String x:Key="Details.Issues">What's wrong</sys:String>
  <sys:String x:Key="Details.Description">Description</sys:String>
  <sys:String x:Key="Details.AnyVersion">any</sys:String>
  <sys:String x:Key="Dep.Ok">on</sys:String>
  <sys:String x:Key="Dep.Inactive">off</sys:String>
  <sys:String x:Key="Dep.Missing">not installed</sys:String>
  <sys:String x:Key="Btn.Enable">Turn on</sys:String>
  <sys:String x:Key="Btn.Disable">Turn off</sys:String>
  <sys:String x:Key="Tip.Toggle">Turns the mod on or off. Double-clicking the mod in a list does the same.</sys:String>
  <sys:String x:Key="Btn.OpenFolder">Folder</sys:String>
  <sys:String x:Key="Tip.OpenFolder">Opens the mod's folder in Explorer.</sys:String>
  <sys:String x:Key="Btn.OpenWorkshop">Workshop</sys:String>
  <sys:String x:Key="Tip.OpenWorkshop">Opens the mod's Steam Workshop page: description, comments, change notes.</sys:String>

  <!-- Issues -->
  <sys:String x:Key="Issues.Title">Modpack check</sys:String>
  <sys:String x:Key="Issues.None">No problems found — ready to play!</sys:String>
  <sys:String x:Key="Issue.DependencyInactive">"{0}" requires "{1}", but it is turned off.</sys:String>
  <sys:String x:Key="Issue.DependencyMissing">"{0}" requires "{1}", but it is not installed.</sys:String>
  <sys:String x:Key="Issue.Incompatible">"{0}" is incompatible with "{1}". Keep only one of them.</sys:String>
  <sys:String x:Key="Issue.UnsupportedVersion">"{0}" does not list game version {2} as supported (supports: {1}). It may or may not work.</sys:String>
  <sys:String x:Key="Issue.ShouldLoadAfter">"{0}" should load after "{1}", but it is above it.</sys:String>
  <sys:String x:Key="Issue.ShouldLoadBefore">"{0}" should load before "{1}", but it is below it.</sys:String>
  <sys:String x:Key="Issue.NotInstalled">Mod "{0}" is in the game's list but was not found on disk.</sys:String>
  <sys:String x:Key="Issue.BrokenAbout">The About.xml file of "{0}" is broken: {1}</sys:String>
  <sys:String x:Key="Fix.Enable">Turn on</sys:String>
  <sys:String x:Key="Fix.Remove">Remove</sys:String>
  <sys:String x:Key="Fix.Move">Move</sys:String>
  <sys:String x:Key="Fix.Find">Find</sys:String>
  <sys:String x:Key="Tip.Fix">Fix this problem with one click.</sys:String>

  <!-- Footer / messages -->
  <sys:String x:Key="Footer.Counts">Mods installed: {0} · active: {1}</sys:String>
  <sys:String x:Key="Footer.Game">RimWorld {0} · {1}</sys:String>
  <sys:String x:Key="Footer.Unsaved">● Unsaved changes</sys:String>
  <sys:String x:Key="Footer.Saved">All changes saved</sys:String>
  <sys:String x:Key="Loading">Looking for mods…</sys:String>
  <sys:String x:Key="Msg.GameNotFound">Could not find RimWorld automatically. Please choose the folder where the game is installed.</sys:String>
  <sys:String x:Key="Btn.PickGameDir">Choose game folder</sys:String>
  <sys:String x:Key="Msg.NotAGameDir">RimWorld is not in this folder. Pick the folder that contains RimWorldWin64.exe.</sys:String>
  <sys:String x:Key="Msg.ConfigNotFound">The game's settings folder was not found. Start RimWorld at least once, then press Refresh.</sys:String>
  <sys:String x:Key="Msg.Saved">Saved. The previous list is in a backup.</sys:String>
  <sys:String x:Key="Msg.GameRunning">RimWorld is already running. Changes apply after the game restarts.</sys:String>
  <sys:String x:Key="Msg.Launching">Starting the game…</sys:String>
  <sys:String x:Key="Msg.Error">Error: {0}</sys:String>
  <sys:String x:Key="Source.Steam">Steam</sys:String>
  <sys:String x:Key="Source.Gog">GOG</sys:String>
  <sys:String x:Key="Source.Unknown">custom folder</sys:String>

  <!-- Modpacks -->
  <sys:String x:Key="Profiles.Title">Modpacks</sys:String>
  <sys:String x:Key="Profiles.Hint">A modpack is a set of mods together with their load order. Switch between modpacks with one click: RimForge writes the right list to the game for you. For example, keep "Fantasy" and "Space" and pick by mood.</sys:String>
  <sys:String x:Key="Profiles.New">New modpack</sys:String>
  <sys:String x:Key="Tip.Profiles.New">Creates a new modpack with just the game and DLC. Then add mods on the Mods screen.</sys:String>
  <sys:String x:Key="Profiles.Import">From a save…</sys:String>
  <sys:String x:Key="Tip.Profiles.Import">Creates a modpack from the mod list of any save or a list saved in the game. Handy for going back to an old colony: RimForge shows which mods are missing and helps find them.</sys:String>
  <sys:String x:Key="Profiles.Active">ACTIVE</sys:String>
  <sys:String x:Key="Profiles.ModCount">Mods: {0}</sys:String>
  <sys:String x:Key="Profiles.Missing">not installed: {0}</sys:String>
  <sys:String x:Key="Profiles.Modified">Changed {0}</sys:String>
  <sys:String x:Key="Profiles.Apply">Activate</sys:String>
  <sys:String x:Key="Tip.Profiles.Apply">Activates this modpack in the game: its mods and its order. The current modpack stays — you can switch back any time.</sys:String>
  <sys:String x:Key="Profiles.Open">To mods</sys:String>
  <sys:String x:Key="Tip.Profiles.Open">Open the mod list of this modpack.</sys:String>
  <sys:String x:Key="Tip.Profiles.Rename">Rename the modpack.</sys:String>
  <sys:String x:Key="Tip.Profiles.Copy">Make a copy of the modpack. Handy for experimenting without breaking the main one.</sys:String>
  <sys:String x:Key="Tip.Profiles.Delete">Delete the modpack. The mods themselves stay on disk.</sys:String>
  <sys:String x:Key="Profiles.Manage">All modpacks…</sys:String>
  <sys:String x:Key="Profile.DefaultName">Main</sys:String>
  <sys:String x:Key="Profile.NewDefaultName">New modpack</sys:String>
  <sys:String x:Key="Profile.CopySuffix">{0} (copy)</sys:String>
  <sys:String x:Key="Dialog.Cancel">Cancel</sys:String>
  <sys:String x:Key="Dialog.Save">Save</sys:String>
  <sys:String x:Key="Dialog.DontSave">Don't save</sys:String>
  <sys:String x:Key="Dialog.Create">Create</sys:String>
  <sys:String x:Key="Dialog.Rename">Rename</sys:String>
  <sys:String x:Key="Dialog.Delete">Delete</sys:String>
  <sys:String x:Key="Dialog.NameHint">Modpack name</sys:String>
  <sys:String x:Key="Dialog.NewTitle">New modpack</sys:String>
  <sys:String x:Key="Dialog.NewMessage">What should we call it? For example: "Fantasy", "Hardcore", "For stream". The new modpack is activated in the game right away with just the game and DLC. Your current modpack is kept — switch back any time.</sys:String>
  <sys:String x:Key="Dialog.RenameTitle">Rename modpack</sys:String>
  <sys:String x:Key="Dialog.DeleteTitle">Delete modpack?</sys:String>
  <sys:String x:Key="Dialog.DeleteMessage">Modpack "{0}" will be deleted. The mods stay on disk.</sys:String>
  <sys:String x:Key="Dialog.UnsavedTitle">Unsaved changes</sys:String>
  <sys:String x:Key="Dialog.UnsavedMessage">Modpack "{0}" has unsaved changes. Save them before switching?</sys:String>
  <sys:String x:Key="Msg.ProfileApplied">Modpack "{0}" is now active in the game. Ready to play!</sys:String>
  <sys:String x:Key="Msg.ProfileCreated">Created modpack "{0}".</sys:String>
  <sys:String x:Key="Msg.ProfileImported">Created modpack "{0}": {1} mods, {2} not installed. Missing mods are marked red — "Find" opens them in the Workshop.</sys:String>
  <sys:String x:Key="Msg.CantDeleteLast">You can't delete the only modpack.</sys:String>
  <sys:String x:Key="Msg.GameListDiffers">The game's mod list differs from modpack "{0}" — it was changed in the game or another tool. "Save" stores it in the modpack, "Revert" brings the modpack back.</sys:String>
  <sys:String x:Key="Import.Title">Modpack from a save</sys:String>
  <sys:String x:Key="Import.Hint">Pick a save or a mod list saved in the game. RimForge creates a modpack with the same order and shows which mods are missing.</sys:String>
  <sys:String x:Key="Import.Save">Save</sys:String>
  <sys:String x:Key="Import.List">Game list</sys:String>
  <sys:String x:Key="Import.Info">{0} · {1} · mods: {2}</sys:String>
  <sys:String x:Key="Import.Missing">not installed: {0}</sys:String>
  <sys:String x:Key="Import.AllPresent">all mods installed</sys:String>
  <sys:String x:Key="Import.Create">Create modpack</sys:String>
  <sys:String x:Key="Tip.Import.Create">Creates a new modpack from this list and activates it in the game right away.</sys:String>
  <sys:String x:Key="Import.Empty">No saves found.</sys:String>
  <sys:String x:Key="Import.Loading">reading…</sys:String>
  <sys:String x:Key="Btn.Close">Close</sys:String>

  <!-- Sorting -->
  <sys:String x:Key="Sort.Button">Sort</sys:String>
  <sys:String x:Key="Tip.Sort">Pick a sort: the careful one moves as few mods as possible, the full one builds an ideal order by groups. RimForge shows what will change before applying.</sys:String>
  <sys:String x:Key="Sort.Title">Sorting</sys:String>
  <sys:String x:Key="Sort.Summary">Mods to move: {0}. Everything else stays where it is.</sys:String>
  <sys:String x:Key="Sort.OnlyConflicts">Nothing needs to move, but some rules contradict each other.</sys:String>
  <sys:String x:Key="Sort.Positions">{0} → {1}</sys:String>
  <sys:String x:Key="Sort.Reason.Chain">moved together with mods it is tied to</sys:String>
  <sys:String x:Key="Sort.Apply">Apply</sys:String>
  <sys:String x:Key="Tip.Sort.Apply">Applies the new order. Ctrl+Z undoes it; the game gets it after Save or Play.</sys:String>
  <sys:String x:Key="Sort.ConflictsTitle">Contradicting rules</sys:String>
  <sys:String x:Key="Sort.ConflictLine">{0}: the rules demand opposite orders, so RimForge left these mods as they are. Looks like a mistake in a mod's description ({1}).</sys:String>
  <sys:String x:Key="Sort.Nothing">The order is already correct — nothing to move.</sys:String>
  <sys:String x:Key="Msg.Sorted">Done: {0} mods moved. Changed your mind? Ctrl+Z puts them back.</sys:String>
  <sys:String x:Key="Issue.Reason">Reason: {0}.</sys:String>
  <sys:String x:Key="Reason.Dependency">"{0}" requires "{1}"</sys:String>
  <sys:String x:Key="Reason.Author">the author of "{0}" says so</sys:String>
  <sys:String x:Key="Reason.Community">community rule</sys:String>
  <sys:String x:Key="Reason.CommunityComment">community rule — {0}</sys:String>
  <sys:String x:Key="Reason.Official">regular mods load after the game itself and its DLC</sys:String>
  <sys:String x:Key="Why.Title">Why is it here?</sys:String>
  <sys:String x:Key="Tip.Why">Which mods must be above and below this one, and why. All other mods may sit anywhere relative to it.</sys:String>
  <sys:String x:Key="Why.Above">Must be above:</sys:String>
  <sys:String x:Key="Why.Below">Must be below:</sys:String>
  <sys:String x:Key="Why.NeededByThis">this mod needs it</sys:String>
  <sys:String x:Key="Why.NeedsThis">it needs this mod</sys:String>
  <sys:String x:Key="Why.AuthorThis">this mod's author says so</sys:String>
  <sys:String x:Key="Why.AuthorOther">the author of "{0}" says so</sys:String>
  <sys:String x:Key="Why.AfterOfficial">Sits below the game and its DLC — regular mods always load after them.</sys:String>
  <sys:String x:Key="Why.OfficialTop">Part of the game itself — loads before regular mods.</sys:String>
  <sys:String x:Key="Why.Free">No special rules for this mod — it can go anywhere.</sys:String>
  <sys:String x:Key="Why.More">…and {0} more</sys:String>
  <sys:String x:Key="Community.Status">Community rules: {0} mods · from {1}</sys:String>
  <sys:String x:Key="Community.Loading">Loading community rules…</sys:String>
  <sys:String x:Key="Community.Failed">Community rules unavailable — no internet?</sys:String>
  <sys:String x:Key="Tip.Community">The RimSort community rules database (github.com/RimSort/Community-Rules-Database): players collect which mods to load in which order. RimForge downloads it every 3 days. Click to update now.</sys:String>
  <sys:String x:Key="Sort.ReasonLine">{0} — {1}</sys:String>
  <sys:String x:Key="Sort.MustBeAfter">must be after "{0}"</sys:String>
  <sys:String x:Key="Sort.MustBeBefore">must be before "{0}"</sys:String>
  <sys:String x:Key="Sort.Quick">Careful sort</sys:String>
  <sys:String x:Key="Sort.QuickHint">Moves only the mods that are misplaced; everything else stays put. Best if your modpack already works.</sys:String>
  <sys:String x:Key="Sort.Full">Full sort</sys:String>
  <sys:String x:Key="Sort.FullHint">Rebuilds the whole list by phases — by what is inside the mods: Harmony etc. → game and DLC → libraries → content → retextures → patches → code tweaks → translations, alphabetical inside each phase. Keeps every rule. Moves many mods — good for a new or tangled modpack.</sys:String>
  <sys:String x:Key="Sort.FullSummary">The whole list will be rebuilt by phases — by what is inside the mods (libraries → content → retextures → patches → code tweaks → translations). Every order rule still holds. Mods that move: {0}.</sys:String>
  <sys:String x:Key="Sort.GroupCount">{0}: {1}</sys:String>
  <sys:String x:Key="Sort.Reason.Group">group "{0}", alphabetical</sys:String>
  <sys:String x:Key="Group.BeforeGame">Before the game</sys:String>
  <sys:String x:Key="Group.Game">Game &amp; DLC</sys:String>
  <sys:String x:Key="Group.Library">Libraries</sys:String>
  <sys:String x:Key="Group.Content">Content</sys:String>
  <sys:String x:Key="Group.Patch">Patches</sys:String>
  <sys:String x:Key="Group.Translation">Translations</sys:String>
  <sys:String x:Key="Issue.Contradiction">"{0}" and "{1}": their order rules contradict each other — a mistake in a mod's description that moving mods can't fix. The game usually works anyway; RimForge leaves them as they are.</sys:String>
  <sys:String x:Key="Diag.Title">Diagnostics</sys:String>
  <sys:String x:Key="Diag.Hint">RimForge reads the code and data of your active mods (without running them) and the game log. It looks for mods that get in each other's way and for errors they cause. These are possible problems, not verdicts: many overlaps are intended and work fine.</sys:String>
  <sys:String x:Key="Diag.Run">Check modpack</sys:String>
  <sys:String x:Key="Tip.Diag.Run">Checks the current list of active mods and the chosen game log. Changes nothing. Takes a few seconds.</sys:String>
  <sys:String x:Key="Diag.LogLabel">Game log:</sys:String>
  <sys:String x:Key="Tip.Diag.Log">The log is the file where the game writes errors on every start. It belongs to the set of mods the game ran with. If you changed mods since then — start the game again and check again.</sys:String>
  <sys:String x:Key="Diag.LogLast">last run ({0})</sys:String>
  <sys:String x:Key="Diag.LogPrevious">previous run ({0})</sys:String>
  <sys:String x:Key="Diag.Scanning">Checking mods…</sys:String>
  <sys:String x:Key="Diag.Empty">Press "Check modpack" — RimForge will find conflicts between mods and explain the errors from the game log.</sys:String>
  <sys:String x:Key="Diag.SectionEmpty">Nothing found here. Great!</sys:String>
  <sys:String x:Key="Diag.High">Serious: {0}</sys:String>
  <sys:String x:Key="Diag.Medium">Possible: {0}</sys:String>
  <sys:String x:Key="Diag.Minor">Minor: {0}</sys:String>
  <sys:String x:Key="Diag.ShowMinor">Show minor</sys:String>
  <sys:String x:Key="Tip.Diag.ShowMinor">Minor items are overlaps and errors that usually affect nothing. Hidden by default to keep things clear.</sys:String>
  <sys:String x:Key="Diag.Info">Mods checked: {0}, code libraries: {1}, data files: {2} · log from {3}</sys:String>
  <sys:String x:Key="Diag.TabLog">Game errors ({0})</sys:String>
  <sys:String x:Key="Diag.TabCode">Mod code ({0})</sys:String>
  <sys:String x:Key="Diag.TabData">Mod data ({0})</sys:String>
  <sys:String x:Key="Tip.Diag.TabLog">Errors from the game log and the mods that caused them.</sys:String>
  <sys:String x:Key="Tip.Diag.TabCode">Places in the game's code that several mods change at once (through Harmony).</sys:String>
  <sys:String x:Key="Tip.Diag.TabData">Game objects (items, creatures, genes…) that several mods declare or rewrite differently.</sys:String>
  <sys:String x:Key="Diag.Details">Details</sys:String>
  <sys:String x:Key="Tip.Diag.Details">Show technical information: error text, methods, files. Useful when writing to a mod author.</sys:String>
  <sys:String x:Key="Diag.Suspects">Likely culprits:</sys:String>
  <sys:String x:Key="Diag.Mods">Mods:</sys:String>
  <sys:String x:Key="Diag.CanSkipMark">can cancel the method</sys:String>
  <sys:String x:Key="Diag.Log.Exception">Code crash during the game</sys:String>
  <sys:String x:Key="Diag.Log.Exception.Hint">A mod caused an error in code. If it repeats, the game may misbehave or lag. Try updating the suspect mod, or turn it off for a while and see if the error goes away.</sys:String>
  <sys:String x:Key="Diag.Log.MissingParent">Template "{0}" not found</sys:String>
  <sys:String x:Key="Diag.Log.MissingParent.Hint">A mod refers to a template from another mod that is not installed or is turned off. Usually an optional compatibility: some content simply won't load. If you want it — turn on the mod that has this template.</sys:String>
  <sys:String x:Key="Diag.Log.MissingType">Type "{0}" not found</sys:String>
  <sys:String x:Key="Diag.Log.MissingType.Hint">A mod uses code from another mod that is missing, or the mod is not updated for this game version. Check its dependencies and updates.</sys:String>
  <sys:String x:Key="Diag.Log.MissingReference">Object "{0}" not found</sys:String>
  <sys:String x:Key="Diag.Log.MissingReference.Hint">A mod refers to an object that does not exist — usually added by a mod you don't have. Mostly harmless: that part just won't work.</sys:String>
  <sys:String x:Key="Diag.Log.XmlError">Error in data</sys:String>
  <sys:String x:Key="Diag.Log.XmlError.Hint">An object is described with an error. If it belongs to the game itself, a patch from one of the suspect mods most likely broke it.</sys:String>
  <sys:String x:Key="Diag.Log.Asset">A graphics or sound file failed to load</sys:String>
  <sys:String x:Key="Diag.Log.Asset.Hint">A file in the mod is damaged or in the wrong format. Usually only affects looks.</sys:String>
  <sys:String x:Key="Diag.Log.Translation">Translation errors</sys:String>
  <sys:String x:Key="Diag.Log.Translation.Hint">The translation has outdated or wrong lines. Doesn't affect the game.</sys:String>
  <sys:String x:Key="Diag.Log.KeyBinding">Key binding conflict</sys:String>
  <sys:String x:Key="Diag.Log.KeyBinding.Hint">Two functions share one key. Change it in the game: Options → Controls.</sys:String>
  <sys:String x:Key="Diag.Log.Other">Error</sys:String>
  <sys:String x:Key="Diag.Log.Other.Hint">The game logged an error. See the details.</sys:String>
  <sys:String x:Key="Diag.Code.CanSkip">{0}: a mod can cancel this method</sys:String>
  <sys:String x:Key="Diag.Code.CanSkip.Hint">"{0}" can fully cancel this game method, and other mods change it too ({1}). When it cancels, their changes don't run either. Usually intended, but if some mod feature "doesn't work" — this may be why.</sys:String>
  <sys:String x:Key="Diag.Code.Transpilers">{0}: several mods rewrite the same code</sys:String>
  <sys:String x:Key="Diag.Code.Transpilers.Hint">Mods {0} change the code of this method itself. If they touch the same spot, one of them may break. If you see errors around this feature, start with these mods.</sys:String>
  <sys:String x:Key="Diag.Code.Shared">{0}: shared by several mods</sys:String>
  <sys:String x:Key="Diag.Code.Shared.Hint">Mods {0} add their behaviour to the same game method. They usually get along fine.</sys:String>
  <sys:String x:Key="Diag.Data.Override">"{0}" ({1}) is declared in several mods</sys:String>
  <sys:String x:Key="Diag.Data.OverrideGame">A mod replaces game object "{0}" ({1})</sys:String>
  <sys:String x:Key="Diag.Data.Override.Hint">Mods {0} describe the same object in full. The game takes the version from "{1}" (lower in the list); the others' changes are lost. If that's not on purpose — change the order or keep one mod.</sys:String>
  <sys:String x:Key="Diag.Data.Clash">"{0}": several mods replace the same thing ({1})</sys:String>
  <sys:String x:Key="Diag.Data.Clash.Hint">Mods {0} replace or remove the same field of one object. Only the change from "{1}" (lower in the list) survives; the others are lost.</sys:String>
  <sys:String x:Key="Diag.Why.Code">this mod's code is in the error text</sys:String>
  <sys:String x:Key="Diag.Why.HarmonyPatch">this mod hooks into the method where the error happened</sys:String>
  <sys:String x:Key="Diag.Why.Path">the error is in this mod's file</sys:String>
  <sys:String x:Key="Diag.Why.File">the error is in this mod's file</sys:String>
  <sys:String x:Key="Diag.Why.Def">the broken object is declared by this mod</sys:String>
  <sys:String x:Key="Diag.Why.PatchesDef">this mod changes the broken object</sys:String>
  <sys:String x:Key="Diag.Why.Mentions">this mod refers to the missing object</sys:String>
  <sys:String x:Key="Diag.Why.Patches">this mod changes this place</sys:String>
  <sys:String x:Key="Diag.Why.Winner">its version wins (lower in the list)</sys:String>
  <sys:String x:Key="Diag.Why.Declares">also declares this object</sys:String>
  <sys:String x:Key="Tip.Diag.Chip">Click to open the mod in the list.</sys:String>
  <sys:String x:Key="Diag.Log.XmlErrorNamed">Error in object "{0}"</sys:String>
  <sys:String x:Key="Bisect.Button">Find the culprit mod</sys:String>
  <sys:String x:Key="Tip.Bisect.Button">Step-by-step search for the mod that causes a problem. RimForge turns on half of the mods, you start the game and say whether the problem is there. Usually 8–9 starts are enough even for hundreds of mods.</sys:String>
  <sys:String x:Key="Bisect.Title">Find the culprit mod</sys:String>
  <sys:String x:Key="Bisect.Intro">How it works: RimForge turns on only half of the mods (plus what they need to work). You start the game and say whether the problem is still there. Halving like this finds the culprit in a few starts. Your modpack is remembered and comes back at the end — or any time with "Stop".</sys:String>
  <sys:String x:Key="Bisect.Caution">Important: don't load or save your colony during test starts — not all mods are on. Check the problem in the main menu or a new test game.</sys:String>
  <sys:String x:Key="Bisect.TargetLabel">What are we looking for?</sys:String>
  <sys:String x:Key="Bisect.Manual">A problem I can see in the game — I'll check myself</sys:String>
  <sys:String x:Key="Bisect.LogTarget">An error from the log: {0}</sys:String>
  <sys:String x:Key="Bisect.TargetHint">Log errors appear in this list after "Check modpack". Then RimForge checks the log after each start for you.</sys:String>
  <sys:String x:Key="Bisect.Start">Start search</sys:String>
  <sys:String x:Key="Bisect.Round">Step {0} · about {1} starts left · suspects: {2}</sys:String>
  <sys:String x:Key="Bisect.Status">Mods now on in the game: {0} (suspects among them: {1}). Start the game and check whether the problem is there.</sys:String>
  <sys:String x:Key="Bisect.Launch">Start the game</sys:String>
  <sys:String x:Key="Bisect.CheckLog">Check the log</sys:String>
  <sys:String x:Key="Tip.Bisect.CheckLog">Wait for the main menu (or close the game) and press this — RimForge looks for the error itself.</sys:String>
  <sys:String x:Key="Bisect.LogHas">The error is in the log → answer "Problem is there".</sys:String>
  <sys:String x:Key="Bisect.LogHasNot">The error is not in the log → answer "No problem".</sys:String>
  <sys:String x:Key="Bisect.LogOld">The log hasn't updated yet. Start the game and wait for the main menu.</sys:String>
  <sys:String x:Key="Bisect.Yes">Problem is there</sys:String>
  <sys:String x:Key="Bisect.No">No problem</sys:String>
  <sys:String x:Key="Bisect.Back">Back</sys:String>
  <sys:String x:Key="Tip.Bisect.Back">Go one step back if you answered wrong.</sys:String>
  <sys:String x:Key="Bisect.Cancel">Stop and restore my modpack</sys:String>
  <sys:String x:Key="Bisect.Hide">Hide</sys:String>
  <sys:String x:Key="Tip.Bisect.Hide">Hide this window; the search continues. Bring it back with "Find the culprit mod".</sys:String>
  <sys:String x:Key="Bisect.Found">Found it! Most likely the problem is caused by "{0}".</sys:String>
  <sys:String x:Key="Bisect.FoundHint">If the problem only appears when two mods are combined, this is one of them. You can turn it off, update it or write to its author — Diagnostics has the details.</sys:String>
  <sys:String x:Key="Bisect.NotFound">Couldn't narrow it down to one mod. The answers may have contradicted each other, or a combination of mods causes it. Suspects: {0}.</sys:String>
  <sys:String x:Key="Bisect.Restore">Restore my modpack</sys:String>
  <sys:String x:Key="Bisect.Disable">Restore without this mod</sys:String>
  <sys:String x:Key="Tip.Bisect.Disable">Puts your modpack back, but without the mod that was found. Save the change afterwards.</sys:String>
  <sys:String x:Key="Bisect.Open">Open the mod</sys:String>
  <sys:String x:Key="Msg.BisectDisabled">"{0}" is turned off. Press Save to keep it, or Ctrl+Z to undo.</sys:String>
  <sys:String x:Key="Msg.BisectRestored">Your modpack is back in the game.</sys:String>
  <sys:String x:Key="Fix.EnableWithDeps">Turn on "{0}" (+{1} it needs)</sys:String>
  <sys:String x:Key="Fix.EnableOne">Turn on "{0}"</sys:String>
  <sys:String x:Key="Fix.LoadAfter">Put "{0}" after "{1}"</sys:String>
  <sys:String x:Key="Fix.Disable">Turn off "{0}"</sys:String>
  <sys:String x:Key="Fix.CheckSuspects">Check the suspects ({0})</sys:String>
  <sys:String x:Key="Fix.ChooseWinner">Choose whose version wins</sys:String>
  <sys:String x:Key="Fix.Ignore">This is fine — hide</sys:String>
  <sys:String x:Key="Fix.Unignore">Show again</sys:String>
  <sys:String x:Key="Fix.Tip.EnableMods">Turns on the installed mod that has what is missing, together with its dependencies.</sys:String>
  <sys:String x:Key="Fix.Tip.LoadAfter">The game only looks for templates in mods loaded earlier. Moves the mod below the one whose template it needs and remembers the rule.</sys:String>
  <sys:String x:Key="Fix.Tip.DisableMods">Turns the mod off. Warns first if your saves use it.</sys:String>
  <sys:String x:Key="Fix.Tip.CheckSuspects">Quick culprit search among the suspects only: a few game starts instead of a dozen.</sys:String>
  <sys:String x:Key="Fix.Tip.ChooseWinner">Pick whose version should work. RimForge puts that mod below the others and remembers the rule.</sys:String>
  <sys:String x:Key="Fix.Tip.Ignore">Mark as fine — don't show again for this modpack.</sys:String>
  <sys:String x:Key="Fix.Tip.Unignore">Show this finding again.</sys:String>
  <sys:String x:Key="Fix.NothingSafe">No safe fixes found — the rest needs your decision.</sys:String>
  <sys:String x:Key="Fix.Preview.Title">What will be done</sys:String>
  <sys:String x:Key="Fix.Preview.Enable">• Turn on "{0}" — it has what is missing.</sys:String>
  <sys:String x:Key="Fix.Preview.EnableDep">• Turn on "{0}" — it is needed to work.</sys:String>
  <sys:String x:Key="Fix.Preview.LoadAfter">• Put "{0}" after "{1}" and remember the rule so sorting doesn't move it back.</sys:String>
  <sys:String x:Key="Fix.Preview.Disable">• Turn off "{0}".</sys:String>
  <sys:String x:Key="Fix.Preview.UsedInSaves">   ⚠ This mod is in saves ({0}): {1}. Turning it off may break those colonies.</sys:String>
  <sys:String x:Key="Fix.Preview.Sorted">Then the careful sort places mods by all the rules — only misplaced ones move (including mods that depend on the moved ones).</sys:String>
  <sys:String x:Key="Fix.Preview.Undo">Changes reach the game after Save or Play. Changed your mind — Ctrl+Z.</sys:String>
  <sys:String x:Key="Fix.Apply">Apply</sys:String>
  <sys:String x:Key="Fix.Done">Done! Press Save or Play to send the changes to the game.</sys:String>
  <sys:String x:Key="Fix.Ignored">Hidden. Bring it back with "Show hidden".</sys:String>
  <sys:String x:Key="Fix.Unignored">The finding is shown again.</sys:String>
  <sys:String x:Key="Fix.Winner.Title">Whose version should win?</sys:String>
  <sys:String x:Key="Fix.Winner.Text">Pick the mod whose version the game should use. RimForge puts it below the others and remembers the rule for this modpack.</sys:String>
  <sys:String x:Key="Fix.Winner.Done">Done: "{0}" wins. Don't forget to save.</sys:String>
  <sys:String x:Key="Fix.RuleRemoved">Rule removed.</sys:String>
  <sys:String x:Key="Fix.Fixed">✓ Fix applied</sys:String>
  <sys:String x:Key="Fix.AllSafe">Fix everything safe</sys:String>
  <sys:String x:Key="Tip.Fix.AllSafe">Applies every fix that breaks nothing: turns on missing mods and puts mods after those whose templates they need. Shows the list first.</sys:String>
  <sys:String x:Key="Diag.Hidden">Hidden: {0}</sys:String>
  <sys:String x:Key="Diag.ShowIgnored">Show hidden</sys:String>
  <sys:String x:Key="Tip.Diag.ShowIgnored">Findings you marked "This is fine". Kept separately for each modpack.</sys:String>
  <sys:String x:Key="Diag.Stale">The mod list changed after the check. Press Save, start the game, then "Check modpack" again to see what got fixed.</sys:String>
  <sys:String x:Key="Reason.User">you set this</sys:String>
  <sys:String x:Key="Tip.RemoveRule">Remove this rule</sys:String>
  <sys:String x:Key="Bisect.Scope">Checking only the suspects: {0}, about {1} starts. All other mods stay on. Suspects: {2}.</sys:String>
  <sys:String x:Key="Diag.Log.MissingParent.Order">The template exists in "{1}", but that mod loads below "{0}". The game only looks for templates in mods above, so part of "{0}" doesn't load. Fix: put "{0}" after "{1}".</sys:String>
  <sys:String x:Key="Dialog.Ok">OK</sys:String>
  <sys:String x:Key="Fix.Download">Download</sys:String>
