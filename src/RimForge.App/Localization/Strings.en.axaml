  <sys:String x:Key="CollSize.Medium">Medium (50–200)</sys:String>
  <sys:String x:Key="CollSize.Large">Large (200+)</sys:String>
  <sys:String x:Key="CollHdr.Week">Popular collections this week</sys:String>
  <sys:String x:Key="CollHdr.AllTime">Popular collections of all time</sys:String>
